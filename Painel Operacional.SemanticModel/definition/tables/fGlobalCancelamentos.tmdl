	partition fGlobalCancelamentos = calculated
		mode: import
		source =
				
				-- Resumo dos cancelamentos EFETIVADOS (tipo 2, sem estorno total) por dia, contagem (Fechado = status Fechado
				-- pela data de fechamento; Resolvido = status Resolvido pela data de resolução), produto, alegação, idade e
				-- setor (do treinador = último responsável pelo cliente, pelo cadastro do RH).
				-- Calculada no refresh, fora do RLS: o Global mostra o total da empresa para todos. Gerado por gerar_global.py.
				VAR base = FILTER( Helpdesk_Cancelamentos,
				    Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado" && Helpdesk_Cancelamentos[estornoTotal] <> "Sim"
				        && Helpdesk_Cancelamentos[type] = 2 )
				VAR fechado = SELECTCOLUMNS( FILTER( base, Helpdesk_Cancelamentos[status] = "Fechado" && NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) ),
				    "@data", DATE( YEAR( Helpdesk_Cancelamentos[Data de Fechamento] ), MONTH( Helpdesk_Cancelamentos[Data de Fechamento] ), DAY( Helpdesk_Cancelamentos[Data de Fechamento] ) ), "@contagem", "Fechado", "@sistema", Helpdesk_Cancelamentos[sistema],
				    "@alegacao", Helpdesk_Cancelamentos[alegacao], "@dias", Helpdesk_Cancelamentos[Dias Ativos],
				    "@setor", Helpdesk_Cancelamentos[Setor do Treinador],
				    "@rs", IF( Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", Helpdesk_Cancelamentos[mensalidade] ) )
				VAR resolvido = SELECTCOLUMNS( FILTER( base, Helpdesk_Cancelamentos[status] = "Resolvido" && NOT ISBLANK( Helpdesk_Cancelamentos[Data Resolvido] ) ),
				    "@data", DATE( YEAR( Helpdesk_Cancelamentos[Data Resolvido] ), MONTH( Helpdesk_Cancelamentos[Data Resolvido] ), DAY( Helpdesk_Cancelamentos[Data Resolvido] ) ), "@contagem", "Resolvido", "@sistema", Helpdesk_Cancelamentos[sistema],
				    "@alegacao", Helpdesk_Cancelamentos[alegacao], "@dias", Helpdesk_Cancelamentos[Dias Ativos],
				    "@setor", Helpdesk_Cancelamentos[Setor do Treinador],
				    "@rs", IF( Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", Helpdesk_Cancelamentos[mensalidade] ) )
				VAR linhas = ADDCOLUMNS( UNION( fechado, resolvido ), "@faixa", SWITCH( TRUE(), ISBLANK( [@dias] ), BLANK(), [@dias] <= 90, "Até 3 meses", [@dias] <= 180, "3 a 6 meses", [@dias] <= 365, "6 meses a 1 ano", [@dias] <= 730, "1 a 2 anos", [@dias] <= 1095, "2 a 3 anos", "Mais de 3 anos" ), "@ordem", SWITCH( TRUE(), ISBLANK( [@dias] ), BLANK(), [@dias] <= 90, 1, [@dias] <= 180, 2, [@dias] <= 365, 3, [@dias] <= 730, 4, [@dias] <= 1095, 5, 6 ) )
				VAR g = GROUPBY( linhas, [@data], [@contagem], [@sistema], [@alegacao], [@faixa], [@ordem], [@setor],
				    "@qtd", SUMX( CURRENTGROUP(), 1 ), "@valor", SUMX( CURRENTGROUP(), [@rs] ),
				    "@somadias", SUMX( CURRENTGROUP(), [@dias] ), "@comdias", COUNTX( CURRENTGROUP(), [@dias] ) )
				RETURN
				    SELECTCOLUMNS( g, "Data", [@data], "Contagem", [@contagem], "Sistema", [@sistema], "Alegação", [@alegacao],
				        "Faixa de Idade", [@faixa], "Ordem da Faixa", [@ordem], "Cancelamentos", [@qtd], "R$ Cancelado", [@valor],
				        "Soma de Dias Ativos", [@somadias], "Com Dias Ativos", [@comdias], "Setor", [@setor] )

