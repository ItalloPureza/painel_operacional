table fGlobalCancelamentos
	lineageTag: 249d5a3b-caba-54db-ab3c-02bf1271ff0e

	/// R$ cancelado (Fechado) de Alfa, AF Docs e Kappa — Perda de Receita - Cancelamento. Segue o filtro Sistema da fGlobalReceita (tela Alteração de Receita); com Área escolhida fica vazio (cancelamento não tem área).
	measure 'Perda por Cancelamento' = IF( NOT ISFILTERED( fGlobalReceita[Área Responsável] ), IF( ISFILTERED( fGlobalReceita[Sistema] ), CALCULATE( [R$ Cancelado (Fechado)], KEEPFILTERS( fGlobalCancelamentos[Sistema] IN { "Alfa", "Alfa Docs", "Kappa" } ), KEEPFILTERS( TREATAS( FILTERS( fGlobalReceita[Sistema] ), fGlobalCancelamentos[Sistema] ) ) ), CALCULATE( [R$ Cancelado (Fechado)], KEEPFILTERS( fGlobalCancelamentos[Sistema] IN { "Alfa", "Alfa Docs", "Kappa" } ) ) ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 7a3bb431-fe60-5e8d-b5e7-7a4140ff6775

	/// Meta de % de cancelamento do produto (intranet: Cancelamentos - Alfa / KP, empresa). O produto vem do filtro Sistema; sem um único produto escolhido a meta fica vazia. Vazia com Alegação ou Setor escolhidos (meta da empresa: só no mesmo recorte — metas-intranet.md).
	measure 'Meta % Cancelamento' = IF( NOT ( ISFILTERED( fGlobalCancelamentos[Alegação] ) || ISFILTERED( dSetor[Setor] ) ), VAR sis = SELECTEDVALUE( fGlobalCancelamentos[Sistema] ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta % Cancelamento" && ( Meta_Vinculo[Sistema] = sis || Meta_Vinculo[Sistema] = "" ) ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0, DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) ) )
		formatString: 0.00%
		displayFolder: Global
		lineageTag: 3f04eb6c-2aec-564b-8276-a08ffd6b0acb

	/// Meta mensal de R$ cancelado do produto = meta % de churn financeiro da intranet x mensalidade do 1º dia do mês (derivada). Só com um produto escolhido; soma os meses do período. Vazia com Alegação ou Setor escolhidos (meta da empresa: só no mesmo recorte — metas-intranet.md).
	measure 'Meta de R$ Cancelado (Global)' = IF( NOT ( ISFILTERED( fGlobalCancelamentos[Alegação] ) || ISFILTERED( dSetor[Setor] ) ), VAR sis = SELECTEDVALUE( fGlobalCancelamentos[Sistema] ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta de R$ Cancelado (Global)" && Meta_Vinculo[Sistema] = sis ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) RETURN IF( d > 0, SUMX( VALUES( Calendario[AnoMes] ), CALCULATE( DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = 0 ), 100 ) * IF( sis = "Kappa", [Mensalidade KP (início do mês)], [Mensalidade AF (início do mês)] ) ) ) ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 7a0ca378-e59d-5e8a-9862-a406741e3b2a

	/// Meta mensal de cancelamentos (quantidade) do produto = meta % de cancelamento da intranet x clientes ativos no 1º dia do mês (derivada). Só com um produto escolhido; soma os meses do período. Vazia com Alegação ou Setor escolhidos (meta da empresa: só no mesmo recorte — metas-intranet.md).
	measure 'Meta de Cancelamentos (Global)' = IF( NOT ( ISFILTERED( fGlobalCancelamentos[Alegação] ) || ISFILTERED( dSetor[Setor] ) ), VAR sis = SELECTEDVALUE( fGlobalCancelamentos[Sistema] ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta de Cancelamentos (Global)" && Meta_Vinculo[Sistema] = sis ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) RETURN IF( d > 0, SUMX( VALUES( Calendario[AnoMes] ), CALCULATE( DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = 0 ), 100 ) * IF( sis = "Kappa", [Clientes Ativos KP (início do mês)], [Clientes Ativos AF (início do mês)] ) ) ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 78aad7e2-d734-50c5-8919-5cd075d2e637

	/// Cancelamentos (Fechado) ÷ clientes KP ativos no início do mês (% Churn KP). A tela filtra Sistema = Kappa.
	measure '% Cancelamento KP' = DIVIDE( [Cancelamentos (Fechado)], [Clientes Ativos KP (início do mês)] )
		formatString: 0.00%
		displayFolder: Global
		lineageTag: 2c07d7f8-3aaa-586d-87f2-e9ee671fe43c

	/// Cancelamentos (Fechado) ÷ clientes AF ativos no início do mês (% Churn AF). A tela filtra Sistema = Alfa.
	measure '% Cancelamento AF' = DIVIDE( [Cancelamentos (Fechado)], [Clientes Ativos AF (início do mês)] )
		formatString: 0.00%
		displayFolder: Global
		lineageTag: b1c4d637-4bdb-5033-824f-65f69b271f38

	/// Cancelamentos (Fechado) com até 365 dias ativos.
	measure 'Cancelados com até 1 Ano' = CALCULATE( [Cancelamentos (Fechado)], KEEPFILTERS( fGlobalCancelamentos[Faixa de Idade] IN { "Até 3 meses", "3 a 6 meses", "6 meses a 1 ano" } ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 03e12998-8f78-53d8-bf85-09702e94a05e

	/// Média de dias ativos (data de contrato -> fechamento do ticket) dos cancelamentos (Fechado).
	measure 'Idade Média ao Cancelar (dias)' = DIVIDE( CALCULATE( SUM( fGlobalCancelamentos[Soma de Dias Ativos] ), KEEPFILTERS( fGlobalCancelamentos[Contagem] = "Fechado" ) ), CALCULATE( SUM( fGlobalCancelamentos[Com Dias Ativos] ), KEEPFILTERS( fGlobalCancelamentos[Contagem] = "Fechado" ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 9d5ee2f6-9371-5a59-8ad3-d81ce3d9823b

	/// Mensalidade dos cancelamentos (Resolvido), sem ajuste de carteira — R$ Empresas Canceladas (Resolvido).
	measure 'R$ Cancelado (Resolvido)' = CALCULATE( SUM( fGlobalCancelamentos[R$ Cancelado] ), KEEPFILTERS( fGlobalCancelamentos[Contagem] = "Resolvido" ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: cf605127-bf17-5725-a334-07191ed8a3d6

	/// Mensalidade dos cancelamentos (Fechado), sem ajuste de carteira — R$ Empresas Canceladas (Fechado).
	measure 'R$ Cancelado (Fechado)' = CALCULATE( SUM( fGlobalCancelamentos[R$ Cancelado] ), KEEPFILTERS( fGlobalCancelamentos[Contagem] = "Fechado" ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 67d9a432-7344-5158-a352-90777b91dbb0

	/// Efetivados tipo 2 sem estorno total com status Resolvido, pela data de RESOLUÇÃO (Qtd_Cancelamentos (Resolvido)).
	measure 'Cancelamentos (Resolvido)' = CALCULATE( SUM( fGlobalCancelamentos[Cancelamentos] ), KEEPFILTERS( fGlobalCancelamentos[Contagem] = "Resolvido" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: ddde43e8-eaa8-5487-b332-e72275367cb2

	/// Efetivados tipo 2 sem estorno total com status Fechado, pela data de FECHAMENTO (Qtd_Cancelamentos (Fechado)).
	measure 'Cancelamentos (Fechado)' = CALCULATE( SUM( fGlobalCancelamentos[Cancelamentos] ), KEEPFILTERS( fGlobalCancelamentos[Contagem] = "Fechado" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 4cf25e07-9b67-5464-bbe6-011092300c20

	/// Meta de % de churn financeiro do produto (intranet: Mensalidade Cancelamentos - Alfa / KP, empresa). Só aparece com UM produto escolhido no filtro Sistema (a taxa sem filtro soma todos os produtos e não é comparável com a meta de um produto). Vazia com Alegação ou Setor escolhidos (meta da empresa: só no mesmo recorte — metas-intranet.md).
	measure 'Meta % Churn Financeiro' = IF( NOT ( ISFILTERED( fGlobalCancelamentos[Alegação] ) || ISFILTERED( dSetor[Setor] ) ), VAR sis = SELECTEDVALUE( fGlobalCancelamentos[Sistema] ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta % Churn Financeiro" && ( Meta_Vinculo[Sistema] = sis || Meta_Vinculo[Sistema] = "" ) ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0, DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) ) )
		formatString: 0.00%
		displayFolder: Global
		lineageTag: dc1c8c56-c0f0-58c0-b40d-d3583e6ad466

	/// R$ cancelado (Fechado, mensalidade preenchida nos tickets) ÷ mensalidade do Kappa no 1º dia do mês.
	measure '% Churn Financeiro KP' = DIVIDE( [R$ Cancelado (Fechado)], [Mensalidade KP (início do mês)] )
		formatString: 0.00%
		displayFolder: Global
		lineageTag: dab0e922-8fdb-58d7-a708-5f1a2b9ef275

	/// R$ cancelado (Fechado, mensalidade preenchida nos tickets) ÷ mensalidade da carteira AF no 1º dia do mês.
	measure '% Churn Financeiro AF' = DIVIDE( [R$ Cancelado (Fechado)], [Mensalidade AF (início do mês)] )
		formatString: 0.00%
		displayFolder: Global
		lineageTag: 8622570f-fb1d-57b0-b5a7-0c473e5d11c7

	/// Cancelamentos KP (setor) ÷ clientes KP no início do mês (setor). Nos cartões e na tabela, o mês mais recente.
	measure '% Cancelamento KP (setor)' = DIVIDE( [Cancelamentos KP (setor)], [Clientes KP no Início do Mês (setor)] )
		formatString: 0.00%
		displayFolder: KP por Setor
		lineageTag: 414ec018-0f69-57ee-a022-a03a78a330cf

	/// Mensalidade dos cancelamentos (Fechado), pelo setor do treinador. Linhas da dSetorKC: Onboarding, Ongoing e Outros / sem setor (= empresa - os dois; a soma fecha com o total). Setor = cadastro do RH do mês (dSetor, como o filtro Setor da Global 02).
	measure 'R$ Cancelado KP (setor)' = VAR total = CALCULATE( [R$ Cancelado (Fechado)], REMOVEFILTERS( dSetor ) ) VAR onb = CALCULATE( [R$ Cancelado (Fechado)], dSetor[Setor] = "Onboarding" ) VAR ong = CALCULATE( [R$ Cancelado (Fechado)], dSetor[Setor] = "Ongoing" ) RETURN IF( NOT ISBLANK( total ), SUMX( VALUES( dSetorKC[Setor] ), SWITCH( dSetorKC[Setor], "Onboarding", onb, "Ongoing", ong, total - onb - ong ) ) )
		formatString: \R$ #,0.00
		displayFolder: KP por Setor
		lineageTag: d1b94dd6-c908-594f-b4b3-b84e3513d1dc

	/// Cancelamentos efetivados (Fechado) pela data de fechamento, pelo setor do treinador. A tela filtra Sistema = Kappa. Linhas da dSetorKC: Onboarding, Ongoing e Outros / sem setor (= empresa - os dois; a soma fecha com o total). Setor = cadastro do RH do mês (dSetor, como o filtro Setor da Global 02).
	measure 'Cancelamentos KP (setor)' = VAR total = CALCULATE( [Cancelamentos (Fechado)], REMOVEFILTERS( dSetor ) ) VAR onb = CALCULATE( [Cancelamentos (Fechado)], dSetor[Setor] = "Onboarding" ) VAR ong = CALCULATE( [Cancelamentos (Fechado)], dSetor[Setor] = "Ongoing" ) RETURN IF( NOT ISBLANK( total ), SUMX( VALUES( dSetorKC[Setor] ), SWITCH( dSetorKC[Setor], "Onboarding", onb, "Ongoing", ong, total - onb - ong ) ) )
		formatString: #,0
		displayFolder: KP por Setor
		lineageTag: 2ace5036-f47d-5867-a462-5e1d4330b369

	/// Clientes com Kappa ativo no 1º retrato do mês, pelo setor do CS. Linhas da dSetorKC: Onboarding, Ongoing e Outros / sem setor (= empresa - os dois; a soma fecha com o total). Setor = cadastro do RH do mês (dSetor, como o filtro Setor da Global 02).
	measure 'Clientes KP no Início do Mês (setor)' = VAR total = CALCULATE( [Clientes Ativos KP (início do mês)], REMOVEFILTERS( dSetor ) ) VAR onb = CALCULATE( [Clientes Ativos KP (início do mês)], dSetor[Setor] = "Onboarding" ) VAR ong = CALCULATE( [Clientes Ativos KP (início do mês)], dSetor[Setor] = "Ongoing" ) RETURN IF( NOT ISBLANK( total ), SUMX( VALUES( dSetorKC[Setor] ), SWITCH( dSetorKC[Setor], "Onboarding", onb, "Ongoing", ong, total - onb - ong ) ) )
		formatString: #,0
		displayFolder: KP por Setor
		lineageTag: 0c35c041-e3c3-517c-be77-66d04acd6710

