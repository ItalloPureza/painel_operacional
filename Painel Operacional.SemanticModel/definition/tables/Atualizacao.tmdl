	measure 'Nav Gerencia' =
			
			VAR u = LOWER( USERPRINCIPALNAME() )
			VAR meus = UNION( CALCULATETABLE( VALUES( dAcessoSetor[Setor] ), dAcessoSetor[email] = u ), FILTER( { "*" }, CONTAINSSTRING( u, "\" ) ) )
			RETURN IF( "*" IN meus || "Gerência" IN meus, "Gerência - Cohort AF", "HomePage" )
		lineageTag: fb9c15a4-0386-4063-a971-d5ea5e52f8c7

	/// Texto do botão da busca de painéis da HomePage.
	measure 'Texto Busca' = VAR u = LOWER( USERPRINCIPALNAME() ) VAR meus = UNION( CALCULATETABLE( VALUES( dAcessoSetor[Setor] ), dAcessoSetor[email] = u ), FILTER( { "*" }, CONTAINSSTRING( u, "\" ) ) ) VAR p = SELECTEDVALUE( dPaineis[Página] ) VAR s = SELECTEDVALUE( dPaineis[Setor] ) VAR ok = s IN { "Global", "Saúde dos dados" } || "*" IN meus || s IN meus RETURN IF( ISBLANK( p ), "Escolha um painel", IF( ok, "Abrir painel ›", "Sem acesso a este setor" ) )
		displayFolder: Navegação
		lineageTag: 583da092-718d-5242-9659-b409464f1d28

	/// Destino do botão da busca de painéis da HomePage (displayName); vazio = botão desligado; sem acesso = fica.
	measure 'Nav Busca' = VAR u = LOWER( USERPRINCIPALNAME() ) VAR meus = UNION( CALCULATETABLE( VALUES( dAcessoSetor[Setor] ), dAcessoSetor[email] = u ), FILTER( { "*" }, CONTAINSSTRING( u, "\" ) ) ) VAR p = SELECTEDVALUE( dPaineis[Página] ) VAR s = SELECTEDVALUE( dPaineis[Setor] ) VAR ok = s IN { "Global", "Saúde dos dados" } || "*" IN meus || s IN meus RETURN IF( ISBLANK( p ), BLANK(), IF( ok, p, "HomePage" ) )
		displayFolder: Navegação
		lineageTag: 46cd3afe-acf9-585f-8110-1faf2fb845eb

	column 'Data e Hora'
		dataType: dateTime
		formatString: dd/mm/yy
		lineageTag: 75c2a020-a545-4e56-ae2d-e9806548222f
		summarizeBy: none
		sourceColumn: Data e Hora

		annotation SummarizationSetBy = Automatic

	partition Atualizacao = m
		mode: import
		source =
				let
				    Fonte = DateTimeZone.SwitchZone(DateTimeZone.LocalNow(),-3),
				    #"Convertido para Tabela" = #table(1, {{Fonte}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Convertido para Tabela",{{"Column1", "Data e Hora"}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Colunas Renomeadas",{{"Data e Hora", type datetimezone}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

