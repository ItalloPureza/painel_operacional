table Atualizacao
	lineageTag: ab29ba99-4ba6-48af-89d5-c7928da828ff

	measure Atualização = "Atualizado em " & FORMAT( SELECTEDVALUE( 'Atualizacao'[Data e Hora] ), "dd/mm/yy hh:nn" )
		lineageTag: aa655df9-10b1-4aa2-8d16-5d12d1e1f239

	measure 'Tem Acesso' =
			
			VAR u = LOWER( USERPRINCIPALNAME() )
			VAR setorPagina = SELECTEDVALUE( dSetorPagina[Setor] )
			VAR meus = UNION( CALCULATETABLE( VALUES( dAcessoSetor[Setor] ), dAcessoSetor[email] = u ), FILTER( { "*" }, CONTAINSSTRING( u, "\" ) ) )
			RETURN
			    IF( setorPagina = "Global" || "*" IN meus || setorPagina IN meus, 1, 0 )
		formatString: 0
		lineageTag: 1f210b0d-c3c4-4e05-b47e-5d32e4c44f99

	measure 'Mensagem Acesso' =
			
			IF( [Tem Acesso] = 0, "🔒 Você não tem acesso a este setor.", "" )
		lineageTag: cb8f7a31-00e4-4d19-bc21-da853322b1da

	measure 'Transp Cadeado' = IF([Tem Acesso]=1, 100, 0)
		formatString: 0
		lineageTag: 0a7b7b2b-9f70-42ab-8720-0fa3ecfca1c4

	measure 'Nav Suporte' =
			
			VAR u = LOWER( USERPRINCIPALNAME() )
			VAR meus = UNION( CALCULATETABLE( VALUES( dAcessoSetor[Setor] ), dAcessoSetor[email] = u ), FILTER( { "*" }, CONTAINSSTRING( u, "\" ) ) )
			RETURN IF( "*" IN meus || "Suporte" IN meus, "Suporte - Resultados", "HomePage" )
		lineageTag: 4a4a2c32-4c2a-4240-8704-38b47dbeafe6

	measure 'Nav Lives' =
			
			VAR u = LOWER( USERPRINCIPALNAME() )
