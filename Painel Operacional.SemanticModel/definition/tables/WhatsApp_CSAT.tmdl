table WhatsApp_CSAT
	lineageTag: 2ee94702-7935-5201-b97e-1aab8651e417

	/// Segue Tipo, Status e Assunto do atendimento (filtros da tela) pelo ticket do WhatsApp.
	measure 'Respostas CSAT' = VAR t = CALCULATETABLE( VALUES( WhatsApp_Atendimentos[ticket_whatsapp_id] ), REMOVEFILTERS( Calendario ), REMOVEFILTERS( dColaboradorMes ), WhatsApp_Atendimentos[ticket_whatsapp_id] <> "" ) RETURN IF( ISFILTERED( WhatsApp_Atendimentos[Tipo] ) || ISFILTERED( WhatsApp_Atendimentos[Status] ) || ISFILTERED( WhatsApp_Atendimentos[Assunto] ), CALCULATE( COUNTROWS( WhatsApp_CSAT ), KEEPFILTERS( TREATAS( t, WhatsApp_CSAT[ticket_whatsapp_id] ) ) ), COUNTROWS( WhatsApp_CSAT ) )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: bec76bd4-6e7c-5859-b004-a002bb54ef70

	/// Segue Tipo, Status e Assunto do atendimento (filtros da tela) pelo ticket do WhatsApp.
	measure 'CSAT Médio' = VAR t = CALCULATETABLE( VALUES( WhatsApp_Atendimentos[ticket_whatsapp_id] ), REMOVEFILTERS( Calendario ), REMOVEFILTERS( dColaboradorMes ), WhatsApp_Atendimentos[ticket_whatsapp_id] <> "" ) RETURN IF( ISFILTERED( WhatsApp_Atendimentos[Tipo] ) || ISFILTERED( WhatsApp_Atendimentos[Status] ) || ISFILTERED( WhatsApp_Atendimentos[Assunto] ), CALCULATE( AVERAGEX( WhatsApp_CSAT, MAX( WhatsApp_CSAT[Nota], 1 ) ), KEEPFILTERS( TREATAS( t, WhatsApp_CSAT[ticket_whatsapp_id] ) ) ), AVERAGEX( WhatsApp_CSAT, MAX( WhatsApp_CSAT[Nota], 1 ) ) )
		formatString: 0.00
		displayFolder: WhatsApp
		lineageTag: 48804e70-cefa-57ee-b3bc-3ac6fba7ee67

	measure '% Notas 9 e 10' = DIVIDE( CALCULATE( [Respostas CSAT], WhatsApp_CSAT[Nota] >= 9 ), [Respostas CSAT] )
		formatString: 0.00%
		displayFolder: WhatsApp
		lineageTag: 49166906-b42b-5e08-bd25-13fa1306ee37

