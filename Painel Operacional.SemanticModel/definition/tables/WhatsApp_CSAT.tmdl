	column 'Mês da Composição' = ( VAR _d = WhatsApp_CSAT[Data] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: 388f69da-348a-5a14-98f0-9f3392370822
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Chave Pessoa Mês' = IF( TRIM( WhatsApp_CSAT[agente_email] ) <> "", LOWER( TRIM( WhatsApp_CSAT[agente_email] ) ) & "|" & WhatsApp_CSAT[Mês da Composição] )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: 638b3511-a525-5f89-bab5-23967770d8a8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition WhatsApp_CSAT = m
		mode: import
		queryGroup: WhatsApp
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="WhatsApp_CSAT",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id", Int64.Type}, {"ticket_whatsapp_id", type text}, {"contato_identity", type text}, {"Tipo", type text}, {"Respondido em", type datetime}, {"Data", type datetime}, {"agente_email", type text}, {"Nota", Int64.Type}, {"Vínculo", type text}, {"Extracao", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

