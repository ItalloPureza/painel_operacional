				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"periodo", type datetime}, {"id", Int64.Type}, {"empresa_id", Int64.Type}, {"nome", type text}, {"ativo", Int64.Type}, {"created_at", type datetime}, {"updated_at", type datetime}, {"codigo_servico", type text}, {"iss_aliquota", type number}})
