	partition Contratos_historico_items = m
		mode: import
		queryGroup: Contratos
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Contratos_historico_items",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"periodo", type datetime}, {"contrato_id", Int64.Type}, {"id", Int64.Type}, {"item_catalogo_id", Int64.Type}, {"qtde", type number}, {"vr_total", type number}, {"Ativo no Contrato?", Int64.Type}, {"created_at", type datetime}, {"updated_at", type datetime}, {"indice_conversao", type number}, {"custom_sistema_versao", type text}, {"vr_total_mesalizado", type number}, {"Chave Contrato", Int64.Type}})
				in
				    Tipos


	annotation PBI_ResultType = Table

