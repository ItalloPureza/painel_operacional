	partition CRM_Atividades = m
		mode: import
		queryGroup: CRM
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="CRM_Atividades",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Apagada_status", type logical}, {"Apagada_em", type datetime}, {"Extracao", type datetime}, {"Criador", type text}, {"Criado_em", type datetime}, {"CNPJ", type text}, {"ID_Alfa", type text}, {"Cliente_Nome_Fantasia", type text}, {"Cliente_Razao_Social", type text}, {"Atividade", type text}, {"Data_Prazo", type datetime}, {"Data_Resolucao", type datetime}, {"Atividade Notas", type text}, {"Atividades_Responsavel", type text}, {"Regra_descricao", type text}, {"Regra_id", Int64.Type}, {"Status", type text}, {"Status_id", Int64.Type}, {"Categoria", type text}, {"Tipo de Atividade", type text}, {"owner_email", type text}, {"custom_fields_numero_ticket_helpdesk", type text}, {"Data_Inicio", type datetime}, {"Data_Criacao", type datetime}, {"Responsavel_Pelo_Cliente", type text}, {"CS", type text}})
				in
				    Tipos


	annotation PBI_ResultType = Table

