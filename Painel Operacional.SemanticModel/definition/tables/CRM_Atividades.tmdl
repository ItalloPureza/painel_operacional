	column Setor = LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], LOWER( TRIM( CRM_Atividades[Responsavel_Email] ) ), dColaboradorMes[AnoMes], CRM_Atividades[Mês da Composição], BLANK() )
		dataType: string
		lineageTag: 6a46b56d-20ca-4adf-a63e-a77855688809
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

