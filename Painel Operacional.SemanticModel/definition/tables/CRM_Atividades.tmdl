	column 'Registro do Cliente' = VAR vCli = CRM_Atividades[ID_Alfa] RETURN IF( CRM_Atividades[Tipo de Atividade] = "Análise de Migração", CALCULATE( MAX( CRM_Backup_Diario[Dt_Cadastro] ), REMOVEFILTERS( CRM_Atividades ), CRM_Backup_Diario[ID_Legado] = vCli ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Migração
		lineageTag: c26cd94e-0309-501c-bcff-1af1641e7972
