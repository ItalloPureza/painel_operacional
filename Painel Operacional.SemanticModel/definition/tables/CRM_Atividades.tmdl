table CRM_Atividades
	lineageTag: dcd77fa4-c95e-4bda-a38d-fa7860f72ccc

	/// Atividades do CRM por data de CRIAÇÃO; sem as apagadas e sem o tipo Onboarding (como o antigo).
	measure 'Atividades Criadas' = CALCULATE( COUNTROWS( CRM_Atividades ), CRM_Atividades[Apagada_status] <> TRUE(), KEEPFILTERS( CRM_Atividades[Tipo de Atividade] <> "Onboarding" ), USERELATIONSHIP( CRM_Atividades[Data_Criacao], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: 5d3ccae2-4bca-5877-8589-0008731016da

	/// Atividades do CRM por data de PRAZO; sem as apagadas e sem o tipo Onboarding (como o antigo).
	measure 'Atividades com Prazo no Período' = CALCULATE( COUNTROWS( CRM_Atividades ), CRM_Atividades[Apagada_status] <> TRUE(), KEEPFILTERS( CRM_Atividades[Tipo de Atividade] <> "Onboarding" ), USERELATIONSHIP( CRM_Atividades[Data_Prazo], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: fa429e08-e069-51d1-b7fa-981886108f14

	/// Atividades do CRM por data de CONCLUSÃO (padrão); sem as apagadas e sem o tipo Onboarding (como o antigo).
	measure 'Atividades Concluídas' = CALCULATE( COUNTROWS( CRM_Atividades ), NOT ISBLANK( CRM_Atividades[Data_Resolucao] ), CRM_Atividades[Apagada_status] <> TRUE(), KEEPFILTERS( CRM_Atividades[Tipo de Atividade] <> "Onboarding" ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: e439978e-dffa-585d-9de3-98a38d132577

	/// No prazo ÷ concluídas, TODOS os tipos — o '%SLA CRM' da Carteira Geral do OKR 2026.
	measure '% Prazo de Todas as Atividades' = DIVIDE( CALCULATE( [Atividades Concluídas], CRM_Atividades[Status do Prazo] = "No prazo" ), [Atividades Concluídas] )
		formatString: 0.00%
		displayFolder: SLA de Atividades
		lineageTag: e9b28767-8016-516a-81b3-6fa269a502a5

	/// Meta de % de migração ativa (intranet: Migração Ativas, setor Onboarding). Meta ÷ 100.
	measure 'Meta % Migração Ativa' = VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta % Migração Ativa" ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0, DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) )
		formatString: 0.00%
		displayFolder: Migrações
		lineageTag: 3f605063-e37f-5ed0-99e1-018a5018ce55

	/// Média de dias entre o registro do cliente (Data Registro do CRM) e a conclusão da migração. Segue a busca ID/CNPJ da tela de Migrações (feita na dTTFV).
	measure 'Dias até a Migração (média)' = VAR fi = ISFILTERED( dTTFV[ID do Cliente (busca)] ) || ISFILTERED( dTTFV[CNPJ do Cliente (busca)] ) VAR ids = CALCULATETABLE( VALUES( dTTFV[ID do Cliente (busca)] ), REMOVEFILTERS( Calendario ) ) RETURN IF( fi, CALCULATE( CALCULATE( AVERAGE( CRM_Atividades[Dias até a Migração] ), CRM_Atividades[Tipo de Atividade] = "Análise de Migração", CRM_Atividades[Apagada_status] <> TRUE(), NOT ISBLANK( CRM_Atividades[Data_Resolucao] ) ), KEEPFILTERS( TREATAS( ids, CRM_Atividades[ID do Cliente (busca)] ) ) ), CALCULATE( AVERAGE( CRM_Atividades[Dias até a Migração] ), CRM_Atividades[Tipo de Atividade] = "Análise de Migração", CRM_Atividades[Apagada_status] <> TRUE(), NOT ISBLANK( CRM_Atividades[Data_Resolucao] ) ) )
		formatString: 0.00
		displayFolder: Migração
		lineageTag: 591aa860-fdca-562e-af44-fb18e7e7c873

	/// Ativadas ÷ (ativadas + não ativadas) do escopo filtrado. Filtrando um tipo sem 'Migração - Ativado' (ex.: só 'Não Ativado'), o escopo é só esse tipo e dá 100%. Recusadas ficam fora.
	measure '% Migração Ativa' = VAR ativa = NOT ISFILTERED( CRM_Atividades[Categoria] ) || "Migração - Ativado" IN VALUES( CRM_Atividades[Categoria] ) RETURN DIVIDE( IF( ativa, [Migrações Ativadas], [Migrações] ), [Migrações] )
		formatString: 0.00%
		displayFolder: Migração
		lineageTag: cbfe0154-edee-50ea-842d-9131ec9baf81

	/// Análises de migração concluídas como 'Migração - Recusado' (fora do total e do %). Segue a busca ID/CNPJ da tela de Migrações (feita na dTTFV).
	measure 'Migrações Recusadas' = VAR fi = ISFILTERED( dTTFV[ID do Cliente (busca)] ) || ISFILTERED( dTTFV[CNPJ do Cliente (busca)] ) VAR ids = CALCULATETABLE( VALUES( dTTFV[ID do Cliente (busca)] ), REMOVEFILTERS( Calendario ) ) RETURN IF( fi, CALCULATE( CALCULATE( [Atividades Concluídas], CRM_Atividades[Tipo de Atividade] = "Análise de Migração", KEEPFILTERS( CRM_Atividades[Categoria] = "Migração - Recusado" ) ), KEEPFILTERS( TREATAS( ids, CRM_Atividades[ID do Cliente (busca)] ) ) ), CALCULATE( [Atividades Concluídas], CRM_Atividades[Tipo de Atividade] = "Análise de Migração", KEEPFILTERS( CRM_Atividades[Categoria] = "Migração - Recusado" ) ) )
		formatString: #,0
		displayFolder: Migração
		lineageTag: e9e85a8b-9af7-5d5e-913a-fda0722d359f

	/// Ativadas + não ativadas (as 'Recusado' ficam fora, como no OKR 2026).
	measure Migrações = [Migrações Ativadas] + [Migrações Não Ativadas]
		formatString: #,0
		displayFolder: Migração
		lineageTag: c6e902c3-c459-5ad3-aa27-9bbf8609f02a

	/// Análises de migração concluídas como 'Migração - Não Ativado'. Segue a busca ID/CNPJ da tela de Migrações (feita na dTTFV).
	measure 'Migrações Não Ativadas' = VAR fi = ISFILTERED( dTTFV[ID do Cliente (busca)] ) || ISFILTERED( dTTFV[CNPJ do Cliente (busca)] ) VAR ids = CALCULATETABLE( VALUES( dTTFV[ID do Cliente (busca)] ), REMOVEFILTERS( Calendario ) ) RETURN IF( fi, CALCULATE( CALCULATE( [Atividades Concluídas], CRM_Atividades[Tipo de Atividade] = "Análise de Migração", KEEPFILTERS( CRM_Atividades[Categoria] = "Migração - Não Ativado" ) ), KEEPFILTERS( TREATAS( ids, CRM_Atividades[ID do Cliente (busca)] ) ) ), CALCULATE( [Atividades Concluídas], CRM_Atividades[Tipo de Atividade] = "Análise de Migração", KEEPFILTERS( CRM_Atividades[Categoria] = "Migração - Não Ativado" ) ) )
		formatString: #,0
		displayFolder: Migração
		lineageTag: d9a26100-d48b-5b11-b422-6e02e2d4c60e

	/// Análises de migração concluídas como 'Migração - Ativado', por data de CONCLUSÃO. Segue a busca ID/CNPJ da tela de Migrações (feita na dTTFV).
	measure 'Migrações Ativadas' = VAR fi = ISFILTERED( dTTFV[ID do Cliente (busca)] ) || ISFILTERED( dTTFV[CNPJ do Cliente (busca)] ) VAR ids = CALCULATETABLE( VALUES( dTTFV[ID do Cliente (busca)] ), REMOVEFILTERS( Calendario ) ) RETURN IF( fi, CALCULATE( CALCULATE( [Atividades Concluídas], CRM_Atividades[Tipo de Atividade] = "Análise de Migração", KEEPFILTERS( CRM_Atividades[Categoria] = "Migração - Ativado" ) ), KEEPFILTERS( TREATAS( ids, CRM_Atividades[ID do Cliente (busca)] ) ) ), CALCULATE( [Atividades Concluídas], CRM_Atividades[Tipo de Atividade] = "Análise de Migração", KEEPFILTERS( CRM_Atividades[Categoria] = "Migração - Ativado" ) ) )
		formatString: #,0
		displayFolder: Migração
		lineageTag: e97de6c5-70cc-53ca-a435-69e955fb86bc

	/// Clientes com atividade do SLA concluída no período.
	measure 'Clientes com Atividade no SLA' = CALCULATE( DISTINCTCOUNTNOBLANK( CRM_Atividades[ID_Alfa] ), NOT ISBLANK( CRM_Atividades[Data_Resolucao] ), CRM_Atividades[Apagada_status] <> TRUE(), CRM_Atividades[Entra no SLA] = "Sim" )
		formatString: #,0
		displayFolder: SLA de Atividades
		lineageTag: 8dbd9e4a-6af3-59fb-ad33-9f876d2a8b45

	/// No prazo ÷ concluídas (tipos do SLA). Por data de CONCLUSÃO.
	measure '% SLA das Atividades' = DIVIDE( [Atividades no Prazo], [Atividades no SLA] )
		formatString: 0.00%
		displayFolder: SLA de Atividades
		lineageTag: 9a18b24a-ad0c-5a8c-8353-40ebea288019

	/// Atividades do SLA concluídas depois da data prevista (ou sem data prevista).
	measure 'Atividades Fora do Prazo' = [Atividades no SLA] - [Atividades no Prazo]
		formatString: #,0
		displayFolder: SLA de Atividades
		lineageTag: 1b43c808-5625-5093-89ad-43ee0b5cd218

	/// Atividades do SLA concluídas até a data prevista.
	measure 'Atividades no Prazo' = CALCULATE( [Atividades no SLA], CRM_Atividades[Status do Prazo] = "No prazo" )
		formatString: #,0
		displayFolder: SLA de Atividades
		lineageTag: 04eb74b2-2609-518e-af9c-49aa96ff8c9c

	/// Atividades concluídas dos tipos do SLA (Alerta, Alinhamento Inicial, Checkout, Checkout Onboarding, Conclusão de Etapa, Contato, Contato Agendamento, Contato Kappa, Tratativa Clientes Bloqueados, Tratativa Onboarding, Tratativa Ongoing), por data de CONCLUSÃO.
	measure 'Atividades no SLA' = CALCULATE( [Atividades Concluídas], CRM_Atividades[Entra no SLA] = "Sim" )
		formatString: #,0
		displayFolder: SLA de Atividades
		lineageTag: e6ff0cda-5292-5958-a8a4-31c0eb2e4cf9

	/// Média de dias entre a conclusão da migração e o fechamento do cancelamento (só quem cancelou depois).
	measure 'Dias no Ongoing até Cancelar (média)' = CALCULATE( AVERAGE( CRM_Atividades[Dias no Ongoing até Cancelar] ), CRM_Atividades[Tipo de Atividade] = "Análise de Migração", CRM_Atividades[Apagada_status] <> TRUE(), NOT ISBLANK( CRM_Atividades[Data_Resolucao] ) )
		formatString: 0.00
		displayFolder: Migração recebida
		lineageTag: 50796e63-3aa5-55d6-8db6-f2370b2e0010

	/// Cancelaram depois da migração ÷ migrações.
	measure '% Migrados que Cancelaram' = DIVIDE( [Migrados que Cancelaram], [Migrações] )
		formatString: 0.00%
		displayFolder: Migração recebida
		lineageTag: a41e3134-b8e6-59ef-b7c0-33227886a75c

	/// Migrações cujo cliente tem cancelamento efetivado no Alfa (antes ou depois) — o 'Status Cliente' do OKR 2026.
	measure 'Migrados com Ticket de Cancelamento' = CALCULATE( [Migrações], CRM_Atividades[Situação após a Migração] <> "Sem cancelamento" )
		formatString: #,0
		displayFolder: Migração recebida
		lineageTag: 5fc9beca-fa85-5e75-887c-f42e7a3caace

	/// Migrações (ativadas + não ativadas) cujo cliente teve cancelamento efetivado no Alfa DEPOIS da conclusão.
	measure 'Migrados que Cancelaram' = CALCULATE( [Migrações], CRM_Atividades[Situação após a Migração] = "Cancelou depois da migração" )
		formatString: #,0
		displayFolder: Migração recebida
		lineageTag: bff59b95-2aa5-5060-8ad7-8a8afba3612d

