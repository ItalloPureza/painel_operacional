	column CS
		dataType: string
		lineageTag: ca80e5f7-1e4b-56d5-b89b-1919e17fe744
		summarizeBy: none
		sourceColumn: CS

		annotation SummarizationSetBy = Automatic

	column 'Email do CS' = IF( TRIM( CRM_Atividades[CS] ) <> "", VAR n = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( LOWER( TRIM( CRM_Atividades[CS] ) ), "á", "a" ), "à", "a" ), "â", "a" ), "ã", "a" ), "ä", "a" ), "é", "e" ), "è", "e" ), "ê", "e" ), "ë", "e" ), "í", "i" ), "ì", "i" ), "î", "i" ), "ï", "i" ), "ó", "o" ), "ò", "o" ), "ô", "o" ), "õ", "o" ), "ö", "o" ), "ú", "u" ), "ù", "u" ), "û", "u" ), "ü", "u" ), "ç", "c" ), "ñ", "n" ), "  ", " " ) VAR p = SUBSTITUTE( n, " ", "|" ) VAR curto = IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), n ) VAR e1 = IF( n = "", BLANK(), LOOKUPVALUE( dColaborador[email], dColaborador[Nome Normalizado], n, BLANK() ) ) RETURN IF( ISBLANK( e1 ) && n <> "", LOOKUPVALUE( dColaborador[email], dColaborador[Nome Curto Normalizado], curto, BLANK() ), e1 ) )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: 419b26e4-a426-5866-8f21-f740f6fe54fd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do CS' = IF( ISBLANK( CRM_Atividades[Email do CS] ), IF( TRIM( CRM_Atividades[CS] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], CRM_Atividades[Email do CS], dColaboradorMes[AnoMes], CRM_Atividades[Mês da Composição], BLANK() ), "(sem equipe)" ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: e6a5a57c-c1b2-58cb-94ea-b42478b613a8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & CRM_Atividades[ID_Alfa] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: 2d6896a8-745a-527f-99fa-5d82cd2d2d35
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ do Cliente (busca)' = VAR c = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( TRIM( CRM_Atividades[CNPJ] ), ".", "" ), "/", "" ), "-", "" ), " ", "" ) RETURN IF( c = "", BLANK(), c )
		dataType: string
		displayFolder: Cliente
		lineageTag: e6f6c747-a084-5250-b36a-cfd037641ad2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = CRM_Atividades[Data_Resolucao] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: 9add8a2e-12e3-53d6-87bf-76313fdb4c2f
