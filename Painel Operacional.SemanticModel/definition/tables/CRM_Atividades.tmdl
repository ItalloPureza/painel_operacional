	column 'Situação após a Migração' = VAR c = CRM_Atividades[Cancelamento do Cliente] VAR m = CRM_Atividades[Data_Resolucao] RETURN IF( CRM_Atividades[Tipo de Atividade] = "Análise de Migração" && CRM_Atividades[Categoria] IN { "Migração - Ativado", "Migração - Não Ativado" }, SWITCH( TRUE(), ISBLANK( c ), "Sem cancelamento", c >= m, "Cancelou depois da migração", "Cancelamento anterior à migração" ) )
		dataType: string
		displayFolder: Migração recebida
		lineageTag: ee5e8cbd-6d2a-5582-bf2a-e5e913e68001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias no Ongoing até Cancelar' = IF( CRM_Atividades[Situação após a Migração] = "Cancelou depois da migração", INT( CRM_Atividades[Cancelamento do Cliente] - CRM_Atividades[Data_Resolucao] ) )
		dataType: int64
