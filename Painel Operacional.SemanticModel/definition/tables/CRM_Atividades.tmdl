		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Data_Criacao
		dataType: dateTime
		formatString: dd/mm/yy
		lineageTag: d9819cf6-d21f-5c0a-8fd0-abe145224109
		summarizeBy: none
		sourceColumn: Data_Criacao

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Entra no SLA' = IF( CRM_Atividades[Tipo de Atividade] IN { "Alerta", "Alinhamento Inicial", "Checkout", "Checkout Onboarding", "Conclusão de Etapa", "Contato", "Contato Agendamento", "Contato Kappa", "Tratativa Clientes Bloqueados", "Tratativa Onboarding", "Tratativa Ongoing" }, "Sim", "Não" )
		dataType: string
		displayFolder: SLA de Atividades
		lineageTag: c1f8ad58-a9da-5496-bbfc-ca27a15587f4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Status do Prazo' = IF( ISBLANK( CRM_Atividades[Data_Resolucao] ), BLANK(), IF( NOT ISBLANK( CRM_Atividades[Data_Prazo] ) && CRM_Atividades[Data_Resolucao] <= CRM_Atividades[Data_Prazo], "No prazo", "Fora do prazo" ) )
		dataType: string
		displayFolder: SLA de Atividades
		lineageTag: 35f01555-0001-5ecd-87ca-fb0ca7e15ab8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do Responsável' = IF( ISBLANK( LOWER( TRIM( CRM_Atividades[Responsavel_Email] ) ) ), IF( TRIM( CRM_Atividades[Atividades_Responsavel] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], LOWER( TRIM( CRM_Atividades[Responsavel_Email] ) ), dColaboradorMes[AnoMes], CRM_Atividades[Mês da Composição], BLANK() ), "(sem equipe)" ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: 0061c08f-e97d-55bf-9a99-089081bff220
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias até a Migração' = IF( CRM_Atividades[Categoria] IN { "Migração - Ativado", "Migração - Não Ativado" } && NOT ISBLANK( CRM_Atividades[Registro do Cliente] ) && NOT ISBLANK( CRM_Atividades[Data_Resolucao] ), INT( CRM_Atividades[Data_Resolucao] - CRM_Atividades[Registro do Cliente] ) )
		dataType: int64
		formatString: 0
		displayFolder: Migração
		lineageTag: 544f4c4a-f532-5fe7-98a0-98f607355b75
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Responsavel_Pelo_Cliente
		dataType: string
		lineageTag: f22790b0-f012-507b-b85d-e78b597a4e8b
		summarizeBy: none
		sourceColumn: Responsavel_Pelo_Cliente

		annotation SummarizationSetBy = Automatic

	column 'Email do Responsável pelo Cliente' = IF( CRM_Atividades[Tipo de Atividade] = "Análise de Migração", VAR n = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( LOWER( TRIM( CRM_Atividades[Responsavel_Pelo_Cliente] ) ), "á", "a" ), "à", "a" ), "â", "a" ), "ã", "a" ), "ä", "a" ), "é", "e" ), "è", "e" ), "ê", "e" ), "ë", "e" ), "í", "i" ), "ì", "i" ), "î", "i" ), "ï", "i" ), "ó", "o" ), "ò", "o" ), "ô", "o" ), "õ", "o" ), "ö", "o" ), "ú", "u" ), "ù", "u" ), "û", "u" ), "ü", "u" ), "ç", "c" ), "ñ", "n" ), "  ", " " ) VAR p = SUBSTITUTE( n, " ", "|" ) VAR curto = IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), n ) VAR e1 = IF( n = "", BLANK(), LOOKUPVALUE( dColaborador[email], dColaborador[Nome Normalizado], n, BLANK() ) ) RETURN IF( ISBLANK( e1 ) && n <> "", LOOKUPVALUE( dColaborador[email], dColaborador[Nome Curto Normalizado], curto, BLANK() ), e1 ) )
		dataType: string
		isHidden
		displayFolder: Migração
		lineageTag: fdec5781-a799-5860-b248-3d30244ef87a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do Responsável pelo Cliente' = IF( CRM_Atividades[Tipo de Atividade] = "Análise de Migração", IF( ISBLANK( CRM_Atividades[Email do Responsável pelo Cliente] ), IF( TRIM( CRM_Atividades[Responsavel_Pelo_Cliente] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], CRM_Atividades[Email do Responsável pelo Cliente], dColaboradorMes[AnoMes], CRM_Atividades[Mês da Composição], BLANK() ), "(sem equipe)" ) ) )
		dataType: string
		displayFolder: Migração
		lineageTag: b1cd844b-bc1c-5ff3-bc15-c519d1a5cc3a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Setor do Responsável pelo Cliente' = LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], CRM_Atividades[Email do Responsável pelo Cliente], dColaboradorMes[AnoMes], CRM_Atividades[Mês da Composição], BLANK() )
