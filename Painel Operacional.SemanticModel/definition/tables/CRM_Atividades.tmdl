		annotation SummarizationSetBy = Automatic

	column 'Ticket do Cancelamento do Cliente' = VAR i = IFERROR( VALUE( CRM_Atividades[ID_Alfa] ), -1 ) RETURN IF( CRM_Atividades[Tipo de Atividade] = "Análise de Migração" && CRM_Atividades[Categoria] IN { "Migração - Ativado", "Migração - Não Ativado" }, MAXX( FILTER( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[idLegado] = i && Helpdesk_Cancelamentos[sistema] = "Alfa" && Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado" ), Helpdesk_Cancelamentos[id] ) )
		dataType: int64
		formatString: 0
		displayFolder: Migração recebida
		lineageTag: 140b80cf-b0f1-5f4b-a110-b57d79fa3123
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cancelamento do Cliente' = VAR i = IFERROR( VALUE( CRM_Atividades[ID_Alfa] ), -1 ) RETURN IF( CRM_Atividades[Tipo de Atividade] = "Análise de Migração" && CRM_Atividades[Categoria] IN { "Migração - Ativado", "Migração - Não Ativado" }, MAXX( FILTER( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[idLegado] = i && Helpdesk_Cancelamentos[sistema] = "Alfa" && Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado" ), Helpdesk_Cancelamentos[Data de Fechamento] ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Migração recebida
		lineageTag: c03c4db4-fe2d-5b4e-aa52-b6fa6c5f6a19
