	column Setor = VAR r = TRIM( FORMAT( Ligacoes_API[Ramal], "0" ) ) RETURN IF( r <> "" && r <> "0", LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[Ramal], r, dColaboradorMes[AnoMes], Ligacoes_API[Mês da Composição], BLANK() ) )
		dataType: string
		lineageTag: 87269b72-296c-4d76-833e-7e93aa77af1a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column data_extracao
		dataType: dateTime
		formatString: dd/mm/yy
		lineageTag: 2c046622-c79c-4477-8562-6430f4c98169
		summarizeBy: none
		sourceColumn: data_extracao

		annotation SummarizationSetBy = Automatic

	column Data_Inicio
		dataType: dateTime
		formatString: dd/mm/yy
		lineageTag: 5d3a4047-4bd2-51d9-99b0-63e70668a790
		summarizeBy: none
		sourceColumn: Data_Inicio

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Tempo Falado (s)' = IFERROR( ROUND( TIMEVALUE( Ligacoes_API[Tempo Falado] ) * 86400, 0 ), BLANK() )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Ligações
		lineageTag: f03faf6f-96d7-5a73-a521-0a4cb42744bc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duração (s)' = IF( NOT ISBLANK( Ligacoes_API[Data_hora_fim] ), DATEDIFF( Ligacoes_API[Data_hora_inicio], Ligacoes_API[Data_hora_fim], SECOND ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Ligações
		lineageTag: ba5f70e4-ddb0-518f-aa4c-4037ea4e5630
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mais de 3 min' = IF( Ligacoes_API[Tempo Falado (s)] >= 180, "Sim", "Não" )
		dataType: string
		displayFolder: Ligações
		lineageTag: 5a43b3b4-b66e-54f6-944a-c8e2f8916d04
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Email do Ramal' = VAR r = TRIM( FORMAT( Ligacoes_API[Ramal], "0" ) ) RETURN IF( r <> "" && r <> "0", LOOKUPVALUE( dPessoaSetor[email_norm], dPessoaSetor[ramal_norm], r, BLANK() ) )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: a3177d49-ffe6-5451-893b-60da9d0c5caa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Responsável (Ramal)' = IF( ISBLANK( Ligacoes_API[Email do Ramal] ), "(ramal sem cadastro)", LOOKUPVALUE( dColaborador[Colaborador], dColaborador[email], Ligacoes_API[Email do Ramal], BLANK() ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: f638cc04-0ec9-5051-8c00-e98242c40112
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe (Ramal)' = IF( ISBLANK( Ligacoes_API[Email do Ramal] ), "(ramal sem cadastro)", COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], Ligacoes_API[Email do Ramal], dColaboradorMes[AnoMes], Ligacoes_API[Mês da Composição], BLANK() ), "(sem equipe)" ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: 7d40503b-5acb-5875-a6cf-3b27027953c8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = Ligacoes_API[Data_Inicio] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: fe755949-64f1-59da-bb4b-4d279580a7ba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Ligacoes_API = m
		mode: import
		queryGroup: Telefonia
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Ligacoes_API",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id", Int64.Type}, {"Protocolo", Int64.Type}, {"Situação", type text}, {"Sentido", type text}, {"Tipo", type text}, {"Nome", type text}, {"Origem", type text}, {"Destino", type text}, {"Ramal", Int64.Type}, {"Data_hora_inicio", type datetime}, {"Data_hora_fim", type datetime}, {"Tempo Falado", type text}, {"Motivo Desligamento", type text}, {"Lado Desligamento", type text}, {"UUID", type text}, {"data_extracao", type datetime}, {"Data_Inicio", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

