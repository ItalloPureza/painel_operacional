table Ligacoes_API
	lineageTag: 9acfe0eb-0335-4062-92af-88266eb09c20

	/// Ligações por data de INÍCIO.
	measure Ligações = CALCULATE( COUNTROWS( Ligacoes_API ), NOT ISBLANK( Ligacoes_API[Data_Inicio] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: 69598b7c-47cb-5828-8740-8c5bcd2ce04d

	/// Tempo de conversa total em hh:mm:ss (para cartão).
	measure 'Tempo Falado Total' = VAR s = CALCULATE( SUM( Ligacoes_API[Tempo Falado (s)] ), NOT ISBLANK( Ligacoes_API[Data_Inicio] ) ) RETURN IF( ISBLANK( s ), "", FORMAT( INT( s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( s, 60 ), "00" ) )
		displayFolder: Ligações
		lineageTag: 6bfda2d1-c3d7-534d-bb73-9a741d131ec3

	/// Tempo falado ÷ ligações, em hh:mm:ss (para cartão).
	measure 'TMA Ligações' = VAR s = ROUND( DIVIDE( CALCULATE( SUM( Ligacoes_API[Tempo Falado (s)] ), NOT ISBLANK( Ligacoes_API[Data_Inicio] ) ), [Ligações] ), 0 ) RETURN IF( ISBLANK( s ), "", FORMAT( INT( s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( s, 60 ), "00" ) )
		displayFolder: Ligações
		lineageTag: 033cb290-007f-5189-aad6-23e1f20244ae

	/// Tempo falado ÷ ligações, em minutos.
	measure 'TMA Ligações (min)' = DIVIDE( CALCULATE( SUM( Ligacoes_API[Tempo Falado (s)] ), NOT ISBLANK( Ligacoes_API[Data_Inicio] ) ), [Ligações] * 60 )
		displayFolder: Ligações
		lineageTag: ad25b57e-07e9-586d-baaf-ac3465c40767

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 60, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Tempo das ligações sem conversa (0 s falados), em hh:mm:ss — mesma conta do OKR 2026.
	measure 'Tempo Parado' = VAR s = CALCULATE( SUM( Ligacoes_API[Duração (s)] ), Ligacoes_API[Tempo Falado (s)] = 0, NOT ISBLANK( Ligacoes_API[Data_Inicio] ) ) RETURN IF( ISBLANK( s ), "", FORMAT( INT( s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( s, 60 ), "00" ) )
		displayFolder: Ligações
		lineageTag: 13201b5f-36e6-5f66-9b8d-4b8376bcca4b

	/// Horas de conversa, por data de INÍCIO.
	measure 'Tempo Falado (h)' = CALCULATE( DIVIDE( SUM( Ligacoes_API[Tempo Falado (s)] ), 3600 ), NOT ISBLANK( Ligacoes_API[Data_Inicio] ) )
		displayFolder: Ligações
		lineageTag: 85415f8d-e048-5755-b7cd-1b0267d93b1f

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 3600, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Ligações com 3 minutos ou mais de conversa.
	measure 'Ligações com Mais de 3 min' = CALCULATE( [Ligações], Ligacoes_API[Mais de 3 min] = "Sim" )
		formatString: #,0
		displayFolder: Ligações
		lineageTag: 6b189a97-5699-5393-bf02-ae010790e410

	/// Atendidas ÷ ligações.
	measure '% Ligações Atendidas' = DIVIDE( [Ligações Atendidas], [Ligações] )
		formatString: 0.00%
		displayFolder: Ligações
		lineageTag: 8efaea7f-a168-5256-919d-c2a7d1813d63

	/// Ligações com situação 'Atendida', por data de INÍCIO.
	measure 'Ligações Atendidas' = CALCULATE( [Ligações], Ligacoes_API[Situação] = "Atendida" )
		formatString: #,0
		displayFolder: Ligações
		lineageTag: a75c50de-c4f0-55da-9539-58e4ac09a79d

