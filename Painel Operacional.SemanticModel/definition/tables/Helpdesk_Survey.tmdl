table Helpdesk_Survey
	lineageTag: 6460de4a-de06-43b5-8dd5-fd90c7cc2b26

	/// Respostas do CSAT (Helpdesk) por data da AVALIAÇÃO.
	measure 'Avaliações CSAT' = COUNTROWS( Helpdesk_Survey )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: c8f1aa05-6eb6-524e-bb68-a75d5688960d

	/// Parte das avaliações com nota de 0 a 6.
	measure '% Notas 0 a 6 (Lives)' = DIVIDE( CALCULATE( [Avaliações (Lives)], Helpdesk_Survey[value] <= 6 ), [Avaliações (Lives)] )
		formatString: 0.00%
		displayFolder: Lives
		lineageTag: f24b308e-b7da-50f6-bd82-0db167e67393

	/// Parte das avaliações com nota 9 ou 10.
	measure '% Notas 9 e 10 (Lives)' = DIVIDE( CALCULATE( [Avaliações (Lives)], Helpdesk_Survey[value] >= 9 ), [Avaliações (Lives)] )
		formatString: 0.00%
		displayFolder: Lives
		lineageTag: 2901e156-01d7-52b4-9947-fa09ce99f311

	/// Nota média de 0 a 10. Por data da avaliação.
	measure 'Nota Média (Lives)' = CALCULATE( AVERAGE( Helpdesk_Survey[value] ), Helpdesk_Survey[Serviço do Ticket] = "Live" )
		formatString: 0.00
		displayFolder: Lives
		lineageTag: 4cc752e7-685d-5dc3-806c-29ba9546a594

	/// Nota média ÷ 10 (mesma conta do CSAT do OKR 2026). Nota 0 vale 1 (metodologia da empresa: a escala do CSAT é de 1 a 10). Por data da avaliação.
	measure 'CSAT (Lives)' = CALCULATE( DIVIDE( AVERAGEX( Helpdesk_Survey, MAX( Helpdesk_Survey[value], 1 ) ), 10 ), Helpdesk_Survey[Serviço do Ticket] = "Live" )
		formatString: 0.00%
		displayFolder: Lives
		lineageTag: 7c7fa12b-2c6e-5e98-8f90-201a0d561d11

	/// Respostas do CSAT de tickets do serviço Live. Por data da AVALIAÇÃO.
	measure 'Avaliações (Lives)' = CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[Serviço do Ticket] = "Live" )
		formatString: #,0
		displayFolder: Lives
		lineageTag: a56c37ec-3c68-5fd6-8431-e6e41758051e

	/// Avaliações com nota 9 ou 10.
	measure 'Notas Promotoras' = CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[value] >= 9 )
		formatString: #,0
		displayFolder: CSAT
		lineageTag: 2d800cc1-c4c3-5113-8729-6b4d63f426c1

	/// Avaliações com nota 6 a 8.
	measure 'Notas Neutras' = CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[value] >= 6, Helpdesk_Survey[value] <= 8 )
		formatString: #,0
		displayFolder: CSAT
		lineageTag: dfc75a49-2203-5e2d-b2ea-78d30c8f070c

	/// Avaliações com nota 0 a 5 (faixa do OKR 2026).
	measure 'Notas Detratoras' = CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[value] <= 5 )
		formatString: #,0
		displayFolder: CSAT
		lineageTag: e8e6cd9e-289b-58f8-8f36-c468bbbe6edc

	/// Nota média de 0 a 10.
	measure 'Nota Média Helpdesk' = AVERAGE( Helpdesk_Survey[value] )
		formatString: 0.00
		displayFolder: CSAT
		lineageTag: a2ae3be8-88dc-51bd-87f8-b76cd402e135

	/// Nota média ÷ 10 (mesma conta do CSAT do OKR 2026). Nota 0 vale 1 (metodologia da empresa: a escala do CSAT é de 1 a 10). Por data da AVALIAÇÃO.
	measure 'CSAT Helpdesk' = DIVIDE( AVERAGEX( Helpdesk_Survey, MAX( Helpdesk_Survey[value], 1 ) ), 10 )
		formatString: 0.00%
		displayFolder: CSAT
		lineageTag: 098c6522-8a1c-570e-8ca9-310a5920654e

	/// Avaliações com nota até 6 (regra da Carteira Geral do OKR 2026), por data da avaliação.
	measure 'Notas Detratoras (0 a 6)' = CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[value] <= 6 )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: 670a3410-a93f-5a08-a784-ab5c56709a9b

	/// SEM DEFINIÇÃO na intranet (ver docs/metas-intranet.md): fica vazia. Meta de CSAT do Relacionamento.
	measure 'Meta CSAT Ouvidoria' = BLANK()
		formatString: 0.00%
		displayFolder: Ouvidoria
		lineageTag: 79a711b2-90c7-5a42-9d4c-6893635ed19a

	/// Nota média ÷ 10 — mesma conta do 'CSAT' do OKR 2026. Nota 0 vale 1 (metodologia da empresa: a escala do CSAT é de 1 a 10). Por data da avaliação. Segue Área, Equipe, Origem e Categoria do ticket (filtros da tela) pelos tickets avaliados.
	measure 'CSAT Ouvidoria' = VAR ids = CALCULATETABLE( VALUES( Helpdesk_Tickets[id] ), REMOVEFILTERS( Calendario ) ) RETURN IF( ISFILTERED( Helpdesk_Tickets[OuvAreaResponsavel] ) || ISFILTERED( Helpdesk_Tickets[OuvEquipeDemanda] ) || ISFILTERED( Helpdesk_Tickets[OuvOrigemTicket] ) || ISFILTERED( Helpdesk_Tickets[category] ), CALCULATE( DIVIDE( CALCULATE( AVERAGEX( Helpdesk_Survey, MAX( Helpdesk_Survey[value], 1 ) ), Helpdesk_Survey[Serviço do Ticket] = "Ouvidoria", Helpdesk_Survey[Fila do Ticket] = "Relacionamento com Cliente", Helpdesk_Survey[Categoria do Ticket] <> "Intenção de Cancelamento" ), 10 ), KEEPFILTERS( TREATAS( ids, Helpdesk_Survey[ticketId] ) ) ), DIVIDE( CALCULATE( AVERAGEX( Helpdesk_Survey, MAX( Helpdesk_Survey[value], 1 ) ), Helpdesk_Survey[Serviço do Ticket] = "Ouvidoria", Helpdesk_Survey[Fila do Ticket] = "Relacionamento com Cliente", Helpdesk_Survey[Categoria do Ticket] <> "Intenção de Cancelamento" ), 10 ) )
		formatString: 0.00%
		displayFolder: Ouvidoria
		lineageTag: 7939f3b6-1e7d-58c7-9232-4ece998d2ea9

	/// Avaliações de tickets do serviço Ouvidoria da fila Relacionamento com Cliente (sem 'Intenção de Cancelamento'). Segue Área, Equipe, Origem e Categoria do ticket (filtros da tela) pelos tickets avaliados.
	measure 'Avaliações Ouvidoria' = VAR ids = CALCULATETABLE( VALUES( Helpdesk_Tickets[id] ), REMOVEFILTERS( Calendario ) ) RETURN IF( ISFILTERED( Helpdesk_Tickets[OuvAreaResponsavel] ) || ISFILTERED( Helpdesk_Tickets[OuvEquipeDemanda] ) || ISFILTERED( Helpdesk_Tickets[OuvOrigemTicket] ) || ISFILTERED( Helpdesk_Tickets[category] ), CALCULATE( CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[Serviço do Ticket] = "Ouvidoria", Helpdesk_Survey[Fila do Ticket] = "Relacionamento com Cliente", Helpdesk_Survey[Categoria do Ticket] <> "Intenção de Cancelamento" ), KEEPFILTERS( TREATAS( ids, Helpdesk_Survey[ticketId] ) ) ), CALCULATE( COUNTROWS( Helpdesk_Survey ), Helpdesk_Survey[Serviço do Ticket] = "Ouvidoria", Helpdesk_Survey[Fila do Ticket] = "Relacionamento com Cliente", Helpdesk_Survey[Categoria do Ticket] <> "Intenção de Cancelamento" ) )
		formatString: #,0
		displayFolder: Ouvidoria
		lineageTag: 7145b0cf-d928-530c-8df1-d442fe9c4867

	/// Meta de CSAT da Homologação de GUIAS (intranet: CSAT Homologação de Guias, 95). O App não tem meta: a medida fica vazia quando o serviço escolhido é App. Sem serviço escolhido (visão geral) mostra a meta de Guias, que deve ser lida só contra a série de Guias. Meta ÷ 100.
	measure 'Meta CSAT Homologação' = VAR srv = SELECTEDVALUE( Helpdesk_Survey[Serviço Homologação] ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta CSAT Homologação" ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0 && ( ISBLANK( srv ) || srv IN { "Homologação Guias", "Ajuste Guias" } ), DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) )
		formatString: 0.00%
		displayFolder: Homologação
		lineageTag: a094813a-413f-5a18-afdd-dd3a7f762b8b

	/// CSAT só das avaliações feitas até 30 dias depois da resolução do ticket (regra do OKR 2026). Nota média ÷ 10, por data da avaliação.
	measure 'CSAT até 30 Dias da Resolução' = CALCULATE( [CSAT Helpdesk], Helpdesk_Survey[Dias da Resolução à Avaliação] <= 30, NOT ISBLANK( Helpdesk_Survey[Dias da Resolução à Avaliação] ) )
		formatString: 0.00%
		displayFolder: Homologação
		lineageTag: f6f551c7-d5f7-5833-93c4-625a6335503d

	/// CSAT dos serviços de Guias (homologação + ajuste), média de todas as notas. Nota média ÷ 10, por data da avaliação.
	measure 'CSAT Guias' = CALCULATE( [CSAT Helpdesk], KEEPFILTERS( Helpdesk_Survey[Serviço Homologação] IN { "Homologação Guias", "Ajuste Guias" } ) )
		formatString: 0.00%
		displayFolder: Homologação
		lineageTag: af6d961f-bff1-5391-bc6b-a0f5675bf9ca

	/// CSAT dos serviços do App (homologação + ajuste), média de todas as notas. Nota média ÷ 10, por data da avaliação.
	measure 'CSAT App' = CALCULATE( [CSAT Helpdesk], KEEPFILTERS( Helpdesk_Survey[Serviço Homologação] IN { "Homologação App", "Ajuste App" } ) )
		formatString: 0.00%
		displayFolder: Homologação
		lineageTag: 5a092d04-0185-5d77-8d08-827cfbe59d9d

