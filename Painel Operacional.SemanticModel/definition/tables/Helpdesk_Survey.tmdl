	column 'Dias da Resolução à Avaliação' = VAR r = LOOKUPVALUE( Helpdesk_Tickets[Data_Resolucao_Ticket], Helpdesk_Tickets[id], Helpdesk_Survey[ticketId] ) VAR a = Helpdesk_Survey[Data Avaliacao] RETURN IF( ISBLANK( r ) || ISBLANK( a ), BLANK(), IF( r <= a, DATEDIFF( r, a, DAY ), - DATEDIFF( a, r, DAY ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Homologação
		lineageTag: d7a635ca-aa4c-5602-8e2e-d3af26047130
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

