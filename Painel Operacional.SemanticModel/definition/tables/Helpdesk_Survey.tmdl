	column 'Mês da Composição' = ( VAR _d = Helpdesk_Survey[Data Avaliacao] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: 93f4d694-ab0a-5069-8703-c451f647d818
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Helpdesk_Survey = m
		mode: import
		queryGroup: Helpdesk
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Helpdesk_Survey",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id", type text}, {"questionId", type text}, {"type", Int64.Type}, {"clientId", type text}, {"ticketId", Int64.Type}, {"Data Avaliacao", type datetime}, {"value", Int64.Type}, {"data_extracao", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

