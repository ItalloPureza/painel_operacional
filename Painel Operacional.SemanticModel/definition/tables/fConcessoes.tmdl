	column Cliente = LOOKUPVALUE( Helpdesk_Tickets[Empresa], Helpdesk_Tickets[id], fConcessoes[Ticket], BLANK() )
		dataType: string
		displayFolder: Reversão × Concessões
		lineageTag: 35b3ae48-75d3-502c-879b-9a0e207bf03a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ID do Cliente' = LOOKUPVALUE( Helpdesk_Tickets[ID Legado do Cliente], Helpdesk_Tickets[id], fConcessoes[Ticket], BLANK() )
		dataType: string
		displayFolder: Reversão × Concessões
		lineageTag: c28d00c6-98f3-54dd-986f-8c42c36ac18c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Email do Responsável' = VAR n = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( LOWER( TRIM( fConcessoes[Responsável] ) ), "á", "a" ), "à", "a" ), "â", "a" ), "ã", "a" ), "ä", "a" ), "é", "e" ), "è", "e" ), "ê", "e" ), "ë", "e" ), "í", "i" ), "ì", "i" ), "î", "i" ), "ï", "i" ), "ó", "o" ), "ò", "o" ), "ô", "o" ), "õ", "o" ), "ö", "o" ), "ú", "u" ), "ù", "u" ), "û", "u" ), "ü", "u" ), "ç", "c" ), "ñ", "n" ), "  ", " " ) VAR p = SUBSTITUTE( n, " ", "|" ) VAR curto = IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), n ) VAR e1 = IF( n = "", BLANK(), LOOKUPVALUE( dColaborador[email], dColaborador[Nome Normalizado], n, BLANK() ) ) RETURN IF( ISBLANK( e1 ) && n <> "", LOOKUPVALUE( dColaborador[email], dColaborador[Nome Curto Normalizado], curto, BLANK() ), e1 )
		dataType: string
		isHidden
		displayFolder: Reversão × Concessões
		lineageTag: 6afae855-7d52-529e-b1bd-7c5429020d0c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = fConcessoes[Data] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Reversão × Concessões
		lineageTag: bd5172dc-45b9-5fc7-9c77-e250840e55d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do Responsável' = LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], fConcessoes[Email do Responsável], dColaboradorMes[AnoMes], fConcessoes[Mês da Composição], BLANK() )
		dataType: string
		displayFolder: Reversão × Concessões
		lineageTag: a16d5273-115d-565d-a169-c446b304fb46
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Setor = LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], fConcessoes[Email do Responsável], dColaboradorMes[AnoMes], fConcessoes[Mês da Composição], BLANK() )
		dataType: string
		displayFolder: Reversão × Concessões
		lineageTag: b32015bf-3cf0-5f4e-90fe-e94dff142816
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & fConcessoes[ID do Cliente] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: 028e0cb6-f5ea-5d33-8b07-67061dcd0899
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ do Cliente (busca)' = VAR c = LOOKUPVALUE( dBuscaCliente[CNPJ], dBuscaCliente[ID], TRIM( "" & fConcessoes[ID do Cliente] ), BLANK() ) RETURN IF( c = "", BLANK(), c )
		dataType: string
		displayFolder: Cliente
		lineageTag: 45593865-902c-51d5-9baa-a8aecafeebf9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fConcessoes = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="fConcessoes",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Ticket", Int64.Type}, {"Data", type datetime}, {"Área", type text}, {"Responsável", type text}, {"Desconto", type number}, {"Redução", type number}, {"Isenção de Mensalidade", type number}, {"Isenção de Aviso Prévio", type number}})
				in
				    Tipos


	annotation PBI_ResultType = Table

