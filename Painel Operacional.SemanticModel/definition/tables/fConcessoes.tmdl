table fConcessoes
	lineageTag: 9f457f88-1db4-5530-b947-53dfa6ad7874

	/// Soma da mensalidade dos pedidos revertidos, com a regra de [Reversões Atendidas] (tipo 2, serviço Cancelamento, sem ajuste de carteira, sem cancelar no mesmo mês), pela data de FECHAMENTO.
	measure 'MRR Revertido' = CALCULATE( SUM( Helpdesk_Cancelamentos[mensalidade] ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[Serviço] = "Cancelamento", Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ), Helpdesk_Cancelamentos[category] = "Cancelamento Revertido", Helpdesk_Cancelamentos[Cancelou no Mesmo Mês] = "Não" )
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: 5df00350-4673-59cb-8c66-c9c2698a3b34

	/// Descontos + reduções de mensalidade: 1ª camada, o que sai do MRR revertido para dar o saldo.
	measure 'Descontos e Reduções Concedidos' = [Descontos Concedidos] + [Reduções Concedidas]
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: 67aedaa1-5ac6-5109-9167-851c64758f9c

	/// Isenção de mensalidade + isenção de aviso prévio — 2ª camada: sai do saldo para dar o total final (22/10/2026).
	measure 'Isenções Concedidas' = [Isenções de Mensalidade Concedidas] + [Isenções de Aviso Prévio Concedidas]
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: ea8767bb-d038-5062-a045-83ae7fa48080

	/// Soma da isenção de aviso prévio. Tickets de Negociação (categoria) com valor, pelo campo Responsável (resp_reversao, desde 20/07/2026), pela data de FECHAMENTO. Desde 01/08/2026 o POP manda lançar o valor TOTAL da concessão.
	measure 'Isenções de Aviso Prévio Concedidas' = SUM( fConcessoes[Isenção de Aviso Prévio] )
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: 921cdda8-0fd0-594c-9028-789d06a5708f

	/// Soma da isenção de mensalidade. Tickets de Negociação (categoria) com valor, pelo campo Responsável (resp_reversao, desde 20/07/2026), pela data de FECHAMENTO. Desde 01/08/2026 o POP manda lançar o valor TOTAL da concessão.
	measure 'Isenções de Mensalidade Concedidas' = SUM( fConcessoes[Isenção de Mensalidade] )
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: 52120b18-4753-5ef2-829c-e1f285a6ca2d

	/// Soma da redução de mensalidade (recorrente: quanto a mensalidade caiu). Tickets de Negociação (categoria) com valor, pelo campo Responsável (resp_reversao, desde 20/07/2026), pela data de FECHAMENTO. Desde 01/08/2026 o POP manda lançar o valor TOTAL da concessão.
	measure 'Reduções Concedidas' = SUM( fConcessoes[Redução] )
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: 992fe7d8-2f93-5489-9949-0ba71466c157

	/// Soma do desconto de mensalidade. Tickets de Negociação (categoria) com valor, pelo campo Responsável (resp_reversao, desde 20/07/2026), pela data de FECHAMENTO. Desde 01/08/2026 o POP manda lançar o valor TOTAL da concessão.
	measure 'Descontos Concedidos' = SUM( fConcessoes[Desconto] )
		formatString: \R$ #,0.00
		displayFolder: Reversão × Concessões
		lineageTag: 797be1a6-2a68-5810-b866-ef44c635db9c

