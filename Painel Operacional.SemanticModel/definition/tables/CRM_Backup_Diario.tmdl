	column 'Atingiu Critério do TTFV' = VAR c = IFERROR( VALUE( CRM_Backup_Diario[Qtd_CNPJs_Contrato] ), BLANK() ) VAR u = IFERROR( VALUE( CRM_Backup_Diario[Qtd_CNPJs_Usados] ), BLANK() ) RETURN c > 0 && u >= c * 0.3 && CRM_Backup_Diario[Qtd_Total_Entregas] >= c * 0.3
		dataType: boolean
		isHidden
		displayFolder: TTFV
		lineageTag: b9f7269e-305e-5a9a-9518-a4853ed2a22b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '% Entregas pelo eContinuo' = DIVIDE( CRM_Backup_Diario[Qtd_Entrega_eContinuo], CRM_Backup_Diario[Qtd_Prazos_Gerados], 0 ) * 100
		dataType: double
		isHidden
		formatString: 0.00
		displayFolder: Carteira
		lineageTag: b2ef9ad0-59c9-54fb-a179-d8b34f9d150b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ (dígitos)' = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( TRIM( CRM_Backup_Diario[CNPJ] ), ".", "" ), "/", "" ), "-", "" ), " ", "" )
		dataType: string
		isHidden
		displayFolder: Cliente
		lineageTag: eb1cd023-677b-52ef-820d-63b3f8449032
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Só Kappa' = IF( ISERROR( VALUE( CRM_Backup_Diario[ID_Legado] ) ), "Sim", "Não" )
		dataType: string
		displayFolder: Cliente
		lineageTag: e6de9720-f55b-532b-9bc8-bae3f0c9d3a7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Interações em Processos (nº)' = IFERROR( VALUE( CRM_Backup_Diario[Interacoes_Gestao_Processos] ), BLANK() )
