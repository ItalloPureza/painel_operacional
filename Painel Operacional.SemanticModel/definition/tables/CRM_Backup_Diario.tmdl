table CRM_Backup_Diario
	lineageTag: a8b5f9d0-c2c1-4cb2-8763-a42eb4cae202

	/// Média, nos retratos diários do período, do % de entregas feitas (o 'entregas' do sistema legado no OKR 2026). Só ativos/bloqueados (o antigo tirava os cancelados).
	measure '% Entregas Feitas (média)' = DIVIDE( CALCULATE( AVERAGE( CRM_Backup_Diario[Entrega_no_Prazo] ), CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" }, CRM_Backup_Diario[Só Kappa] = "Não" ), 100 )
		formatString: 0.00%
		displayFolder: Carteira
		lineageTag: 444d316b-2741-5caa-9cbe-346d2376b715

	/// Média, nos retratos diários do período, de entregas pelo eContinuo ÷ prazos gerados (o 'eContinuo' do sistema legado no OKR 2026); cliente sem prazo gerado conta 0. Só ativos/bloqueados (o antigo tirava os cancelados).
	measure '% Uso eContinuo (média)' = DIVIDE( CALCULATE( AVERAGE( CRM_Backup_Diario[% Entregas pelo eContinuo] ), CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" }, CRM_Backup_Diario[Só Kappa] = "Não" ), 100 )
		formatString: 0.00%
		displayFolder: Carteira
		lineageTag: 45eca362-7df3-59b9-9bfc-11799cbf7b9c

	/// Média de interações na gestão de processos no retrato mais recente (OKR 2026: 'Interações nos Processos'). FOTO.
	measure 'Interações em Processos (hoje)' = VAR ult = CALCULATE( MAX( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS() ) RETURN CALCULATE( AVERAGE( CRM_Backup_Diario[Interações em Processos (nº)] ), REMOVEFILTERS( Calendario ), CRM_Backup_Diario[Periodo] = ult, CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" }, CRM_Backup_Diario[Só Kappa] = "Não" )
		formatString: #,0.00
		displayFolder: Carteira (Ongoing)
		lineageTag: 83b527b5-653a-5612-ae84-8c33c1a3a344

	/// Média de entregas pelo eContinuo ÷ prazos gerados no retrato mais recente (o 'Uso do Robô' do OKR 2026). FOTO.
	measure '% eContinuo da Carteira (hoje)' = VAR ult = CALCULATE( MAX( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS() ) RETURN CALCULATE( DIVIDE( AVERAGE( CRM_Backup_Diario[% Entregas pelo eContinuo] ), 100 ), REMOVEFILTERS( Calendario ), CRM_Backup_Diario[Periodo] = ult, CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" }, CRM_Backup_Diario[Só Kappa] = "Não" )
		formatString: 0.00%
		displayFolder: Carteira (Ongoing)
		lineageTag: e94bc415-bbf3-5f20-a648-71ddf2123c28

	/// Média do uso geral dos clientes no retrato mais recente (o 'Uso Geral' do sistema legado no OKR 2026). FOTO.
	measure 'Uso Geral da Carteira (hoje)' = VAR ult = CALCULATE( MAX( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS() ) RETURN CALCULATE( AVERAGE( CRM_Backup_Diario[Uso] ), REMOVEFILTERS( Calendario ), CRM_Backup_Diario[Periodo] = ult, CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" }, CRM_Backup_Diario[Só Kappa] = "Não" )
		formatString: 0.00
		displayFolder: Carteira (Ongoing)
		lineageTag: 5d4d84c3-2b3f-5152-8fc0-130533731113

	/// CNPJs distintos com Status KP = Ativo no 1º retrato do mês — no OKR 2026, StatusKC do Histórico Cruzeiro.
	measure 'Clientes Ativos KP (início do mês)' = VAR d = MIN( CRM_Backup_Diario[Periodo] ) RETURN IF( NOT ISBLANK( d ) && DAY( d ) <= 3, CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d, CRM_Backup_Diario[Status KP] = "Ativo" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 75e9a25c-3bd3-59b3-b62b-4804c23c2e56

	/// CNPJs distintos Ativo/Bloqueado/Suspenso (sem os só Kappa) no 1º retrato do mês do CRM (vazio se o 1º retrato for depois do dia 3) — no OKR 2026, Qtd_Ativos_AF do Histórico Cruzeiro.
	measure 'Clientes Ativos AF (início do mês)' = VAR d = MIN( CRM_Backup_Diario[Periodo] ) RETURN IF( NOT ISBLANK( d ) && DAY( d ) <= 3, CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado", "Suspenso" } ), CRM_Backup_Diario[Só Kappa] = "Não" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 4c5e8970-0fc6-5295-a9c8-f75baaff8cea

	/// Mensalidade total no dia (só nos dias com mudança).
	measure 'Histórico - Mensalidade' = VAR a = [Dia Anterior da Carteira] RETURN IF( [Mudou na Carteira] = 1, [Mensalidade Total (Contratos)] )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 181ae1aa-c11a-56e7-8e7f-776d519dd783

	/// Mensalidade total no dia anterior (só nos dias com mudança).
	measure 'Histórico - Mensalidade antes' = VAR a = [Dia Anterior da Carteira] RETURN IF( [Mudou na Carteira] = 1, CALCULATE( [Mensalidade Total (Contratos)], REMOVEFILTERS( Calendario ), Calendario[Date] = a ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 6677f420-c1ef-54cb-a737-ee6ef93911e6

	/// Status de Saúde no dia (só nos dias com mudança).
	measure 'Histórico - Status' = VAR a = [Dia Anterior da Carteira] RETURN IF( [Mudou na Carteira] = 1, COALESCE( [Status de Saúde no Dia], "—" ) )
		displayFolder: Global
		lineageTag: b87778fd-ff9f-5e81-9287-9b599d6a2354

	/// Status de Saúde no dia anterior (só nos dias com mudança).
	measure 'Histórico - Status antes' = VAR a = [Dia Anterior da Carteira] RETURN IF( [Mudou na Carteira] = 1, COALESCE( CALCULATE( [Status de Saúde no Dia], REMOVEFILTERS( Calendario ), Calendario[Date] = a ), "—" ) )
		displayFolder: Global
		lineageTag: a5df2f65-0d88-5857-879b-84554a8f3f32

	/// CS no dia (só nos dias com mudança).
	measure 'Histórico - CS' = VAR a = [Dia Anterior da Carteira] RETURN IF( [Mudou na Carteira] = 1, COALESCE( [CS no Dia], "(fora da carteira)" ) )
		displayFolder: Global
		lineageTag: 14dbc357-9f27-53b1-a948-8b97f447cf58

	/// CS no dia anterior (só nos dias com mudança).
	measure 'Histórico - CS antes' = VAR a = [Dia Anterior da Carteira] RETURN IF( [Mudou na Carteira] = 1, COALESCE( CALCULATE( [CS no Dia], REMOVEFILTERS( Calendario ), Calendario[Date] = a ), "—" ) )
		displayFolder: Global
		lineageTag: ac1fdd07-70c1-5e05-a2fe-a10767fdd926

	/// 1 no dia em que o cliente (um só) entrou, saiu ou mudou de CS, status de saúde ou mensalidade total.
	measure 'Mudou na Carteira' = VAR d = [Dia da Carteira] VAR a = [Dia Anterior da Carteira] VAR cs = [CS no Dia] VAR st = [Status de Saúde no Dia] VAR v = [Mensalidade Total (Contratos)] VAR cs0 = CALCULATE( [CS no Dia], REMOVEFILTERS( Calendario ), Calendario[Date] = a ) VAR st0 = CALCULATE( [Status de Saúde no Dia], REMOVEFILTERS( Calendario ), Calendario[Date] = a ) VAR v0 = CALCULATE( [Mensalidade Total (Contratos)], REMOVEFILTERS( Calendario ), Calendario[Date] = a ) RETURN IF( HASONEVALUE( CRM_Backup_Diario[ID_Legado] ) && NOT ISBLANK( d ) && NOT ( ISBLANK( cs ) && ISBLANK( cs0 ) && ISBLANK( v ) && ISBLANK( v0 ) ) && ( ISBLANK( a ) || NOT ( cs == cs0 ) || NOT ( st == st0 ) || NOT ( v == v0 ) ), 1 )
		formatString: 0
		displayFolder: Global
		lineageTag: 6110acb7-e199-5249-896a-2212f588269f

	/// Status de Saúde do cliente no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Status de Saúde no Dia' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ) && HASONEVALUE( CRM_Backup_Diario[ID_Legado] ), CALCULATE( MAX( CRM_Backup_Diario[Status de Saúde] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) )
		displayFolder: Global
		lineageTag: f0e1b0f8-35af-531a-8c02-0356ae520203

	/// Responsável (CS) do cliente no dia da carteira (último dia do período com retrato do CRM e Contratos); vazio fora da carteira.
	measure 'CS no Dia' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ) && HASONEVALUE( CRM_Backup_Diario[ID_Legado] ), CALCULATE( MAX( CRM_Backup_Diario[Responsavel] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) )
		displayFolder: Global
		lineageTag: da7bdbc1-52a2-5a4f-b31f-3611e13756bf

	/// Clientes na carteira com status de saúde = Cruzeiro no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes do Legado (no dia)' = CALCULATE( [Clientes na Carteira (no dia)], KEEPFILTERS( CRM_Backup_Diario[Status de Saúde] = "Cruzeiro" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 8c25038f-e177-50af-8c6c-723dc6ccaf83

	/// Clientes na carteira com status de saúde = En Route no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes En Route (no dia)' = CALCULATE( [Clientes na Carteira (no dia)], KEEPFILTERS( CRM_Backup_Diario[Status de Saúde] = "En Route" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: cd7ca0bf-6fe1-5d45-927f-65b8e23925a4

	/// Clientes na carteira com status de saúde = Alert no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes Alert (no dia)' = CALCULATE( [Clientes na Carteira (no dia)], KEEPFILTERS( CRM_Backup_Diario[Status de Saúde] = "Alert" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 9225b679-21eb-5a54-a8fe-e7c90af218c3

	/// Clientes na carteira com status de saúde = Mayday no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes Mayday (no dia)' = CALCULATE( [Clientes na Carteira (no dia)], KEEPFILTERS( CRM_Backup_Diario[Status de Saúde] = "Mayday" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: ad1133fb-9638-5036-a6a5-b3079058ced5

	/// CNPJs distintos com Status KP = Ativo no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes KP (no dia)' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ), CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status KP] = "Ativo" ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: ce120c77-755c-5e88-a8de-86a430b5164e

	/// CNPJs distintos Bloqueados (sem os só Kappa) no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes Bloqueados (no dia)' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ), CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] = "Bloqueado" ), CRM_Backup_Diario[Só Kappa] = "Não" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 3973edbe-a028-53c4-8abb-080d09e71950

	/// CNPJs distintos Ativo/Bloqueado, com os só Kappa, no dia da carteira (último dia do período com retrato do CRM e Contratos) (base da conferência com o sistema de contratos).
	measure 'Clientes Ativos (no dia)' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ), CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 649d0b56-d629-57da-aa68-7e8b2e74a92d

	/// CNPJs distintos Ativo/Bloqueado (sem os só Kappa) no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes na Carteira (no dia)' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ), CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ), CRM_Backup_Diario[Só Kappa] = "Não" ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 5ef3a2ca-fc8c-5191-8b14-f0f230719078

	/// Dia com retrato e Contratos imediatamente anterior ao dia da carteira (histórico de um cliente).
	measure 'Dia Anterior da Carteira' = VAR d = [Dia da Carteira] RETURN IF( NOT ISBLANK( d ), CALCULATE( MAX( Calendario[Date] ), REMOVEFILTERS( Calendario ), Calendario[Date] < d, Calendario[Carteira no Dia] = 1 ) )
		formatString: dd/mm/yy
		displayFolder: Global
		lineageTag: bd17f981-7656-57b0-9230-aba741e2fb20

	/// Último dia do período com retrato do CRM E Contratos: todas as contas das Carteiras usam esse dia.
	measure 'Dia da Carteira' = CALCULATE( MAX( Calendario[Date] ), KEEPFILTERS( Calendario[Carteira no Dia] = 1 ) )
		formatString: dd/mm/yy
		displayFolder: Global
		lineageTag: 08670d7f-4eaf-5d96-a709-5c31a4a89f8a

