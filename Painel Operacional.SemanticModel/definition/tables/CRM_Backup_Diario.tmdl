		dataType: string
		lineageTag: 7442ec5a-3ff8-53b1-946a-a30be63b6c3c
		summarizeBy: none
		sourceColumn: custom_fields_tipo_de_produto

		annotation SummarizationSetBy = Automatic

	column 'Status KP' = IF( ISBLANK( CRM_Backup_Diario[Produtos] ) || CRM_Backup_Diario[Produtos] = "", BLANK(), IF( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado", "Suspenso" } && CONTAINSSTRING( CRM_Backup_Diario[Produtos], "Kappa" ), "Ativo", "Inativo" ) )
		dataType: string
		displayFolder: Global
		lineageTag: be2728d7-23db-5e5f-be9a-9743cf5f7486
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Setor do CS' = LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], CRM_Backup_Diario[Responsavel_Email], dColaboradorMes[AnoMes], CRM_Backup_Diario[Mês da Composição], BLANK() )
		dataType: string
		displayFolder: Global
		lineageTag: 00f448b9-08e5-5d00-9e33-ab15f83e623f
