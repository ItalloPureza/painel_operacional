	partition Contratos_historico_fones = m
		mode: import
		queryGroup: Contratos
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Contratos_historico_fones",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"periodo", type datetime}, {"contrato_id", Int64.Type}, {"id", Int64.Type}, {"fone", type text}, {"ativo", Int64.Type}, {"created_at", type datetime}, {"updated_at", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

