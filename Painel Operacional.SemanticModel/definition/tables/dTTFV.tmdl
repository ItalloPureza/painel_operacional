table dTTFV
	lineageTag: 07b575de-b8b5-5575-8fee-94e83fbf6811

	/// Atingidos ÷ clientes registrados desde o 1º retrato (FOTO: não muda com o período) — 'TTFV Percentual' do OKR 2026. Na tela de Migrações segue Equipe e Responsável (equipe e e-mail do CS); com Categoria escolhida fica vazia (o TTFV não tem categoria).
	measure '% TTFV Atingido' = VAR fe = ISFILTERED( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR eqs = FILTERS( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR fr = ISFILTERED( CRM_Atividades[Responsavel_Pelo_Cliente] ) VAR ems = CALCULATETABLE( VALUES( CRM_Atividades[Email do Responsável pelo Cliente] ), REMOVEFILTERS( Calendario ) ) RETURN IF( NOT ISFILTERED( CRM_Atividades[Categoria] ), CALCULATE( DIVIDE( CALCULATE( COUNTROWS( dTTFV ), dTTFV[TTFV] = "Atingido", REMOVEFILTERS( Calendario ) ), CALCULATE( COUNTROWS( dTTFV ), REMOVEFILTERS( Calendario ) ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Equipe do CS] ), NOT fe || dTTFV[Equipe do CS] IN eqs ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Email do CS] ), NOT fr || dTTFV[Email do CS] IN ems ) ) ) )
		formatString: 0.00%
		displayFolder: TTFV
		lineageTag: 8e7cd9ab-98f3-56e9-84a8-9d0380156033

	/// Média de dias entre o registro e o TTFV, dos que atingiram no período. Na tela de Migrações segue Equipe e Responsável (equipe e e-mail do CS); com Categoria escolhida fica vazia (o TTFV não tem categoria).
	measure 'Dias até o TTFV (média)' = VAR fe = ISFILTERED( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR eqs = FILTERS( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR fr = ISFILTERED( CRM_Atividades[Responsavel_Pelo_Cliente] ) VAR ems = CALCULATETABLE( VALUES( CRM_Atividades[Email do Responsável pelo Cliente] ), REMOVEFILTERS( Calendario ) ) RETURN IF( NOT ISFILTERED( CRM_Atividades[Categoria] ), CALCULATE( AVERAGE( dTTFV[Dias até o TTFV] ), KEEPFILTERS( FILTER( ALL( dTTFV[Equipe do CS] ), NOT fe || dTTFV[Equipe do CS] IN eqs ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Email do CS] ), NOT fr || dTTFV[Email do CS] IN ems ) ) ) )
		formatString: 0.00
		displayFolder: TTFV
		lineageTag: 50e3a956-d8a0-5ab1-9635-4d8ad44153ee

	/// Clientes que atingiram o TTFV no período (data em que atingiram). Na tela de Migrações segue Equipe e Responsável (equipe e e-mail do CS); com Categoria escolhida fica vazia (o TTFV não tem categoria).
	measure 'Clientes que Atingiram o TTFV' = VAR fe = ISFILTERED( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR eqs = FILTERS( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR fr = ISFILTERED( CRM_Atividades[Responsavel_Pelo_Cliente] ) VAR ems = CALCULATETABLE( VALUES( CRM_Atividades[Email do Responsável pelo Cliente] ), REMOVEFILTERS( Calendario ) ) RETURN IF( NOT ISFILTERED( CRM_Atividades[Categoria] ), CALCULATE( CALCULATE( COUNTROWS( dTTFV ), NOT ISBLANK( dTTFV[Data do TTFV] ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Equipe do CS] ), NOT fe || dTTFV[Equipe do CS] IN eqs ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Email do CS] ), NOT fr || dTTFV[Email do CS] IN ems ) ) ) )
		formatString: #,0
		displayFolder: TTFV
		lineageTag: 29ee501c-d2a7-529f-a8fc-e067a156ffb2

	/// Clientes registrados desde 14/07/2026 (1º retrato diário do CRM): a base do TTFV (foto de hoje). Na tela de Migrações segue Equipe e Responsável (equipe e e-mail do CS); com Categoria escolhida fica vazia (o TTFV não tem categoria).
	measure 'Clientes na Base do TTFV' = VAR fe = ISFILTERED( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR eqs = FILTERS( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR fr = ISFILTERED( CRM_Atividades[Responsavel_Pelo_Cliente] ) VAR ems = CALCULATETABLE( VALUES( CRM_Atividades[Email do Responsável pelo Cliente] ), REMOVEFILTERS( Calendario ) ) RETURN IF( NOT ISFILTERED( CRM_Atividades[Categoria] ), CALCULATE( CALCULATE( COUNTROWS( dTTFV ), REMOVEFILTERS( Calendario ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Equipe do CS] ), NOT fe || dTTFV[Equipe do CS] IN eqs ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Email do CS] ), NOT fr || dTTFV[Email do CS] IN ems ) ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 816a2968-0da4-5ac5-9fa9-de49a09aff01

	/// Clientes registrados desde 14/07/2026 que ainda não atingiram o TTFV (foto de hoje; não segue o Período). Na tela de Migrações segue Equipe e Responsável (equipe e e-mail do CS); com Categoria escolhida fica vazia (o TTFV não tem categoria).
	measure 'Clientes sem TTFV (hoje)' = VAR fe = ISFILTERED( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR eqs = FILTERS( CRM_Atividades[Equipe do Responsável pelo Cliente] ) VAR fr = ISFILTERED( CRM_Atividades[Responsavel_Pelo_Cliente] ) VAR ems = CALCULATETABLE( VALUES( CRM_Atividades[Email do Responsável pelo Cliente] ), REMOVEFILTERS( Calendario ) ) RETURN IF( NOT ISFILTERED( CRM_Atividades[Categoria] ), CALCULATE( CALCULATE( COUNTROWS( dTTFV ), dTTFV[TTFV] = "Não atingido", REMOVEFILTERS( Calendario ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Equipe do CS] ), NOT fe || dTTFV[Equipe do CS] IN eqs ) ), KEEPFILTERS( FILTER( ALL( dTTFV[Email do CS] ), NOT fr || dTTFV[Email do CS] IN ems ) ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 56f9c4bf-f05a-5b5f-a103-7f296a5147d4

