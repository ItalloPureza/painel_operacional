		annotation SummarizationSetBy = Automatic

	column 'Tipo de Entrada'
		lineageTag: 9d188b96-12cf-512d-b80c-64dd86aeceb3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tipo de Entrada]

		annotation SummarizationSetBy = Automatic

	partition dTTFV = calculated
		mode: import
		source =
				
				-- TTFV por ENTRADA do cliente (regra do OKR 2026 + M15 de 20/10/2026): 1º retrato diário, a partir da Data Registro
				-- da entrada, em que empresas usadas e entregas feitas >= 30% das empresas do contrato. Só entradas registradas desde o 1º retrato (14/07/2026).
				-- Entrada nova = 1ª data do cliente ou data nova depois de Inativo/Teste desde a data anterior (reativação / teste convertido); senão é correção de cadastro.
				-- CS/setor = do retrato do dia do TTFV (ou o mais recente da entrada, se ainda não atingiu). Gerado por gerar_onboarding.py.
				VAR ini = MIN( CRM_Backup_Diario[Periodo] )
				VAR cand = CALCULATETABLE( VALUES( CRM_Backup_Diario[Id_CRM] ), CRM_Backup_Diario[Dt_Cadastro] >= ini, CRM_Backup_Diario[Só Kappa] = "Não" )
				VAR pares = CALCULATETABLE( SUMMARIZE( CRM_Backup_Diario, CRM_Backup_Diario[Id_CRM], CRM_Backup_Diario[Dt_Cadastro] ), TREATAS( cand, CRM_Backup_Diario[Id_CRM] ), NOT ISBLANK( CRM_Backup_Diario[Dt_Cadastro] ) )
				VAR p1 =
				    ADDCOLUMNS(
				        pares,
				        "@desde", VAR i = CRM_Backup_Diario[Id_CRM] VAR r = CRM_Backup_Diario[Dt_Cadastro]
				            RETURN CALCULATE( MIN( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Dt_Cadastro] = r )
				    )
				VAR p2 =
				    ADDCOLUMNS(
				        p1,
				        "@anterior", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@desde]
				            RETURN MAXX( FILTER( p1, CRM_Backup_Diario[Id_CRM] = i && [@desde] < d ), [@desde] )
				    )
				VAR p3 =
				    ADDCOLUMNS(
				        p2,
				        "@saiu", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@desde] VAR a = [@anterior]
				            RETURN IF( ISBLANK( a ), BLANK(), CALCULATE( MAX( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] >= a, CRM_Backup_Diario[Periodo] < d, CRM_Backup_Diario[Status_Office] IN { "Inativo", "Teste" } ) )
				    )
				VAR p4 =
				    ADDCOLUMNS(
				        p3,
				        "@statusAntes", VAR i = CRM_Backup_Diario[Id_CRM] VAR u = [@saiu]
				            RETURN IF( ISBLANK( u ), BLANK(), CALCULATE( MAX( CRM_Backup_Diario[Status_Office] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] = u, CRM_Backup_Diario[Status_Office] IN { "Inativo", "Teste" } ) )
				    )
				VAR entradas = FILTER( p4, ISBLANK( [@anterior] ) || NOT ISBLANK( [@saiu] ) )
				VAR e1 =
				    ADDCOLUMNS(
				        entradas,
				        "@prox", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@desde]
				            RETURN MINX( FILTER( entradas, CRM_Backup_Diario[Id_CRM] = i && [@desde] > d ), [@desde] ),
				        "@n", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@desde]
				            RETURN COUNTROWS( FILTER( entradas, CRM_Backup_Diario[Id_CRM] = i && [@desde] <= d ) )
				    )
				VAR base = FILTER( e1, CRM_Backup_Diario[Dt_Cadastro] >= ini )
				VAR t =
				    ADDCOLUMNS(
				        base,
				        "@registro", CRM_Backup_Diario[Dt_Cadastro],
				        "@ultimo", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@desde] VAR f = COALESCE( [@prox], DATE( 9999, 12, 31 ) )
				            RETURN CALCULATE( MAX( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] >= d, CRM_Backup_Diario[Periodo] < f )
				    )
				VAR t2 =
				    ADDCOLUMNS(
				        t,
				        "@ttfv", VAR i = CRM_Backup_Diario[Id_CRM] VAR r = [@registro] VAR f = COALESCE( [@prox], DATE( 9999, 12, 31 ) )
				            RETURN CALCULATE( MIN( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Atingiu Critério do TTFV] = TRUE(), CRM_Backup_Diario[Periodo] >= r, CRM_Backup_Diario[Periodo] < f )
				    )
				VAR t3 = ADDCOLUMNS( t2, "@retrato", COALESCE( [@ttfv], [@ultimo] ) )
				VAR t4 =
				    ADDCOLUMNS(
				        t3,
				        "@cliente", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@retrato] RETURN CALCULATE( MAX( CRM_Backup_Diario[Nome_Fantasia] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] = d ),
				        "@legado", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@retrato] RETURN CALCULATE( MAX( CRM_Backup_Diario[ID_Legado] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] = d ),
				        "@cs", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@retrato] RETURN CALCULATE( MAX( CRM_Backup_Diario[Responsavel] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] = d ),
				        "@email", VAR i = CRM_Backup_Diario[Id_CRM] VAR d = [@retrato] RETURN CALCULATE( MAX( CRM_Backup_Diario[Responsavel_Email] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Id_CRM] = i, CRM_Backup_Diario[Periodo] = d )
				    )
				RETURN
				    SELECTCOLUMNS(
				        t4,
				        "ID CRM", CRM_Backup_Diario[Id_CRM],
				        "Data de Registro", [@registro],
				        "Último Retrato", [@ultimo],
				        "Data do TTFV", [@ttfv],
				        "Retrato do CS", [@retrato],
				        "Cliente", [@cliente],
				        "ID Legado", [@legado],
				        "CS", [@cs],
				        "Email do CS", [@email],
				        "Equipe do CS", IF( ISBLANK( [@email] ), IF( TRIM( [@cs] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], [@email], dColaboradorMes[AnoMes], ( VAR _d = [@retrato] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) ), BLANK() ), "(sem equipe)" ) ),
				        "Setor do CS", LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], [@email], dColaboradorMes[AnoMes], ( VAR _d = [@retrato] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) ), BLANK() ),
				        "TTFV", IF( ISBLANK( [@ttfv] ), "Não atingido", "Atingido" ),
				        "Dias até o TTFV", IF( ISBLANK( [@ttfv] ), BLANK(), INT( [@ttfv] - [@registro] ) ),
				        "Entrada", [@n],
				        "Tipo de Entrada", SWITCH( TRUE(), ISBLANK( [@anterior] ), "Primeira", [@statusAntes] = "Teste", "Teste convertido", "Reativação" )
				    )

