	column 'CNPJ do Cliente (busca)' = VAR c = LOOKUPVALUE( dBuscaCliente[CNPJ], dBuscaCliente[ID], TRIM( "" & dTTFV[ID Legado] ), BLANK() ) RETURN IF( c = "", BLANK(), c )
