table WhatsApp_Atendimentos
	lineageTag: 1fcbb2e2-217f-5a04-808e-d18ea2d693dd

	measure Atendimentos = COUNTROWS( WhatsApp_Atendimentos )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: 641dacee-51ba-5585-91f5-643fa03928ea

	measure 'Clientes Atendidos' = DISTINCTCOUNT( WhatsApp_Atendimentos[cliente_identity] )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: 4e6696aa-9bc7-584a-bb52-1fa72b1cca69

	measure '% Receptivos' = DIVIDE( CALCULATE( [Atendimentos], WhatsApp_Atendimentos[Tipo] = "Receptivo" ), [Atendimentos] )
		formatString: 0.00%
		displayFolder: WhatsApp
		lineageTag: 03e98211-774a-5d45-a67e-808cfbe871d6

	measure '% Encerrados por Inatividade' = DIVIDE( CALCULATE( [Atendimentos], WhatsApp_Atendimentos[Status] = "Encerrado por inatividade" ), [Atendimentos] )
		formatString: 0.00%
		displayFolder: WhatsApp
		lineageTag: af686f11-ca41-5c14-b1ca-a69f2ea9d617

	measure 'Duração Mediana (h)' = MEDIAN( WhatsApp_Atendimentos[Duração (h)] )
		displayFolder: WhatsApp
		lineageTag: c74fd374-90d1-5b7a-a410-e68806754db5

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 3600, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Mensagens dos analistas nos atendimentos ÷ dias com atendimento no filtro (disparos à parte).
	measure 'Mensagens do Time por Dia' = DIVIDE( [Mensagens do Time], [Dias com Atendimento] )
		formatString: #,0.00
		displayFolder: Volumetria
		lineageTag: 06624574-808a-5d27-9412-aaae52d2a2a9

	/// Mensagens dos clientes ÷ pares cliente × dia: quantas mensagens um cliente manda, em média, no dia em que fala.
	measure 'Mensagens por Cliente-Dia' = DIVIDE( [Mensagens do Cliente], [Clientes-Dia] )
		formatString: #,0.00
		displayFolder: Volumetria
		lineageTag: 98d42d31-704a-5bac-afb0-5b0bd1cdfb07

	/// Mensagens dos clientes ÷ dias com atendimento no filtro.
	measure 'Mensagens do Cliente por Dia' = DIVIDE( [Mensagens do Cliente], [Dias com Atendimento] )
		formatString: #,0.00
		displayFolder: Volumetria
		lineageTag: 7130f20a-751a-5247-8a99-58171e67e45a

	/// Pares cliente × dia com atendimento: divisor da média por cliente.
	measure Clientes-Dia = COUNTROWS( SUMMARIZE( WhatsApp_Atendimentos, WhatsApp_Atendimentos[cliente_identity], WhatsApp_Atendimentos[Data] ) )
		formatString: #,0
		displayFolder: Volumetria
		lineageTag: 42889c2c-35c4-5383-a739-3c56dd6e2838

	/// Dias com pelo menos um atendimento no filtro (setor, equipe, analista, período): divisor das médias por dia.
	measure 'Dias com Atendimento' = DISTINCTCOUNT( WhatsApp_Atendimentos[Data] )
		formatString: #,0
		displayFolder: Volumetria
		lineageTag: d028b354-deef-5bc2-bd05-d954c7e2a92b

	/// Mensagens que os analistas mandaram nos atendimentos (sem as automáticas e sem os disparos), pela abertura.
	measure 'Mensagens do Time' = SUM( WhatsApp_Atendimentos[Msgs do Time] )
		formatString: #,0
		displayFolder: Volumetria
		lineageTag: f4b5a4f5-a6e4-5c2a-96fe-f641c2a6dc4e

	/// Mensagens que os clientes mandaram nos atendimentos (contagem do WhatsApp por ticket), pela data de abertura.
	measure 'Mensagens do Cliente' = SUM( WhatsApp_Atendimentos[Msgs do Cliente] )
		formatString: #,0
		displayFolder: Volumetria
		lineageTag: 11afe2e2-7a9a-5a64-9f66-fc3a1b75135e

