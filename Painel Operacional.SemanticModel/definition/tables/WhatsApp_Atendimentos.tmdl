		summarizeBy: none
		sourceColumn: Extracao

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = WhatsApp_Atendimentos[Data] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: 84ac3c61-2dc4-5e79-9bd6-3159f9c2a72b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Chave Pessoa Mês' = IF( TRIM( WhatsApp_Atendimentos[agente_email] ) <> "", LOWER( TRIM( WhatsApp_Atendimentos[agente_email] ) ) & "|" & WhatsApp_Atendimentos[Mês da Composição] )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: 94fb6707-827b-5809-a367-acc28f63faa8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

