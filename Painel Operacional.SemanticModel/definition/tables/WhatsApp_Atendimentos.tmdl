	partition WhatsApp_Atendimentos = m
		mode: import
		queryGroup: WhatsApp
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="WhatsApp_Atendimentos",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"conversa_id", type text}, {"ticket_whatsapp_id", type text}, {"Ticket", Int64.Type}, {"cliente_identity", type text}, {"Cliente", type text}, {"Template", type text}, {"Tipo", type text}, {"campaign_id", type text}, {"Assunto", type text}, {"Fila WhatsApp", type text}, {"Abertura", type datetime}, {"Encerramento", type datetime}, {"Data", type datetime}, {"agente_email", type text}, {"Status", type text}, {"Duração (h)", type number}, {"Extracao", type datetime}, {"Msgs do Cliente", Int64.Type}, {"Msgs do Time", Int64.Type}})
				in
				    Tipos


	annotation PBI_ResultType = Table

