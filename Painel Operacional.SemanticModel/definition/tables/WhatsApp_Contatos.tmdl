table WhatsApp_Contatos
	lineageTag: 2c69e326-6409-5585-8984-1e400246ba72

	measure 'Contatos na Carteira' = COUNTROWS( WhatsApp_Contatos )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: c31a9f0e-d70b-57d4-afe3-1d6483d65671

	measure 'Carteira sem Mensagem 30d' = VAR ref = CALCULATE( MAX( WhatsApp_Contatos[Extracao] ), REMOVEFILTERS( WhatsApp_Contatos ) ) RETURN CALCULATE( COUNTROWS( WhatsApp_Contatos ), WhatsApp_Contatos[Última mensagem] < ref - 30 )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: fc3307f9-89a9-55b7-ab2c-b8dd8c28d360

