		summarizeBy: none
		sourceColumn: Extracao

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = BLANK() VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: 0a2a41ad-a624-5328-ad99-cc61894de510
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Chave Pessoa Mês' = IF( TRIM( WhatsApp_Contatos[email_atendente] ) <> "", LOWER( TRIM( WhatsApp_Contatos[email_atendente] ) ) & "|" & WhatsApp_Contatos[Mês da Composição] )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: a3d6cf5a-f488-55ed-94d9-2b4a0761d9d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition WhatsApp_Contatos = m
		mode: import
		queryGroup: WhatsApp
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="WhatsApp_Contatos",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"identity", type text}, {"Contato", type text}, {"Grupo", type text}, {"Cidade", type text}, {"Fila", type text}, {"Fonte", type text}, {"Ativo", type text}, {"email_atendente", type text}, {"Atendente (WhatsApp)", type text}, {"Última mensagem", type datetime}, {"Extracao", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

