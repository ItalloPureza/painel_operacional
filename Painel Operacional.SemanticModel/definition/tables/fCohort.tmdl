table fCohort
	lineageTag: 11bb3cb2-9697-5c37-a129-c515e4dc5327

	/// Cohort × mês de vida: quantos saíram naquele mês de vida (não acumulado).
	measure 'Saídas no Mês de Vida' = VAR m = SELECTEDVALUE( dMesDeVida[Nº do Mês] ) VAR n = COUNTROWS( fCohort ) RETURN IF( NOT ISBLANK( m ) && n > 0 && HASONEVALUE( fCohort[Mês de Entrada] ) && DATEDIFF( MIN( fCohort[Mês de Entrada] ), MAX( fCohort[Data Base] ), MONTH ) + 1 >= m, COUNTROWS( FILTER( fCohort, fCohort[Mês de Vida da Saída] = m ) ) + 0 )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: 295db79d-82ff-529a-9380-ef2dae08db62

	/// Cohort (linha) × mês de vida (coluna): % dos que entraram que não saíram até o fim daquele mês de vida. Vazio se o cohort ainda não chegou nesse mês (o mês atual conta, como no painel antigo).
	measure '% Retenção no Mês de Vida' = VAR m = SELECTEDVALUE( dMesDeVida[Nº do Mês] ) VAR n = COUNTROWS( fCohort ) VAR saiu = COUNTROWS( FILTER( fCohort, NOT ISBLANK( fCohort[Mês de Vida da Saída] ) && fCohort[Mês de Vida da Saída] <= m ) ) RETURN IF( NOT ISBLANK( m ) && n > 0 && HASONEVALUE( fCohort[Mês de Entrada] ) && DATEDIFF( MIN( fCohort[Mês de Entrada] ), MAX( fCohort[Data Base] ), MONTH ) + 1 >= m, 1 - DIVIDE( saiu, n ) )
		formatString: 0.00%
		displayFolder: Gerência
		lineageTag: e9c1b7ad-eda8-53c5-922e-667b7bf67405

	/// Média de dias entre a entrada e a saída, de quem saiu.
	measure 'Dias até Sair (média)' = AVERAGE( fCohort[Dias até Sair] )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: f1cdad3c-a8dd-5df0-8183-fb6a3dfaed9d

	/// Ainda ativos ÷ entraram (hoje, sem olhar o mês de vida).
	measure '% Retenção' = DIVIDE( [Clientes Ainda Ativos], [Clientes que Entraram] )
		formatString: 0.00%
		displayFolder: Gerência
		lineageTag: 007d8946-05a5-59bf-9571-5431094f0633

	/// Dos que entraram, quantos estão ativos no retrato mais recente do CRM.
	measure 'Clientes Ainda Ativos' = CALCULATE( COUNTROWS( fCohort ), KEEPFILTERS( fCohort[Situação] = "Ativo" ) )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: a4fb9f33-1550-5fd2-8be7-b7d868e96a82

	/// Dos que entraram, quantos não estão ativos no retrato mais recente do CRM.
	measure 'Clientes que Saíram' = CALCULATE( COUNTROWS( fCohort ), KEEPFILTERS( fCohort[Situação] = "Saiu" ) )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: d55d6617-3656-514e-aa0a-ea9f0cf51e86

	/// Clientes que entraram no período (data de entrada).
	measure 'Clientes que Entraram' = COUNTROWS( fCohort )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: e0de4909-2a42-56a1-becf-120cb6b87de8

	/// Cohort × mês de vida: mensalidade (Contratos no último dia ativo) de quem saiu naquele mês de vida, em milhares (21.243,25 = 21k; pedido do gestor, 14/10/2026).
	measure 'R$ Saídas no Mês de Vida' = VAR m = SELECTEDVALUE( dMesDeVida[Nº do Mês] ) VAR n = COUNTROWS( fCohort ) RETURN IF( NOT ISBLANK( m ) && n > 0 && HASONEVALUE( fCohort[Mês de Entrada] ) && DATEDIFF( MIN( fCohort[Mês de Entrada] ), MAX( fCohort[Data Base] ), MONTH ) + 1 >= m, DIVIDE( SUMX( FILTER( fCohort, fCohort[Mês de Vida da Saída] = m ), fCohort[Mensalidade na Saída] ) + 0, 1000 ) )
		formatString: \R$ #,0"k"
		displayFolder: Gerência
		lineageTag: 18ff1f48-9e18-5c45-a319-8f2f9dd2acb8

