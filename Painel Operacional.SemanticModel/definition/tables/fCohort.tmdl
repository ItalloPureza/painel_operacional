	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & fCohort[ID] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: ec1dc27f-4cf8-5e19-a3bf-72ce43e6bcdf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ do Cliente (busca)' = VAR c = LOOKUPVALUE( dBuscaCliente[CNPJ], dBuscaCliente[ID], TRIM( "" & fCohort[ID] ), BLANK() ) RETURN IF( c = "", BLANK(), c )
		dataType: string
		displayFolder: Cliente
		lineageTag: 3402bf4c-5b0b-5215-a2be-f00b8de10497
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fCohort = calculated
		mode: import
		source =
				
				-- Períodos que começaram desde ago/2026 (fPeriodos): cada entrada, nova ou retorno, é uma linha do cohort.
				-- Calculada no refresh, fora do RLS. Gerado por gerar_gerencia.py.
				SELECTCOLUMNS( FILTER( fPeriodos, fPeriodos[Entrada] >= DATE( 2026, 8, 1 ) ),
				    "Produto", fPeriodos[Produto],
				    "Tipo de Entrada", fPeriodos[Tipo de Entrada],
				    "ID CRM", fPeriodos[ID CRM],
				    "ID", fPeriodos[ID],
				    "Cliente", fPeriodos[Cliente],
				    "CS", fPeriodos[CS],
				    "Equipe do CS", fPeriodos[Equipe do CS],
				    "Entrada", fPeriodos[Entrada],
				    "Mês de Entrada", DATE( YEAR( fPeriodos[Entrada] ), MONTH( fPeriodos[Entrada] ), 1 ),
				    "Saída", fPeriodos[Saída],
				    "Mês de Vida da Saída", IF( NOT ISBLANK( fPeriodos[Saída] ), DATEDIFF( fPeriodos[Entrada], fPeriodos[Saída], MONTH ) + 1 ),
				    "Dias até Sair", IF( NOT ISBLANK( fPeriodos[Saída] ), DATEDIFF( fPeriodos[Entrada], fPeriodos[Saída], DAY ) ),
				    "Mensalidade na Saída", IF( NOT ISBLANK( fPeriodos[Saída] ), VAR cn = fPeriodos[CNPJ] VAR d = fPeriodos[Último Dia Ativo] VAR d2 = CALCULATE( MAX( Contratos_historico_contratos[periodo] ), REMOVEFILTERS( fPeriodos ), Contratos_historico_contratos[cnpj_cpf] = cn, Contratos_historico_contratos[periodo] <= d ) RETURN IF( NOT ISBLANK( d2 ) && cn <> "", IF( fPeriodos[Produto] = "AF", CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), REMOVEFILTERS( fPeriodos ), Contratos_historico_contratos[periodo] = d2, Contratos_historico_contratos[cnpj_cpf] = cn, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), Contratos_historico_items[item_catalogo_id] IN { 2, 3, 4, 6 } ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), REMOVEFILTERS( fPeriodos ), Contratos_historico_contratos[periodo] = d2, Contratos_historico_contratos[cnpj_cpf] = cn, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), Contratos_historico_items[item_catalogo_id] IN { 5 } ) ) ) ),
				    "Situação", fPeriodos[Situação],
				    "Data Base", fPeriodos[Data Base] )

