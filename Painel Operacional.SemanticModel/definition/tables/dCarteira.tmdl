	column 'Faixa sem Tratativa' = SWITCH( dCarteira[Faixa sem Tratativa Ordem], 1, "Até 15 dias", 2, "16 a 30 dias", 3, "31 a 45 dias", 4, "46 a 90 dias", 5, "Mais de 90 dias", "Sem tratativa" )
		dataType: string
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: 7852ff43-0961-5ed5-8508-d401a527ff3b
		summarizeBy: none
		sortByColumn: 'Faixa sem Tratativa Ordem'

		annotation SummarizationSetBy = Automatic

	column 'Última Tentativa de Contato' = VAR f = dCarteira[ID Legado] VAR i = IF( f <> "", CALCULATE( MAX( Helpdesk_Tickets[id] ), Helpdesk_Tickets[ID Legado do Cliente] = f, FILTER( VALUES( Helpdesk_Tickets[category] ), CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tentativa de contato" ) ) ) ) RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[Data_Criacao_Ticket], Helpdesk_Tickets[id], i ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: 07504009-2e0d-566a-a48b-d47c23bced95
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ordem da Faixa de Idade' = SWITCH( TRUE(), ISBLANK( dCarteira[Dias desde o Registro] ), BLANK(), dCarteira[Dias desde o Registro] <= 90, 1, dCarteira[Dias desde o Registro] <= 180, 2, dCarteira[Dias desde o Registro] <= 365, 3, dCarteira[Dias desde o Registro] <= 730, 4, dCarteira[Dias desde o Registro] <= 1095, 5, 6 )
		dataType: int64
		isHidden
