	column 'Último Ticket de Treinamento' = VAR f = dCarteira[ID Legado] RETURN IF( f <> "", CALCULATE( MAX( Helpdesk_Tickets[id] ), Helpdesk_Tickets[service] = "Treinamento", Helpdesk_Tickets[ID Legado do Cliente] = f ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos
		lineageTag: edbea591-96d4-5d1a-85c8-24d3a8c9c0ad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data do Último Ticket de Treinamento' = VAR i = dCarteira[Último Ticket de Treinamento] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[Data_Criacao_Ticket], Helpdesk_Tickets[id], i ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Últimos contatos
		lineageTag: a97993da-4099-5065-9d33-d867a7f50856
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Categoria do Último Ticket' = VAR i = dCarteira[Último Ticket de Treinamento] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[category], Helpdesk_Tickets[id], i ) )
		dataType: string
		displayFolder: Últimos contatos
		lineageTag: 98004ae5-6dce-5ea4-9f88-f05f73424385
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Penúltimo Ticket de Treinamento' = VAR f = dCarteira[ID Legado] VAR i = dCarteira[Último Ticket de Treinamento] RETURN IF( NOT ISBLANK( i ), CALCULATE( MAX( Helpdesk_Tickets[id] ), Helpdesk_Tickets[service] = "Treinamento", Helpdesk_Tickets[ID Legado do Cliente] = f, Helpdesk_Tickets[id] < i ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos
		lineageTag: 1a32c999-44df-51ba-8589-cdea50109cfa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data do Penúltimo Ticket de Treinamento' = VAR i = dCarteira[Penúltimo Ticket de Treinamento] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[Data_Criacao_Ticket], Helpdesk_Tickets[id], i ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Últimos contatos
		lineageTag: d85d838e-420b-5443-95ab-a53a8b09f91b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Categoria do Penúltimo Ticket' = VAR i = dCarteira[Penúltimo Ticket de Treinamento] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[category], Helpdesk_Tickets[id], i ) )
		dataType: string
		displayFolder: Últimos contatos
		lineageTag: ee211477-5fd0-5ba0-96a9-fe21fa4495de
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias entre os Contatos' = VAR a = dCarteira[Data do Último Ticket de Treinamento] VAR b = dCarteira[Data do Penúltimo Ticket de Treinamento] RETURN IF( ISBLANK( a ) || ISBLANK( b ), BLANK(), INT( a - b ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos
		lineageTag: b302c023-5f69-5959-ae68-6c37c3ad55e7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias sem Contato' = VAR d = dCarteira[Data do Último Ticket de Treinamento] RETURN IF( ISBLANK( d ), 0, INT( dCarteira[Data do Retrato] - d ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos
		lineageTag: e78e3004-7f03-536c-a027-e9c79aadc1f1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Contato em Dia' = IF( dCarteira[Dias sem Contato] <= 10, "Sim", "Não" )
		dataType: string
		displayFolder: Últimos contatos
		lineageTag: d4d2d8c7-6fb0-57fb-af7e-f4ff9f3a3dc8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa sem Contato Ordem' = VAR d = dCarteira[Dias sem Contato] RETURN IF( ISBLANK( dCarteira[Data do Último Ticket de Treinamento] ), 6, SWITCH( TRUE(), d <= 10, 1, d <= 20, 2, d <= 30, 3, d <= 60, 4, 5 ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Últimos contatos
		lineageTag: 0dbbfeab-62b7-5bb4-aa50-cd887ffd143b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa sem Contato' = SWITCH( dCarteira[Faixa sem Contato Ordem], 1, "Até 10 dias", 2, "11 a 20 dias", 3, "21 a 30 dias", 4, "31 a 60 dias", 5, "Mais de 60 dias", "Sem ticket de Treinamento" )
		dataType: string
		displayFolder: Últimos contatos
		lineageTag: 07943b55-a2a9-5996-9430-475099bfb274
		summarizeBy: none
		sortByColumn: 'Faixa sem Contato Ordem'

		annotation SummarizationSetBy = Automatic

	column 'Dias desde o Registro' = IF( NOT ISBLANK( dCarteira[Data de Registro] ), INT( dCarteira[Data do Retrato] - dCarteira[Data de Registro] ) )
		dataType: int64
		formatString: 0
		displayFolder: Carteira
		lineageTag: db3012f7-4f70-5637-a0df-23cfde6ce8ca
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Checkouts = VAR f = dCarteira[ID Legado] RETURN IF( f <> "", CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = f, FILTER( VALUES( Helpdesk_Tickets[category] ), CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "checkout" ) ) ) + 0 )
		dataType: int64
		formatString: 0
		displayFolder: Carteira
		lineageTag: a84ce295-2d3b-5507-b7fd-c8ca892acd12
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Contatos = VAR f = dCarteira[ID Legado] RETURN IF( f <> "", CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = f, FILTER( VALUES( Helpdesk_Tickets[category] ), CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "contato efetivo" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tentativa de contato" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "formalização" ) ) ) + 0 )
		dataType: int64
		formatString: 0
		displayFolder: Carteira
		lineageTag: ebaecdf8-d9a5-5daa-a195-989233f733f7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Faltas = VAR f = dCarteira[ID Legado] RETURN IF( f <> "", CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = f, FILTER( VALUES( Helpdesk_Tickets[category] ), CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "falta" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "remarcação" ) ) ) + 0 )
		dataType: int64
		formatString: 0
		displayFolder: Carteira
		lineageTag: bf478f62-b27b-5358-9aa4-d76d6a90e666
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Última Tratativa Ongoing' = VAR f = dCarteira[ID Legado] RETURN IF( f <> "", CALCULATE( MAX( Helpdesk_Tickets[id] ), Helpdesk_Tickets[ID Legado do Cliente] = f, FILTER( VALUES( Helpdesk_Tickets[category] ), CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "checkout" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa alert" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa mayday" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa legado" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa en route" ) ) ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: a90953c6-9a29-5470-bbd0-b05fdbc29994
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data da Última Tratativa Ongoing' = VAR i = dCarteira[Última Tratativa Ongoing] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[Data_Criacao_Ticket], Helpdesk_Tickets[id], i ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: d882a3f5-403b-51e8-a1ef-e350fb5d2051
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Categoria da Última Tratativa Ongoing' = VAR i = dCarteira[Última Tratativa Ongoing] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[category], Helpdesk_Tickets[id], i ) )
		dataType: string
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: c5e3cc03-afed-5880-b60b-a92fa72c120c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Penúltima Tratativa Ongoing' = VAR f = dCarteira[ID Legado] VAR i = dCarteira[Última Tratativa Ongoing] RETURN IF( NOT ISBLANK( i ), MAXX( FILTER( CALCULATETABLE( VALUES( Helpdesk_Tickets[id] ), Helpdesk_Tickets[ID Legado do Cliente] = f, FILTER( VALUES( Helpdesk_Tickets[category] ), CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "checkout" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa alert" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa mayday" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa legado" ) || CONTAINSSTRING( LOWER( Helpdesk_Tickets[category] ), "tratativa en route" ) ) ), Helpdesk_Tickets[id] < i ), Helpdesk_Tickets[id] ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: adffbd42-4ec8-5d6d-aa48-b1720d285831
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data da Penúltima Tratativa Ongoing' = VAR i = dCarteira[Penúltima Tratativa Ongoing] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( Helpdesk_Tickets[Data_Criacao_Ticket], Helpdesk_Tickets[id], i ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: 59ea962a-0cda-58ae-ab2c-8a6c99ee1d35
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias entre as Tratativas Ongoing' = VAR a = dCarteira[Data da Última Tratativa Ongoing] VAR b = dCarteira[Data da Penúltima Tratativa Ongoing] RETURN IF( ISBLANK( a ) || ISBLANK( b ), BLANK(), INT( a - b ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: c4806f5f-c23a-554b-a030-905f7d02e13a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias sem Tratativa Ongoing' = VAR d = dCarteira[Data da Última Tratativa Ongoing] RETURN IF( ISBLANK( d ), 0, INT( dCarteira[Data do Retrato] - d ) )
		dataType: int64
		formatString: 0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: a2e0ff4d-d748-5bad-9e2b-f76494bee8d3
		summarizeBy: none

