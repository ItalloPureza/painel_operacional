	column 'Tratativa Ongoing em Dia' = IF( dCarteira[Dias sem Tratativa Ongoing] <= 45, "Sim", "Não" )
		dataType: string
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: e21b7189-95e2-5e75-8f8b-fbfebf784fbd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa sem Tratativa Ordem' = VAR d = dCarteira[Dias sem Tratativa Ongoing] RETURN IF( ISBLANK( dCarteira[Data da Última Tratativa Ongoing] ), 6, SWITCH( TRUE(), d <= 15, 1, d <= 30, 2, d <= 45, 3, d <= 90, 4, 5 ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Últimos contatos (Ongoing)
