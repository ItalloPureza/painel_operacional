	column 'Mês da Composição' = ( VAR _d = dCarteira[Data do Retrato] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: fb7e9b5f-4372-5d61-ac59-cde8af4d3d82
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dCarteira = calculated
		mode: import
		source =
				
				-- 1 linha por cliente no retrato MAIS RECENTE do CRM (o retrato vem com 2 linhas por cliente).
				-- Base das telas de foto do Onboarding (Últimos Contatos, carteira por CS). Gerado por gerar_onboarding.py.
				VAR ult = MAX( CRM_Backup_Diario[Periodo] )
				VAR retrato = CALCULATETABLE( CRM_Backup_Diario, CRM_Backup_Diario[Periodo] = ult, CRM_Backup_Diario[Só Kappa] = "Não" )
				VAR g =
				    GROUPBY(
				        retrato, CRM_Backup_Diario[Id_CRM],
				        "@legado", MAXX( CURRENTGROUP(), CRM_Backup_Diario[ID_Legado] ),
				        "@helpdesk", MAXX( CURRENTGROUP(), CRM_Backup_Diario[ID_helpdesk] ),
				        "@fantasia", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Nome_Fantasia] ),
				        "@razao", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Razao_Social] ),
				        "@cnpj", MAXX( CURRENTGROUP(), CRM_Backup_Diario[CNPJ] ),
				        "@cs", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Responsavel] ),
				        "@email", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Responsavel_Email] ),
				        "@status", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Status_Office] ),
				        "@statusCruzeiro", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Status de Saúde] ),
				        "@plano", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Plano] ),
				        "@registro", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Dt_Cadastro] ),
				        "@usadas", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Qtd_CNPJs_Usados] ),
				        "@contrato", MAXX( CURRENTGROUP(), CRM_Backup_Diario[Qtd_CNPJs_Contrato] )
				    )
				RETURN
				    SELECTCOLUMNS(
				        g,
				        "ID CRM", CRM_Backup_Diario[Id_CRM],
				        "ID Legado", [@legado],
				        "ID Helpdesk", [@helpdesk],
				        "Cliente", [@fantasia],
				        "Razão Social", [@razao],
				        "CNPJ", [@cnpj],
				        "CS", [@cs],
				        "Email do CS", [@email],
				        "Status", [@status],
				        "Status de Saúde", [@statusCruzeiro],
				        "Plano", [@plano],
				        "Data de Registro", [@registro],
				        "Empresas Usadas", IFERROR( VALUE( [@usadas] ), BLANK() ),
				        "Empresas do Contrato", IFERROR( VALUE( [@contrato] ), BLANK() ),
				        "Equipe do CS", IF( ISBLANK( [@email] ), IF( TRIM( [@cs] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], [@email], dColaboradorMes[AnoMes], ( VAR _d = ult VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) ), BLANK() ), "(sem equipe)" ) ),
				        "Setor do CS", LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], [@email], dColaboradorMes[AnoMes], ( VAR _d = ult VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) ), BLANK() ),
				        "Data do Retrato", ult
				    )

