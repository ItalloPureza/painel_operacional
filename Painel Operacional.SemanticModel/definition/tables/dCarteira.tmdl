table dCarteira
	lineageTag: 3fd4bfb7-b42a-5e18-9a4d-ca52633c6d3d

	/// Idade média dos clientes ativos/bloqueados (dias desde a Data Registro do CRM).
	measure 'Dias desde o Registro (média)' = CALCULATE( AVERAGE( dCarteira[Dias desde o Registro] ), dCarteira[Status] IN { "Ativo", "Bloqueado" } )
		formatString: #,0
		displayFolder: Carteira
		lineageTag: 85c6b076-c7f2-5c12-93c9-a9d2590336ba

	/// Média de dias desde o último ticket de Treinamento (só clientes com ticket).
	measure 'Dias sem Contato (média)' = CALCULATE( AVERAGE( dCarteira[Dias sem Contato] ), dCarteira[Status] IN { "Ativo", "Bloqueado" }, NOT ISBLANK( dCarteira[Data do Último Ticket de Treinamento] ) )
		formatString: 0.00
		displayFolder: Carteira
		lineageTag: f8c341f5-e016-5f9d-ab4b-fd442ba1854a

	/// Clientes ativos/bloqueados sem nenhum ticket de Treinamento (contam como 'em dia' na regra do OKR 2026).
	measure 'Clientes sem Ticket de Treinamento' = CALCULATE( COUNTROWS( dCarteira ), dCarteira[Status] IN { "Ativo", "Bloqueado" }, ISBLANK( dCarteira[Data do Último Ticket de Treinamento] ) )
		formatString: #,0
		displayFolder: Carteira
		lineageTag: a3de7fc0-0c23-50e5-a26a-f0d034253882

	/// Clientes ativos/bloqueados com o último ticket de Treinamento há mais de 10 dias.
	measure 'Clientes sem Contato em Dia' = [Clientes na Carteira] - [Clientes com Contato em Dia]
		formatString: #,0
		displayFolder: Carteira
		lineageTag: cc62c052-a1eb-5da7-8d77-6e8752a1e8c4

	/// Contato há até 10 dias ÷ clientes ativos/bloqueados — conta do OKR 2026 (cliente sem ticket = em dia).
	measure '% Clientes com Contato em Dia' = DIVIDE( [Clientes com Contato em Dia], [Clientes na Carteira] )
		formatString: 0.00%
		displayFolder: Carteira
		lineageTag: 46f89540-5efc-54a0-a833-2443af546de1

	/// Clientes ativos/bloqueados com ticket de Treinamento criado há até 10 dias (sem ticket conta como em dia, como no OKR 2026).
	measure 'Clientes com Contato em Dia' = CALCULATE( COUNTROWS( dCarteira ), dCarteira[Status] IN { "Ativo", "Bloqueado" }, dCarteira[Contato em Dia] = "Sim" )
		formatString: #,0
		displayFolder: Carteira
		lineageTag: 127cdf17-4d6d-5f82-a02d-5f0f3ff209a5

	/// Clientes ATIVOS e BLOQUEADOS no retrato mais recente do CRM (FOTO: não muda com o período).
	measure 'Clientes na Carteira' = CALCULATE( COUNTROWS( dCarteira ), dCarteira[Status] IN { "Ativo", "Bloqueado" } )
		formatString: #,0
		displayFolder: Carteira
		lineageTag: bbd7a768-1b57-5fc2-a458-c2ba88bd08a1

	/// Média de dias desde a última tratativa do Ongoing (só clientes com tratativa).
	measure 'Dias sem Tratativa (média)' = CALCULATE( AVERAGE( dCarteira[Dias sem Tratativa Ongoing] ), dCarteira[Status] IN { "Ativo", "Bloqueado" }, NOT ISBLANK( dCarteira[Data da Última Tratativa Ongoing] ) )
		formatString: 0.00
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: ea87a828-94ba-5f2b-8b0b-ee66adffe61d

	/// Clientes ativos/bloqueados sem nenhuma tratativa do Ongoing (contam como 'em dia' na regra do OKR 2026).
	measure 'Clientes sem Tratativa' = CALCULATE( COUNTROWS( dCarteira ), dCarteira[Status] IN { "Ativo", "Bloqueado" }, ISBLANK( dCarteira[Data da Última Tratativa Ongoing] ) )
		formatString: #,0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: 640525f8-8a29-583c-a4f3-aa66d844efb5

	/// Clientes ativos/bloqueados com a última tratativa há mais de 45 dias.
	measure 'Clientes sem Tratativa em Dia' = [Clientes na Carteira] - [Clientes com Tratativa em Dia]
		formatString: #,0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: e8a3e7fa-2b08-5d50-acdb-64a02a0f8279

	/// Tratativa há até 45 dias ÷ clientes ativos/bloqueados — conta do OKR 2026.
	measure '% Clientes com Tratativa em Dia' = DIVIDE( [Clientes com Tratativa em Dia], [Clientes na Carteira] )
		formatString: 0.00%
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: 199a05e4-f78c-5b21-8e2d-5df660dc96e0

	/// Clientes ativos/bloqueados com tratativa do Ongoing (checkout, alert, mayday, legado, en route) há até 45 dias (sem tratativa conta como em dia, como no OKR 2026).
	measure 'Clientes com Tratativa em Dia' = CALCULATE( COUNTROWS( dCarteira ), dCarteira[Status] IN { "Ativo", "Bloqueado" }, dCarteira[Tratativa Ongoing em Dia] = "Sim" )
		formatString: #,0
		displayFolder: Últimos contatos (Ongoing)
		lineageTag: 78d831f2-9626-5681-b9db-be46c823f4f1

	/// Mensalidade do cliente no sistema de contratos (AF + GB Extra + AF Docs + Pacote de GB + KP), mesma regra do Global - Carteiras: contratos status 3/5, item ativo sem responsável financeiro, no dia mais recente do sistema de contratos até o retrato. Use em tabelas por cliente.
	measure 'Mensalidade (Contratos)' = VAR cnpj = VALUES( dCarteira[CNPJ do Cliente (busca)] ) VAR ref = MAX( dCarteira[Data do Retrato] ) VAR d = CALCULATE( MAX( Contratos_historico_contratos[periodo] ), REMOVEFILTERS( Contratos_historico_contratos ), Contratos_historico_contratos[periodo] <= ref ) RETURN IF( NOT ISBLANK( d ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( cnpj, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 2, 3, 4, 5, 6 } ) )
		formatString: \R$ #,0.00
		displayFolder: Carteira
		lineageTag: 54c1d16f-b39e-40ad-97b5-aa78849e54e7

