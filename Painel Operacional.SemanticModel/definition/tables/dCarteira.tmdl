	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & dCarteira[ID Legado] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: 9ec17cf7-943d-5d67-8106-0110c7ae739b
