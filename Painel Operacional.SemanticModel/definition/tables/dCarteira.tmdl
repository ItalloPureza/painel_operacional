	column 'Faixa de Idade' = SWITCH( TRUE(), ISBLANK( dCarteira[Dias desde o Registro] ), BLANK(), dCarteira[Dias desde o Registro] <= 90, "Até 3 meses", dCarteira[Dias desde o Registro] <= 180, "3 a 6 meses", dCarteira[Dias desde o Registro] <= 365, "6 meses a 1 ano", dCarteira[Dias desde o Registro] <= 730, "1 a 2 anos", dCarteira[Dias desde o Registro] <= 1095, "2 a 3 anos", "Mais de 3 anos" )
		dataType: string
