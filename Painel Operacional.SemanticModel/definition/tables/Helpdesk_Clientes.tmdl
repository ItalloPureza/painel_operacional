	partition Helpdesk_Clientes = m
		mode: import
		queryGroup: Helpdesk
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Helpdesk_Clientes",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id", type text}, {"name", type text}, {"email", type text}, {"idEmpresa", type text}, {"data_extracao", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

