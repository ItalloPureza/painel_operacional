	column 'Carteira no Dia' = VAR d = Calendario[Date] VAR n = COUNTROWS( RELATEDTABLE( Contratos_historico_contratos ) ) RETURN IF( n > 0 && NOT ISEMPTY( RELATEDTABLE( CRM_Backup_Diario ) ), VAR semana = FILTER( Contratos_historico_contratos, Contratos_historico_contratos[periodo] >= d - 7 && Contratos_historico_contratos[periodo] < d ) VAR media = DIVIDE( COUNTROWS( semana ), COUNTROWS( DISTINCT( SELECTCOLUMNS( semana, "@d", Contratos_historico_contratos[periodo] ) ) ) ) RETURN IF( ISBLANK( media ) || n >= media / 2, 1, 0 ), 0 )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Global
		lineageTag: a62db4df-4924-5ec9-9f9d-7feebba55fc6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

