	partition Contratos_historico_mercado = m
		mode: import
		queryGroup: Contratos
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Contratos_historico_mercado",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"periodo", type datetime}, {"id", Int64.Type}, {"empresa_id", Int64.Type}, {"nome", type text}, {"tamanho", Int64.Type}, {"ativo", Int64.Type}, {"created_at", type datetime}, {"updated_at", type datetime}})
				in
				    Tipos


