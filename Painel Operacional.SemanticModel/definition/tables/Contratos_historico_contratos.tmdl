	/// Valor do item AF dos clientes da carteira no dia da carteira (último dia do período com retrato do CRM e Contratos) (por CNPJ, o maior valor, como o OKR 2026).
	measure 'Mensalidade AF (Contratos)' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 2 } ) )
