	/// Clientes da carteira com item Pacote de GB ativo no sistema de contratos no dia da carteira (último dia do período com retrato do CRM e Contratos) (contrato 3/5; item de contrato sem responsável financeiro).
	measure 'Clientes Pacote de GB (Contratos)' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ), CALCULATE( COUNTROWS( SUMMARIZE( Contratos_historico_items, Contratos_historico_contratos[cnpj_cpf] ) ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 6 } ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 6b7886eb-1792-586f-bd5b-715e07f41551

