table Contratos_historico_contratos
	lineageTag: 2575e64f-4576-4aa6-86df-99b523fdf1a5

	/// Mensalidade (itens AF, GB Extra, AF Docs, KP, Pacote de GB) dos contratos 3/5 sem cliente na carteira no dia da carteira (último dia do período com retrato do CRM e Contratos). Mensalidade Total + esta = total do sistema de contratos (sem filtro de CS).
	measure 'Mensalidade sem Cliente na Carteira' = VAR d = [Dia da Carteira] VAR todos = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Periodo] = d, CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) VAR contratos = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 } ) VAR fora = EXCEPT( contratos, todos ) RETURN IF( NOT ISBLANK( d ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( fora, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 2, 3, 4, 5, 6 } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 896de654-d723-5f23-8a78-b163d1b5951f

	/// CNPJs com contrato status 3/5 no sistema de contratos que não são cliente Ativo/Bloqueado no CRM no dia da carteira (último dia do período com retrato do CRM e Contratos) (não segue os filtros de CS: esses CNPJs não têm CS).
	measure 'Contratos sem Cliente na Carteira' = VAR d = [Dia da Carteira] VAR todos = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), REMOVEFILTERS( CRM_Backup_Diario ), CRM_Backup_Diario[Periodo] = d, CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) VAR contratos = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 } ) RETURN IF( NOT ISBLANK( d ), COUNTROWS( EXCEPT( contratos, todos ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 0b14043d-8dbd-5710-aa13-b281f02b8bfe

	/// CS do cliente da carteira que não tem contrato 3/5 no sistema de contratos (lista da conferência).
	measure 'CS do Cliente sem Contrato' = IF( HASONEVALUE( CRM_Backup_Diario[ID_Legado] ) && [Clientes sem Contrato no sistema de contratos] > 0, COALESCE( [CS no Dia], "(sem CS)" ) )
		displayFolder: Global
		lineageTag: 51e21dd7-ddc0-589f-a450-7b0e6aa3f01d

	/// Clientes Ativo/Bloqueado no CRM SEM contrato status 3/5 no sistema de contratos (pelo CNPJ) no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes sem Contrato no sistema de contratos' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR contratos = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), REMOVEFILTERS( Contratos_historico_contratos ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 } ) RETURN IF( NOT ISBLANK( d ), COUNTROWS( EXCEPT( clientes, contratos ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 3cdbc1da-7118-5dc4-b6f8-76beb7da5503

	/// Clientes Ativo/Bloqueado no CRM com contrato status 3/5 no sistema de contratos no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Clientes com Contrato no sistema de contratos' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR contratos = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), REMOVEFILTERS( Contratos_historico_contratos ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 } ) RETURN IF( NOT ISBLANK( d ), COUNTROWS( INTERSECT( clientes, contratos ) ) )
		formatString: #,0
		displayFolder: Global
		lineageTag: 227b4e05-09c5-569e-9c34-edf18a8af76f

	/// Mensalidade Alfa (AF + GB Extra + AF Docs + Pacote de GB, como a 'Mensalidade AF' do OKR 2026) ÷ clientes com o item AF, no dia da carteira.
	measure 'Ticket Médio AF (Contratos)' = DIVIDE( [Mensalidade Alfa (Contratos)], [Clientes AF (Contratos)] )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 2c60484e-39b8-585c-b705-f7f1a4921ee2

	/// Alfa + Kappa dos clientes da carteira no dia da carteira (último dia do período com retrato do CRM e Contratos). Com Produto (itens) na série, separa por item.
	measure 'Mensalidade Total (Contratos)' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 2, 3, 4, 5, 6 } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 83423372-045f-5a84-a8c0-4006c737e0ae

	/// AF + GB Extra + AF Docs + Pacote de GB (Mensalidade_Alfa_Contratos do OKR 2026), clientes da carteira no dia da carteira (último dia do período com retrato do CRM e Contratos).
	measure 'Mensalidade Alfa (Contratos)' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 2, 3, 4, 6 } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 38e23172-18ab-56a8-b4ee-39197f7cec33

	/// Valor do item Pacote de GB dos clientes da carteira no dia da carteira (último dia do período com retrato do CRM e Contratos) (por CNPJ, o maior valor, como o OKR 2026).
	measure 'Mensalidade Pacote de GB (Contratos)' = VAR d = [Dia da Carteira] VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado" } ) ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ), CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 6 } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: bc261fbd-7588-5424-82af-807a332305ab

