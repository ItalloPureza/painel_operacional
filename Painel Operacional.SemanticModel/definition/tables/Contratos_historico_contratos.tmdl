		lineageTag: 3fb84aa8-cc1b-5343-85e7-f9fa437f2232

	/// Mensalidade do item Kappa (Contratos, contrato 3/5) dos clientes com Status KP Ativo no 1º dia do mês com retrato e Contratos (vazio se depois do dia 3). Base do churn financeiro KP.
	measure 'Mensalidade KP (início do mês)' = VAR d = CALCULATE( MIN( Calendario[Date] ), KEEPFILTERS( Calendario[Carteira no Dia] = 1 ) ) VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, CRM_Backup_Diario[Status KP] = "Ativo" ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ) && DAY( d ) <= 3, CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 5 } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 863927cd-68de-5831-b5d1-4d0c5d6eb156

	/// Mensalidade Alfa (AF + GB Extra + AF Docs + Pacote de GB, Contratos, contrato 3/5) dos clientes AF ativos no 1º dia do mês com retrato do CRM e Contratos (vazio se esse dia for depois do dia 3). Base do churn financeiro AF.
	measure 'Mensalidade AF (início do mês)' = VAR d = CALCULATE( MIN( Calendario[Date] ), KEEPFILTERS( Calendario[Carteira no Dia] = 1 ) ) VAR clientes = CALCULATETABLE( DISTINCT( CRM_Backup_Diario[CNPJ (dígitos)] ), CRM_Backup_Diario[Periodo] = d, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado", "Suspenso" } ), CRM_Backup_Diario[Só Kappa] = "Não" ) VAR base = CALCULATETABLE( DISTINCT( Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_contratos[periodo] = d, Contratos_historico_contratos[status_id] IN { 3, 5 }, TREATAS( clientes, Contratos_historico_contratos[cnpj_cpf] ) ) RETURN IF( NOT ISBLANK( d ) && DAY( d ) <= 3, CALCULATE( SUMX( GROUPBY( SELECTCOLUMNS( Contratos_historico_items, "@c", RELATED( Contratos_historico_contratos[cnpj_cpf] ), "@i", Contratos_historico_items[item_catalogo_id], "@v", Contratos_historico_items[vr_total] ), [@c], [@i], "@m", MAXX( CURRENTGROUP(), [@v] ) ), [@m] ), Contratos_historico_contratos[periodo] = d, ISBLANK( Contratos_historico_contratos[financeiro_resp_id] ), TREATAS( base, Contratos_historico_contratos[cnpj_cpf] ), Contratos_historico_items[item_catalogo_id] IN { 2, 3, 4, 6 } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 1ca42397-85f5-58ce-849b-b31b3d98e48f

