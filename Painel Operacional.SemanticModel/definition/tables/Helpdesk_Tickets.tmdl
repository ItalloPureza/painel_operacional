table Helpdesk_Tickets
	lineageTag: b5a6e783-9a57-4315-be5b-257f1016e013

	/// Tickets por data de RESOLUÇÃO. Usar só no SLA.
	measure 'Tickets Resolvidos' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), NOT ISBLANK( Helpdesk_Tickets[Data_Resolucao_Ticket] ), USERELATIONSHIP( Helpdesk_Tickets[Data_Resolucao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: acbd0d78-b2e9-54b7-b7fa-7c36afc73388

	/// Tickets por data de CRIAÇÃO. Usar só no No Show.
	measure 'Tickets Criados' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: 2714d08c-ab3b-54b8-a826-c815541d6199

	/// Tickets por data de FECHAMENTO (padrão do ticket).
	measure 'Tickets Fechados' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: a13e4fe5-4a82-5fea-9c79-4f545c466efd

	/// Data da última live no período.
	measure 'Última Live no Período' = CALCULATE( MAX( Helpdesk_Tickets[Data_Criacao_Ticket] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: dd/mm/yy
		displayFolder: Lives
		lineageTag: 11330002-45b1-587a-a6c0-61706cfad446

	/// Data da primeira live do cliente em todo o histórico (não muda com o período).
	measure 'Primeira Live' = CALCULATE( MIN( Helpdesk_Tickets[Data_Criacao_Ticket] ), Helpdesk_Tickets[service] = "Live", REMOVEFILTERS( Calendario ) )
		formatString: dd/mm/yy
		displayFolder: Lives
		lineageTag: cee73c06-7717-5184-9b18-3c079a8eba2f

	/// Em quantas lives cada escritório esteve, em média.
	measure 'Lives por Cliente' = AVERAGEX( FILTER( CALCULATETABLE( VALUES( Helpdesk_Tickets[id_client] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) ), NOT ISBLANK( Helpdesk_Tickets[id_client] ) ), [Lives Realizadas] )
		formatString: 0.00
		displayFolder: Lives
		lineageTag: 3b4d6e38-0b06-5227-b0d1-a6e2d405ac21

	/// Participantes ÷ escritórios.
	measure 'Participações por Cliente' = DIVIDE( [Participantes (Lives)], [Clientes nas Lives] )
		formatString: 0.00
		displayFolder: Lives
		lineageTag: 100326e0-2506-5f23-bb19-bb8e33a42e31

	/// Escritórios do período que já tinham participado de uma live antes.
	measure 'Clientes que Voltaram' = [Clientes nas Lives] - [Clientes Novos nas Lives]
		formatString: #,0
		displayFolder: Lives
		lineageTag: 361341fc-24d9-5891-80f3-fdf28e155eba

	/// Escritórios cuja PRIMEIRA live (em todo o histórico) caiu no período.
	measure 'Clientes Novos nas Lives' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[id_client] ), Helpdesk_Tickets[service] = "Live", Helpdesk_Tickets[Cliente Novo na Live] = TRUE(), USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Lives
		lineageTag: 059336e0-d6b2-5893-bcdc-07c5d69b92ae

	/// Escritórios diferentes por live, em média.
	measure 'Média de Clientes por Live' = AVERAGEX( CALCULATETABLE( VALUES( Helpdesk_Tickets[Live (data e tema)] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) ), [Clientes nas Lives] )
		formatString: 0.00
		displayFolder: Lives
		lineageTag: 25f0a4ad-9b3f-599a-a64f-69ab85350058

	/// Participantes da live mais cheia do período.
	measure 'Maior Público em uma Live' = MAXX( CALCULATETABLE( VALUES( Helpdesk_Tickets[Live (data e tema)] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) ), [Participantes (Lives)] )
		formatString: #,0
		displayFolder: Lives
		lineageTag: 97e9b27f-6336-5b57-9e64-d7ad90f9dec0

	/// Participantes ÷ lives realizadas.
	measure 'Média de Participantes por Live' = DIVIDE( [Participantes (Lives)], [Lives Realizadas] )
		formatString: 0.00
		displayFolder: Lives
		lineageTag: 2a42b2f1-b7fa-5883-a1f5-fdd9c8f8ca7b

	/// Categorias (temas) diferentes das lives no período.
	measure 'Temas Abordados' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[category] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Lives
		lineageTag: a4c7895f-3936-55e2-8308-78ee9241e165

	/// Lives = combinações data + tema (categoria) com pelo menos 1 participante.
	measure 'Lives Realizadas' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[Live (data e tema)] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Lives
		lineageTag: ce37428f-63f6-549f-90e4-c3efdaf23285

	/// Escritórios (clientes do Helpdesk) diferentes que participaram. Por data da live.
	measure 'Clientes nas Lives' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[id_client] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Lives
		lineageTag: 4c81fcfe-edfc-55ec-8222-65db548eb471

	/// Solicitantes diferentes (a mesma pessoa em duas lives conta 1). Por data da live.
	measure 'Pessoas Distintas (Lives)' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[solicitantes] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Lives
		lineageTag: 6d17e05e-b957-55a2-b00b-d90929cf0947

	/// Cada ticket do serviço Live = 1 participante. Por DATA DA LIVE (criação do ticket).
	measure 'Participantes (Lives)' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Lives
		lineageTag: bf4304ca-217a-566e-8b63-5fba125fa75b

	/// Tickets fechados que têm SLA previsto. Status SLA calculado até a resolução; contado pela data de FECHAMENTO.
	measure 'Tickets com SLA' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), NOT ISBLANK( Helpdesk_Tickets[Status SLA] ), NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
		formatString: #,0
		displayFolder: SLA
		lineageTag: 1814b00e-b40c-585c-a9d9-b4bc755ac2fd

	/// Dos tickets fechados no período, quantos foram resolvidos dentro do SLA.
	measure '% no Prazo do SLA' = DIVIDE( [Tickets no Prazo do SLA], [Tickets com SLA] )
		formatString: 0.00%
		displayFolder: SLA
		lineageTag: 84d14191-d2fc-5ac7-befd-c03322545289

	/// Tickets fechados que foram resolvidos até o SLA previsto. Contado pela data de FECHAMENTO.
	measure 'Tickets no Prazo do SLA' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Status SLA] = "No prazo", NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
		formatString: #,0
		displayFolder: SLA
		lineageTag: f29b68ae-7623-5a58-9220-5ca9be4e04fa

	/// Quanto dos tickets (com empresa) vem das 10 empresas que mais abriram.
	measure '% Tickets das 10 Maiores Empresas' = VAR emp = CALCULATETABLE( VALUES( Helpdesk_Tickets[Empresa] ), NOT ISBLANK( Helpdesk_Tickets[Empresa] ) ) RETURN DIVIDE( SUMX( TOPN( 10, emp, [Tickets Fechados] ), [Tickets Fechados] ), [Tickets com Empresa] )
		formatString: 0.00%
		displayFolder: Atendimento
		lineageTag: 1db698fc-30df-5ab8-bf3f-e257a26d1c69

	/// Empresas com 10 ou mais tickets fechados no período.
	measure 'Empresas com 10+ Tickets' = COUNTROWS( FILTER( CALCULATETABLE( VALUES( Helpdesk_Tickets[Empresa] ), NOT ISBLANK( Helpdesk_Tickets[Empresa] ) ), [Tickets Fechados] >= 10 ) )
		formatString: #,0
		displayFolder: Atendimento
		lineageTag: eeecbae5-9495-5904-ac59-85765e98e919

	/// Tickets fechados ÷ empresas atendidas.
	measure 'Tickets por Empresa' = DIVIDE( [Tickets com Empresa], [Empresas Atendidas] )
		formatString: 0.00
		displayFolder: Atendimento
		lineageTag: 4cf07b82-cd4d-5bc8-be64-353349356bbe

	/// Tickets fechados que têm empresa identificada.
	measure 'Tickets com Empresa' = CALCULATE( [Tickets Fechados], NOT ISBLANK( Helpdesk_Tickets[Empresa] ) )
		formatString: #,0
		displayFolder: Atendimento
		lineageTag: 67cd279d-e1c3-5ace-9f31-c56de742aa31

	/// Empresas (organization) com ticket fechado no período.
	measure 'Empresas Atendidas' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[Empresa] ), NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
		formatString: #,0
		displayFolder: Atendimento
		lineageTag: f9b513a7-fca4-5d33-aa77-5a0652a8c1ed

	/// TMA Chat (min) em hh:mm:ss (para cartão).
	measure 'TMA Chat' = VAR _m = [TMA Chat (min)] RETURN IF( ISBLANK( _m ), "", VAR _s = ROUND( _m * 60, 0 ) RETURN FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) )
		displayFolder: Atendimento
		lineageTag: d9685d69-52b1-5718-979c-a3974bea3b83

	/// TME Chat (min) em hh:mm:ss (para cartão).
	measure 'TME Chat' = VAR _m = [TME Chat (min)] RETURN IF( ISBLANK( _m ), "", VAR _s = ROUND( _m * 60, 0 ) RETURN FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) )
		displayFolder: Atendimento
		lineageTag: 42fd2bcd-ff19-5263-859c-028cf035aa68

	/// Tempo médio de atendimento no WhatsApp. Em minutos, por data de fechamento.
	measure 'TMA WhatsApp (min)' = DIVIDE( CALCULATE( AVERAGE( Helpdesk_Tickets[Tempo de Atendimento (s)] ), Helpdesk_Tickets[origin] IN { 18, 23, 25 }, NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), 60 )
		displayFolder: Atendimento
		lineageTag: d4e27ae0-7c85-5b85-9ce4-de5014075465

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 60, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Tempo médio de espera no WhatsApp. Em minutos, por data de fechamento.
	measure 'TME WhatsApp (min)' = DIVIDE( CALCULATE( AVERAGE( Helpdesk_Tickets[Tempo de Espera (s)] ), Helpdesk_Tickets[origin] IN { 18, 23, 25 }, NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), 60 )
		displayFolder: Atendimento
		lineageTag: 1cf12414-faab-57d7-ba17-5ed2678c4ec8

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 60, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Tempo médio de atendimento no chat. Em minutos, por data de fechamento.
	measure 'TMA Chat (min)' = DIVIDE( CALCULATE( AVERAGE( Helpdesk_Tickets[Tempo de Atendimento (s)] ), Helpdesk_Tickets[origin] IN { 5 }, NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), 60 )
		displayFolder: Atendimento
		lineageTag: eaa5ed40-6c40-5fd4-a8ee-26689f16567a

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 60, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Tempo médio de espera no chat. Em minutos, por data de fechamento.
	measure 'TME Chat (min)' = DIVIDE( CALCULATE( AVERAGE( Helpdesk_Tickets[Tempo de Espera (s)] ), Helpdesk_Tickets[origin] IN { 5 }, NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), 60 )
		displayFolder: Atendimento
		lineageTag: 0fd780fd-3284-51a4-910c-530afa54badc

		formatStringDefinition = VAR _s = ROUND( SELECTEDMEASURE() * 60, 0 ) RETURN """" & FORMAT( INT( _s / 3600 ), "00" ) & ":" & FORMAT( INT( MOD( _s, 3600 ) / 60 ), "00" ) & ":" & FORMAT( MOD( _s, 60 ), "00" ) & """"

	/// Parte dos tickets fechados que entrou pela API (assistente virtual / bot).
	measure '% via API / Assistente' = DIVIDE( CALCULATE( [Tickets Fechados], Helpdesk_Tickets[Canal] = "API / Assistente virtual" ), [Tickets Fechados] )
		formatString: 0.00%
		displayFolder: Atendimento
		lineageTag: c603c1cc-886d-598a-a769-233abe356e73

	/// Parte dos tickets fechados que veio do WhatsApp.
	measure '% via WhatsApp' = DIVIDE( CALCULATE( [Tickets Fechados], Helpdesk_Tickets[Canal] = "WhatsApp" ), [Tickets Fechados] )
		formatString: 0.00%
		displayFolder: Atendimento
		lineageTag: d77c3c1f-2cf5-532e-91c4-71d5bce7b2b0

	/// Parte dos tickets fechados que veio do chat.
	measure '% via Chat' = DIVIDE( CALCULATE( [Tickets Fechados], Helpdesk_Tickets[Canal] = "Chat" ), [Tickets Fechados] )
		formatString: 0.00%
		displayFolder: Atendimento
		lineageTag: 1c31b9f1-639c-5e12-97a2-5632db428251

	/// Clientes (solicitantes do Helpdesk) com ticket fechado no período.
	measure 'Clientes com Ticket' = CALCULATE( DISTINCTCOUNTNOBLANK( Helpdesk_Tickets[id_client] ), NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
		formatString: #,0
		displayFolder: Atendimento
		lineageTag: e6d0512c-bca3-597b-b1c4-9c02c6c0052d

	/// Meta de No Show do Onboarding (intranet: No Show - Onboarding, setor Onboarding). Meta ÷ 100.
	measure 'Meta % No Show' = VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta % No Show" ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0, DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) )
		formatString: 0.00%
		displayFolder: No Show (Onboarding)
		lineageTag: 10a73f0c-065e-58c4-bd75-eb732579b587

	/// Tickets de tentativa de contato, por data de FECHAMENTO.
	measure 'Tentativas de Contato' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Tentativa de Contato" )
		formatString: #,0
		displayFolder: Contatos
		lineageTag: 140d7ed4-de5d-50d1-869d-5af512572328

	/// Tickets de contato efetivo, por data de FECHAMENTO.
	measure 'Contatos Efetivos' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Contato Efetivo" )
		formatString: #,0
		displayFolder: Contatos
		lineageTag: d97264c5-823f-54d4-8e2d-d3dd93e55537

	/// Quedas ÷ (quedas + reuniões feitas) — mesma conta do OKR 2026. Por data de criação.
	measure '% No Show' = DIVIDE( [Quedas (No Show)], [Quedas (No Show)] + [Reuniões Feitas (Checkout)] )
		formatString: 0.00%
		displayFolder: No Show
		lineageTag: 80faf467-7ae9-5817-930c-7550923d624d

	/// Quedas no treinamento + no agendamento.
	measure 'Quedas (No Show)' = [Quedas no Treinamento] + [Quedas no Agendamento]
		formatString: #,0
		displayFolder: No Show
		lineageTag: 4ea0479d-8209-5e95-a66c-b40ae8cebb52

	/// Falta, remarcação ou cancelamento de treinamento registrados no Agendamento (setor Consultoria). Por data de CRIAÇÃO do ticket (regra do No Show).
	measure 'Quedas no Agendamento' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Reunião Onboarding] = "Queda no agendamento", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: No Show
		lineageTag: 8e2efa34-dc47-511d-b87d-59e4a020853c

	/// Falta ou remarcação registrada no Treinamento. Por data de CRIAÇÃO do ticket (regra do No Show).
	measure 'Quedas no Treinamento' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Reunião Onboarding] = "Queda no treinamento", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: No Show
		lineageTag: d61f000e-b4e5-5507-940d-f0d77444cfcc

	/// Reuniões feitas: tickets de checkout do serviço Treinamento (lista de categorias do OKR 2026). Por data de CRIAÇÃO do ticket (regra do No Show).
	measure 'Reuniões Feitas (Checkout)' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Reunião Onboarding] = "Checkout (reunião feita)", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: No Show
		lineageTag: 584160ed-e988-5bd7-add4-ce3305af0601

	/// Tira-dúvidas com origem Interna. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tira-Dúvidas Internos' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Tira Dúvidas", Helpdesk_Tickets[origem_cs] = "Interna" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: db06a7d2-e135-5b2d-b1e9-7df4e48777fb

	/// Tira-dúvidas com origem WhatsApp. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tira-Dúvidas por WhatsApp' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Tira Dúvidas", Helpdesk_Tickets[origem_cs] = "WhatsApp" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: 8473df3d-a754-5d16-84b3-b450f6d9186a

	/// Tira-dúvidas com origem Ticket. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tira-Dúvidas por Ticket' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Tira Dúvidas", Helpdesk_Tickets[origem_cs] = "Ticket" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: 2ebf7f8b-3a02-5276-90d8-7df28095510d

	/// Tickets de Negociação. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tratativas de Negociação' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Negociação" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: db888ac5-8a2f-5078-b74d-3800f0d0cb23

	/// Tickets de Desenvolvimento. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tratativas de Desenvolvimento' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Desenvolvimento" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: 6e0045c6-514b-5751-9a67-9ca30423ce9c

	/// Tickets 'Ongoing sem contato'. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Ongoing sem Contato' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Ongoing sem contato" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: 4846621a-3c67-5255-bf4d-d391a822ef4d

	/// Tickets de tentativa de contato. Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tentativas de Contato Ongoing' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] = "Tentativa de Contato" )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: df059bd1-e9ea-5101-89ac-289c8eb69b82

	/// Checkouts (lista do OKR 2026; o No Show conta os mesmos pela criação). Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Checkouts Feitos' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] IN { "Checkout - Acompanhamento", "Checkout - Onboarding", "Checkout - Aplicativo e Área VIP", "Checkout - Configurações Iniciais", "Checkout - Departamentos", "Checkout - e-Continuo", "Checkout - Gestão de Processos", "Checkout - Kappa", "Checkout - Lista de Entregas", "Checkout - Método APLA", "Checkout - Novo Colaborador", "Checkout - Retomada", "Checkout - AF Docs" } )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: c0931c09-efd4-538d-b556-303ed6856302

	/// Tratativas (Tratativa Onboarding, Tratativa Mayday, Tratativa Alert, Tratativa En Route, Tratativa Cruzeiro, Tratativa Clientes Bloqueados). Fila Sucesso do Cliente, por data de FECHAMENTO.
	measure 'Tratativas Feitas' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[owner_team] = "Sucesso do Cliente", Helpdesk_Tickets[category] IN { "Tratativa Onboarding", "Tratativa Mayday", "Tratativa Alert", "Tratativa En Route", "Tratativa Cruzeiro", "Tratativa Clientes Bloqueados" } )
		formatString: #,0
		displayFolder: Contatos (Ongoing)
		lineageTag: 6b5d9739-a1bd-5c01-a603-8e0d19a4762b

	/// Meta de No Show do Ongoing (intranet: No Show - Ongoing, setor Ongoing). Meta ÷ 100.
	measure 'Meta % No Show Ongoing' = VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta % No Show Ongoing" ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0, DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) )
		formatString: 0.00%
		displayFolder: No Show (Ongoing)
		lineageTag: 5fb7b39e-a82c-5d2d-ab7b-96776e7fa042

	/// Quedas ÷ (quedas + reuniões feitas) — mesma conta do OKR 2026. Por data de criação.
	measure '% No Show Ongoing' = DIVIDE( [Quedas Ongoing], [Quedas Ongoing] + [Reuniões Feitas Ongoing] )
		formatString: 0.00%
		displayFolder: No Show (Ongoing)
		lineageTag: f0a03a06-cdbe-5cf6-8ab3-e68bcf9b348f

	/// Quedas na reunião + no agendamento (Ongoing).
	measure 'Quedas Ongoing' = [Quedas na Reunião Ongoing] + [Quedas no Agendamento Ongoing]
		formatString: #,0
		displayFolder: No Show (Ongoing)
		lineageTag: e1e380f0-8b96-57bd-bdab-ca71f044099e

	/// Falta, remarcação ou cancelamento de treinamento no Agendamento (setor Sucesso do Cliente). Por data de CRIAÇÃO do ticket (regra do No Show).
	measure 'Quedas no Agendamento Ongoing' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Reunião Ongoing] = "Queda no agendamento", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: No Show (Ongoing)
		lineageTag: ea6b5502-0a22-5cf3-bede-ce03308f6de1

	/// Falta ou remarcação no serviço Sucesso do Cliente. Por data de CRIAÇÃO do ticket (regra do No Show).
	measure 'Quedas na Reunião Ongoing' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Reunião Ongoing] = "Queda na reunião", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: No Show (Ongoing)
		lineageTag: e0cde9a8-df86-5add-8f10-129022e154ac

	/// Reuniões feitas do Ongoing: serviço Sucesso do Cliente + lista de checkouts do OKR 2026. Por data de CRIAÇÃO do ticket (regra do No Show).
	measure 'Reuniões Feitas Ongoing' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Reunião Ongoing] = "Checkout (reunião feita)", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) )
		formatString: #,0
		displayFolder: No Show (Ongoing)
		lineageTag: d869208b-eb5c-5bc8-a15b-61bf91f4be2d

	/// Atendimentos da Ouvidoria com avaliação ÷ atendimentos (criação).
	measure '% Atendimentos com Avaliação' = DIVIDE( CALCULATE( [Atendimentos Ouvidoria], Helpdesk_Tickets[Houve Avaliação] = "Sim" ), [Atendimentos Ouvidoria] )
		formatString: 0.00%
		displayFolder: Ouvidoria
		lineageTag: 5c17c51b-fa68-5135-99b5-efcd0aa3af24

	/// Tickets do serviço Ouvidoria, por data de RESOLUÇÃO.
	measure 'Atendimentos Ouvidoria Resolvidos' = CALCULATE( [Tickets Resolvidos], Helpdesk_Tickets[service] = "Ouvidoria" )
		formatString: #,0
		displayFolder: Ouvidoria
		lineageTag: ed1f70fb-e26e-5b3e-9669-28a6b3133ac4

	/// Tickets do serviço Ouvidoria, por data de CRIAÇÃO.
	measure 'Atendimentos Ouvidoria' = CALCULATE( [Tickets Criados], Helpdesk_Tickets[service] = "Ouvidoria" )
		formatString: #,0
		displayFolder: Ouvidoria
		lineageTag: 9d05d709-4949-5739-bf39-c0548314360e

	/// Entregas (Área VIP) fechadas no período.
	measure 'Entregas Área VIP' = CALCULATE( [Tickets Fechados], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Área VIP" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 7c79d8b6-16c0-55bf-8681-793dcbb6ad5d

	/// Entregas (Apple) fechadas no período.
	measure 'Entregas Apple' = CALCULATE( [Tickets Fechados], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Apple" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: ecb7c743-85d8-57c6-8694-c0ee6ffc87cf

	/// Entregas (Android) fechadas no período.
	measure 'Entregas Android' = CALCULATE( [Tickets Fechados], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Android" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: f89a79a3-a115-5cd7-b7f2-7c99c8253d47

	/// Média de dias da criação até a resolução — Android + Apple (média dos tickets).
	measure 'Média de Dias Mobile' = CALCULATE( [Média de Dias até a Resolução], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Android", "Apple" } ) )
		formatString: 0.00
		displayFolder: Homologação
		lineageTag: a822e0fa-bff2-5c77-a709-5e71fa8fa2c4

	/// Média de dias da criação até a resolução — Área VIP (média dos tickets).
	measure 'Média de Dias Área VIP' = CALCULATE( [Média de Dias até a Resolução], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Área VIP" } ) )
		formatString: 0.00
		displayFolder: Homologação
		lineageTag: 5b9bb9ac-221b-537f-9d1e-ce4ee072f93c

	/// Média de dias da criação até a resolução — Apple (média dos tickets).
	measure 'Média de Dias Apple' = CALCULATE( [Média de Dias até a Resolução], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Apple" } ) )
		formatString: 0.00
		displayFolder: Homologação
		lineageTag: 9c7464b3-062b-5b68-9304-0651e769ac22

	/// Média de dias da criação até a resolução — Android (média dos tickets).
	measure 'Média de Dias Android' = CALCULATE( [Média de Dias até a Resolução], KEEPFILTERS( Helpdesk_Tickets[Tipo de Entrega] IN { "Android" } ) )
		formatString: 0.00
		displayFolder: Homologação
		lineageTag: 09097e4f-209e-56e5-aab7-cdfaf62589bc

	/// Média de dias da criação até a resolução dos tickets fechados no período (Tempo de entrega do app).
	measure 'Média de Dias até a Resolução' = CALCULATE( AVERAGE( Helpdesk_Tickets[Dias até a Resolução] ), NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
		formatString: 0.00
		displayFolder: Homologação
		lineageTag: 1a760d3b-fccf-5aa3-81c7-160971a4df90

	/// Homologações de guias de configuração/orientação. Por data de fechamento.
	measure 'Configuração/Orientação (Guias)' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação Guias" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "Homologação - Configuração/Orientação" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 09d04780-2dae-59a2-a8dd-03b74e973992

	/// Homologações de guias com documento ilegível. Por data de fechamento.
	measure 'Documentos Ilegíveis' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação Guias" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "Homologação - Documento Ilegível" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 7abc5739-108d-5d94-a738-23f9411227dc

	/// Homologações de guias finalizadas (homologado). Por data de fechamento.
	measure 'Guias Finalizadas' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação Guias" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "Homologação - Finalização/Homologado" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: a625d194-5bbc-5586-a617-43be1201492b

	/// Serviço Ajuste de Homologação de Guias. Por data de fechamento.
	measure 'Ajustes Guias' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Ajuste Guias" ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: da1314cf-5aef-5f49-8bc1-7e9be3dd9d43

	/// Serviço Homologação de Guias do e-Contínuo. Por data de fechamento.
	measure 'Homologações Guias' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação Guias" ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: df4bae6b-288d-5ae6-9510-68b2bfdd2a24

	/// Homologações do App encerradas sem retorno do cliente. Por data de fechamento.
	measure 'Sem Retorno do Cliente (App)' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "Sem retorno do Cliente" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 518349b6-877d-5996-9cf4-761ba968b5fd

	/// Publicações na Apple. Por data de fechamento.
	measure 'Publicações Apple' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "Publicação Apple" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 485b78c2-0842-567c-a958-48ef134f2016

	/// App/Área VIP disponível (inclui Área Vip e Android). Por data de fechamento.
	measure 'Apps Disponíveis' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "APP/Área VIP Disponível", "Área Vip Disponível", "Android Disponível" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 11cd415d-6f04-568e-a997-3657df4a5fb9

	/// Serviço Ajuste de Homologação da Área VIP e Aplicativo. Por data de fechamento.
	measure 'Ajustes App' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Ajuste App" ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 24dc700f-a134-5a1a-9201-0214903b85b8

	/// Serviço Homologação da Área Vip e Aplicativo. Por data de fechamento.
	measure 'Homologações App' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 05ebb341-1ba3-56ac-8c90-b288c5098ddb

	/// Tickets fechados dos serviços de homologação/ajuste (App e Guias) nas categorias que contam (lista do OKR 2026).
	measure 'Tickets Homologação' = CALCULATE( [Tickets Fechados], KEEPFILTERS( NOT ISBLANK( Helpdesk_Tickets[Categoria Homologação] ) ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 0d8a021d-81c7-5a61-bdf1-ed5e3f9a6fd6

	/// FOTO: dias desde a abertura do ticket ainda não resolvido até a última extração do Helpdesk (no total, o mais antigo).
	measure 'Dias em Aberto' = VAR ref = CALCULATE( MAX( Helpdesk_Tickets[data_extracao] ), REMOVEFILTERS( Helpdesk_Tickets ) ) RETURN MAXX( CALCULATETABLE( Helpdesk_Tickets, REMOVEFILTERS( Calendario ), KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] IN { "Homologação App", "Ajuste App" } ), KEEPFILTERS( NOT Helpdesk_Tickets[status] IN { "Resolvido", "Fechado", "Cancelado" } ) ), DATEDIFF( Helpdesk_Tickets[Data_Criacao_Ticket], ref, DAY ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 43c1eeeb-b4b1-5ee0-858c-49021cd72c13

	/// FOTO: homologações e ajustes do App ainda não resolvidos (ignora o Período).
	measure 'Tickets em Aberto (App)' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Calendario ), KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] IN { "Homologação App", "Ajuste App" } ), KEEPFILTERS( NOT Helpdesk_Tickets[status] IN { "Resolvido", "Fechado", "Cancelado" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 9c8ebd57-dac0-5825-ad51-0db6abf14a50

	/// Média de dias da criação até a resolução de todas as entregas (cada ticket pesa igual).
	measure 'Média de Dias das Entregas' = CALCULATE( [Média de Dias até a Resolução], KEEPFILTERS( NOT ISBLANK( Helpdesk_Tickets[Tipo de Entrega] ) ) )
		formatString: 0.00
		displayFolder: Homologação
		lineageTag: 04873034-8173-53e6-a065-f52525207ef5

	/// Entregas (tickets fechados) de Android, Apple e Área VIP no período (coluna Tipo de Entrega).
	measure 'Entregas de App' = CALCULATE( [Tickets Fechados], KEEPFILTERS( NOT ISBLANK( Helpdesk_Tickets[Tipo de Entrega] ) ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 8b2ca79a-bdb2-5c78-8f15-b3e4099738fe

	/// Soma dos campos de alteração de receita do ticket (vazio = ticket sem alteração; usado na lista).
	measure 'Valor Alterado (ticket)' = VAR v = SUMX( Helpdesk_Tickets, COALESCE( Helpdesk_Tickets[Desconto Mensalidade], 0 ) + COALESCE( Helpdesk_Tickets[Isencao Mensalidade], 0 ) + COALESCE( Helpdesk_Tickets[Isencao Aviso], 0 ) + COALESCE( Helpdesk_Tickets[Reducao Mensalidade], 0 ) + COALESCE( Helpdesk_Tickets[Aumento Mensalidade], 0 ) + COALESCE( Helpdesk_Tickets[Estorno Total], 0 ) + COALESCE( Helpdesk_Tickets[Boletos Cancelados], 0 ) ) RETURN IF( v <> 0, v )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 752b1e82-7939-5261-84f5-af278de0a476

	/// Quais alterações de receita o ticket tem (uma coluna só na lista, no lugar de uma coluna por tipo).
	measure 'Alterações do Ticket' = VAR s = IF( SUM( Helpdesk_Tickets[Desconto Mensalidade] ) <> 0, ", Desconto" ) & IF( SUM( Helpdesk_Tickets[Isencao Mensalidade] ) <> 0, ", Isenção de mensalidade" ) & IF( SUM( Helpdesk_Tickets[Isencao Aviso] ) <> 0, ", Isenção de aviso" ) & IF( SUM( Helpdesk_Tickets[Reducao Mensalidade] ) <> 0, ", Redução" ) & IF( SUM( Helpdesk_Tickets[Aumento Mensalidade] ) <> 0, ", Aumento" ) & IF( SUM( Helpdesk_Tickets[Estorno Total] ) <> 0, ", Estorno" ) & IF( SUM( Helpdesk_Tickets[Boletos Cancelados] ) <> 0, ", Boletos" ) RETURN IF( HASONEVALUE( Helpdesk_Tickets[id] ) && s <> "", MID( s, 3, 300 ) )
		displayFolder: Global
		lineageTag: 75f8d847-c8c8-5c42-92a6-cd05cb066586

	/// Áreas VIP disponibilizadas (Área Vip Disponível + a antiga APP/Área VIP Disponível, usada antes de set/2026). Por data de fechamento.
	measure 'Área VIP Disponível (App)' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "APP/Área VIP Disponível", "Área Vip Disponível" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 359d56c5-d95a-5494-aa1c-214cf01d423a

	/// Apps Android disponibilizados (categoria Android Disponível). Por data de fechamento.
	measure 'Android Disponível (App)' = CALCULATE( [Tickets Homologação], KEEPFILTERS( Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ), KEEPFILTERS( Helpdesk_Tickets[Categoria Homologação] IN { "Android Disponível" } ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: beb9eb0c-257e-5959-b485-124fbce0fddc

	/// Homologações + ajustes do App dos clientes da linha. Por data de fechamento.
	measure 'Tickets do App (cliente)' = [Homologações App (cliente)] + [Ajustes App (cliente)]
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 623fddf8-daae-5f9b-8731-68065387adc0

	/// [Ajustes App] dos clientes da linha (dCarteira[ID Legado] = ID Legado do Cliente do ticket). Por data de fechamento.
	measure 'Ajustes App (cliente)' = CALCULATE( [Ajustes App], TREATAS( VALUES( dCarteira[ID Legado] ), Helpdesk_Tickets[ID Legado do Cliente] ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 23a970e6-550e-5101-9de6-4447bbbde2e7

	/// [Homologações App] dos clientes da linha (dCarteira[ID Legado] = ID Legado do Cliente do ticket). Por data de fechamento.
	measure 'Homologações App (cliente)' = CALCULATE( [Homologações App], TREATAS( VALUES( dCarteira[ID Legado] ), Helpdesk_Tickets[ID Legado do Cliente] ) )
		formatString: #,0
		displayFolder: Homologação
		lineageTag: b8b7dde0-f468-5a32-93cf-29d47a880e96

	/// Tickets resolvidos até o SLA previsto do Helpdesk ÷ tickets fechados com SLA, nas categorias que contam. Por data de fechamento.
	measure '% SLA Homologação' = CALCULATE( [% no Prazo do SLA], KEEPFILTERS( NOT ISBLANK( Helpdesk_Tickets[Categoria Homologação] ) ) )
		formatString: 0.00%
		displayFolder: Homologação
		lineageTag: fe04e0be-57e9-5216-bff6-03e76a812e48

	/// CS do cliente no CRM no dia da live (lista de participantes, 1 linha por ticket). Medida para a lista seguir a data da live.
	measure 'Responsável do Cliente (Lives)' = IF( [Participantes (Lives)] = 1, COALESCE( CALCULATE( MAX( Helpdesk_Tickets[Responsável do Cliente] ), Helpdesk_Tickets[service] = "Live", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) ), "Sem responsável" ) )
		displayFolder: Lives
		lineageTag: 64a011d2-e706-5913-a353-7dc819cc292c

	/// ID (Cruzeiro) do cliente do ticket da Ouvidoria, por data de CRIAÇÃO (lista de atendimentos, 1 linha por ticket).
	measure 'ID do Cliente (Ouvidoria)' = IF( [Atendimentos Ouvidoria] = 1, VAR i = CALCULATE( MAX( Helpdesk_Tickets[ID Legado do Cliente] ), Helpdesk_Tickets[service] = "Ouvidoria", USERELATIONSHIP( Helpdesk_Tickets[Data_Criacao_Ticket], Calendario[Date] ) ) RETURN IF( ISBLANK( i ) || i = "", "—", i ) )
		displayFolder: Ouvidoria
		lineageTag: 786c83a9-1e9e-512c-8112-d95c76eb5df5

