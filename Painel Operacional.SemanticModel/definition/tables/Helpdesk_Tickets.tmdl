	column 'Live (data e tema)' = IF( Helpdesk_Tickets[service] = "Live", FORMAT( Helpdesk_Tickets[Data_Criacao_Ticket], "dd/mm/yy" ) & " · " & Helpdesk_Tickets[category] )
		dataType: string
		displayFolder: Lives
		lineageTag: bddd4645-bbfd-5404-9e28-2b65580d264e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data da Live' = IF( Helpdesk_Tickets[service] = "Live", Helpdesk_Tickets[Data_Criacao_Ticket] )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Lives
		lineageTag: da52a79b-4e70-5eda-bf8c-c597f559ef7f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dia da Semana da Live Nº' = IF( Helpdesk_Tickets[service] = "Live", WEEKDAY( Helpdesk_Tickets[Data_Criacao_Ticket], 2 ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Lives
		lineageTag: d387a34b-d3c6-5b36-943f-7526e434b3cb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dia da Semana da Live' = IF( Helpdesk_Tickets[service] = "Live", FORMAT( Helpdesk_Tickets[Data_Criacao_Ticket], "dddd" ) )
		dataType: string
		displayFolder: Lives
		lineageTag: 9e0676f7-2dfe-5159-bf98-7dd66cf5e463
		summarizeBy: none
		sortByColumn: 'Dia da Semana da Live Nº'

		annotation SummarizationSetBy = Automatic

	column 'Primeira Live do Cliente' = VAR c = Helpdesk_Tickets[id_client] RETURN IF( Helpdesk_Tickets[service] = "Live" && NOT ISBLANK( c ), MINX( FILTER( Helpdesk_Tickets, Helpdesk_Tickets[id_client] = c && Helpdesk_Tickets[service] = "Live" ), Helpdesk_Tickets[Data_Criacao_Ticket] ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Lives
		lineageTag: 50b0ab29-7c6d-5a54-8f3d-3922ca25e5d6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cliente Novo na Live' = Helpdesk_Tickets[service] = "Live" && NOT ISBLANK( Helpdesk_Tickets[Primeira Live do Cliente] ) && Helpdesk_Tickets[Data_Criacao_Ticket] = Helpdesk_Tickets[Primeira Live do Cliente]
		dataType: boolean
		isHidden
		displayFolder: Lives
		lineageTag: 924c314a-a85b-58fd-bd90-21ec4d32c15e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tempo de Espera (s)' = IFERROR( VALUE( Helpdesk_Tickets[chatWaitingTime] ), BLANK() )
		dataType: double
		isHidden
		formatString: 0
		displayFolder: Atendimento
		lineageTag: 1f62b9c9-f37b-5d7e-a532-c8cfd901de05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tempo de Atendimento (s)' = IFERROR( VALUE( Helpdesk_Tickets[chatTalkTime] ), BLANK() )
		dataType: double
		isHidden
		formatString: 0
		displayFolder: Atendimento
		lineageTag: 9533e863-61f2-55d8-b822-7d2ab1229085
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Canal = SWITCH( TRUE(), Helpdesk_Tickets[origin] IN { 5, 6 }, "Chat", Helpdesk_Tickets[origin] IN { 18, 23, 25 }, "WhatsApp", Helpdesk_Tickets[origin] = 9, "API / Assistente virtual", Helpdesk_Tickets[origin] IN { 3, 7 }, "E-mail", Helpdesk_Tickets[origin] IN { 1, 2 }, "Web", "Outros" )
		dataType: string
		displayFolder: Atendimento
		lineageTag: 1232e9f6-63c0-5b19-9f51-d5a5cfdaa8b0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Status SLA' = VAR r = Helpdesk_Tickets[Data_Resolucao_Ticket] + Helpdesk_Tickets[Hora_Resolucao_Ticket] VAR p = Helpdesk_Tickets[Data_SLA_Previsto] + Helpdesk_Tickets[Hora_SLA_Previsto] RETURN IF( ISBLANK( Helpdesk_Tickets[Data_Resolucao_Ticket] ) || ISBLANK( Helpdesk_Tickets[Data_SLA_Previsto] ), BLANK(), IF( r <= p, "No prazo", "Fora do prazo" ) )
		dataType: string
		displayFolder: SLA
		lineageTag: 91ac5c02-f9ba-58f0-aa1b-b66904e8db3f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Empresa = VAR o = TRIM( Helpdesk_Tickets[organization] ) RETURN IF( ISBLANK( o ) || o IN { "", "None", "Null", "Estrutura modelo" }, BLANK(), o )
		dataType: string
		displayFolder: Atendimento
		lineageTag: 5b432840-44bc-5246-80f9-46e0ab2edd18
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Email do Analista' = VAR n = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( LOWER( TRIM( Helpdesk_Tickets[owner] ) ), "á", "a" ), "à", "a" ), "â", "a" ), "ã", "a" ), "ä", "a" ), "é", "e" ), "è", "e" ), "ê", "e" ), "ë", "e" ), "í", "i" ), "ì", "i" ), "î", "i" ), "ï", "i" ), "ó", "o" ), "ò", "o" ), "ô", "o" ), "õ", "o" ), "ö", "o" ), "ú", "u" ), "ù", "u" ), "û", "u" ), "ü", "u" ), "ç", "c" ), "ñ", "n" ), "  ", " " ) VAR p = SUBSTITUTE( n, " ", "|" ) VAR curto = IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), n ) VAR e1 = IF( n = "", BLANK(), LOOKUPVALUE( dColaborador[email], dColaborador[Nome Normalizado], n, BLANK() ) ) RETURN IF( ISBLANK( e1 ) && n <> "", LOOKUPVALUE( dColaborador[email], dColaborador[Nome Curto Normalizado], curto, BLANK() ), e1 )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: 1fe5a943-1b9c-5173-bde5-27d12f330e2a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do Analista' = IF( ISBLANK( Helpdesk_Tickets[Email do Analista] ), IF( TRIM( Helpdesk_Tickets[owner] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], Helpdesk_Tickets[Email do Analista], dColaboradorMes[AnoMes], Helpdesk_Tickets[Mês da Composição], BLANK() ), "(sem equipe)" ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: 64510862-ddb1-5d7a-88eb-a2a738ebd97d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Setor do Analista' = LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], Helpdesk_Tickets[Email do Analista], dColaboradorMes[AnoMes], Helpdesk_Tickets[Mês da Composição], BLANK() )
		dataType: string
		displayFolder: Pessoa
		lineageTag: c31403d2-a1bd-5523-a759-bd50986280f4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Reunião Onboarding' = VAR fila = Helpdesk_Tickets[owner_team] VAR cat = Helpdesk_Tickets[category] VAR serv = Helpdesk_Tickets[service] RETURN SWITCH( TRUE(), serv = "Treinamento" && fila IN { "Treinamento", "Sucesso do Cliente" } && cat IN { "Checkout Alinhamento Inicial + configurações", "Checkout - Acompanhamento", "Checkout - Aplicativo e Área VIP", "Checkout - Configurações Iniciais", "Checkout - Departamentos", "Checkout - e-Continuo", "Checkout - Gestão de Processos", "Checkout - Kappa", "Checkout - Lista de Entregas", "Checkout - Método APLA", "Checkout - Retomada", "Checkout - AF Docs" }, "Checkout (reunião feita)", serv = "Treinamento" && fila IN { "Treinamento", "Sucesso do Cliente" } && cat IN { "Falta", "Remarcação" }, "Queda no treinamento", serv = "Agendamento" && fila = "Agendamento" && Helpdesk_Tickets[setor_ag_ouv] = "Consultoria" && cat IN { "Falta", "Remarcação", "Cancelamento de Treinamento" }, "Queda no agendamento" )
		dataType: string
		displayFolder: No Show
		lineageTag: b204aa89-ec28-57e5-9bb9-a729a7b3daf1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Responsável pela Reunião' = SWITCH( Helpdesk_Tickets[Reunião Onboarding], "Queda no agendamento", Helpdesk_Tickets[resp_cliente], "Queda no treinamento", Helpdesk_Tickets[owner], "Checkout (reunião feita)", Helpdesk_Tickets[owner] )
		dataType: string
		displayFolder: No Show
		lineageTag: 627819f3-cb12-5ed0-aee7-9431231fc3d8
