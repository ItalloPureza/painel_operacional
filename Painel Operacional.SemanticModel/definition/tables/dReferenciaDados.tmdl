	partition dReferenciaDados = calculated
		mode: import
		source =
				
				-- GERADO por scripts/saude_dados.py (REF_TELA + FONTES; estudo em docs/dados-ate-por-tela.md): a data da
				-- tabela principal de cada tela (extração > atualização > data do registro) e o registro mais recente.
				-- Calculada no refresh (sem RLS nem filtros).
				VAR _er1 = MAX ( 'Helpdesk_Tickets'[data_extracao] )
				VAR _ur1 = MAX ( 'Helpdesk_Tickets'[lastUpdate] )
				VAR _nr1 = MAXX ( Helpdesk_Tickets, Helpdesk_Tickets[Data_Criacao_Ticket] + Helpdesk_Tickets[Hora_Criacao_Ticket] )
				VAR _dr1 = COALESCE ( _er1, _ur1, _nr1 )
				VAR _cr1 = IF ( NOT ISBLANK ( _er1 ), "última extração", IF ( NOT ISBLANK ( _ur1 ), "última atualização", "última abertura" ) )
				VAR _kr1 = IF ( NOT ISBLANK ( _er1 ), "extração (data_extracao)", IF ( NOT ISBLANK ( _ur1 ), "atualização (lastUpdate)", "última abertura (data do registro)" ) )
				VAR _ior1 = MAXX ( Helpdesk_Tickets, Helpdesk_Tickets[id] )
				VAR _ir1 = MAXX ( FILTER ( Helpdesk_Tickets, Helpdesk_Tickets[id] = _ior1 ), "ticket nº " & Helpdesk_Tickets[id] & ", aberto em " & FORMAT ( Helpdesk_Tickets[Data_Criacao_Ticket] + Helpdesk_Tickets[Hora_Criacao_Ticket], "dd/mm/yy hh:nn" ) )
				VAR _er2 = MAX ( 'Helpdesk_Survey'[data_extracao] )
				VAR _nr2 = MAXX ( Helpdesk_Survey, Helpdesk_Survey[Data Avaliacao] )
				VAR _dr2 = COALESCE ( _er2, _nr2 )
				VAR _cr2 = IF ( NOT ISBLANK ( _er2 ), "última extração", "última avaliação" )
				VAR _kr2 = IF ( NOT ISBLANK ( _er2 ), "extração (data_extracao)", "última avaliação (data do registro)" )
				VAR _ior2 = MAXX ( Helpdesk_Survey, Helpdesk_Survey[Data Avaliacao] )
				VAR _idr2 = MAXX ( FILTER ( Helpdesk_Survey, Helpdesk_Survey[Data Avaliacao] = _ior2 ), Helpdesk_Survey[ticketId] )
				VAR _ir2 = MAXX ( FILTER ( Helpdesk_Survey, Helpdesk_Survey[Data Avaliacao] = _ior2 && Helpdesk_Survey[ticketId] = _idr2 ), "ticket nº " & Helpdesk_Survey[ticketId] & ", avaliado em " & FORMAT ( Helpdesk_Survey[Data Avaliacao], "dd/mm/yy" ) )
				VAR _er3 = MAX ( 'CRM_Backup_Diario'[Extracao] )
				VAR _nr3 = MAXX ( CRM_Backup_Diario, CRM_Backup_Diario[Periodo] )
				VAR _dr3 = COALESCE ( _er3, _nr3 )
				VAR _cr3 = IF ( NOT ISBLANK ( _er3 ), "última extração", "último retrato" )
				VAR _kr3 = IF ( NOT ISBLANK ( _er3 ), "extração (Extracao)", "último retrato (data do registro)" )
				VAR _ior3 = MAXX ( CRM_Backup_Diario, CRM_Backup_Diario[Periodo] )
				VAR _ir3 = "retrato de " & FORMAT ( _ior3, "dd/mm/yy" ) & " com " & FORMAT ( CALCULATE ( DISTINCTCOUNT ( CRM_Backup_Diario[Id_CRM] ), CRM_Backup_Diario[Periodo] = _ior3 ), "#,0" ) & " clientes"
				VAR _er4 = MAX ( 'Helpdesk_Cancelamentos'[data_extracao] )
				VAR _ur4 = MAX ( 'Helpdesk_Cancelamentos'[Data da Ultima Atualização] )
				VAR _nr4 = MAXX ( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Data de Fechamento] )
				VAR _dr4 = COALESCE ( _er4, _ur4, _nr4 )
				VAR _cr4 = IF ( NOT ISBLANK ( _er4 ), "última extração", IF ( NOT ISBLANK ( _ur4 ), "última atualização", "último fechamento" ) )
				VAR _kr4 = IF ( NOT ISBLANK ( _er4 ), "extração (data_extracao)", IF ( NOT ISBLANK ( _ur4 ), "atualização (Data da Ultima Atualização)", "último fechamento (data do registro)" ) )
				VAR _ior4 = MAXX ( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[id] )
				VAR _ir4 = MAXX ( FILTER ( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[id] = _ior4 ), "ticket nº " & Helpdesk_Cancelamentos[id] & ", aberto em " & FORMAT ( Helpdesk_Cancelamentos[Data de Criação], "dd/mm/yy" ) )
				VAR _er5 = MAX ( 'Helpdesk_Tickets'[data_extracao] )
				VAR _ur5 = MAX ( 'Helpdesk_Tickets'[lastUpdate] )
				VAR _nr5 = MAXX ( Helpdesk_Tickets, Helpdesk_Tickets[Data_Fechamento_Ticket] + Helpdesk_Tickets[Hora_Fechamento_Ticket] )
				VAR _dr5 = COALESCE ( _er5, _ur5, _nr5 )
				VAR _cr5 = IF ( NOT ISBLANK ( _er5 ), "última extração", IF ( NOT ISBLANK ( _ur5 ), "última atualização", "último fechamento" ) )
				VAR _kr5 = IF ( NOT ISBLANK ( _er5 ), "extração (data_extracao)", IF ( NOT ISBLANK ( _ur5 ), "atualização (lastUpdate)", "último fechamento (data do registro)" ) )
				VAR _ior5 = MAXX ( Helpdesk_Tickets, Helpdesk_Tickets[id] )
				VAR _ir5 = MAXX ( FILTER ( Helpdesk_Tickets, Helpdesk_Tickets[id] = _ior5 ), "ticket nº " & Helpdesk_Tickets[id] & ", aberto em " & FORMAT ( Helpdesk_Tickets[Data_Criacao_Ticket] + Helpdesk_Tickets[Hora_Criacao_Ticket], "dd/mm/yy hh:nn" ) )
				VAR _dx15 = MIN ( MAX ( CRM_Backup_Diario[Periodo] ), MAX ( Contratos_historico_contratos[periodo] ) )
				VAR _cx15 = "último dia com retrato do CRM e do sistema de contratos"
				VAR _ix15 = BLANK ()
				VAR _dx16 = MIN ( MAX ( CRM_Backup_Diario[Periodo] ), MAX ( Contratos_historico_contratos[periodo] ) )
				VAR _cx16 = "último dia com retrato do CRM e do sistema de contratos"
				VAR _ix16 = BLANK ()
				VAR _er6 = MAX ( 'Legado_Clientes'[Extracao] )
				VAR _dr6 = _er6
				VAR _cr6 = "última extração"
				VAR _kr6 = "extração (Extracao)"
				VAR _ior6 = MAXX ( Legado_Clientes, Legado_Clientes[Extracao] )
				VAR _ir6 = FORMAT ( COUNTROWS ( Legado_Clientes ), "#,0" ) & " clientes na consulta"
				VAR _er7 = MAX ( 'CRM_Atividades'[Extracao] )
				VAR _nr7 = MAXX ( CRM_Atividades, CRM_Atividades[Data_Resolucao] )
				VAR _dr7 = COALESCE ( _er7, _nr7 )
				VAR _cr7 = IF ( NOT ISBLANK ( _er7 ), "última extração", "última conclusão" )
				VAR _kr7 = IF ( NOT ISBLANK ( _er7 ), "extração (Extracao)", "última conclusão (data do registro)" )
				VAR _ior7 = MAXX ( CRM_Atividades, CRM_Atividades[Criado_em] )
				VAR _ir7 = MAXX ( FILTER ( CRM_Atividades, CRM_Atividades[Criado_em] = _ior7 ), "atividade " & CRM_Atividades[Tipo de Atividade] & ", criada em " & FORMAT ( CRM_Atividades[Criado_em], "dd/mm/yy hh:nn" ) )
				VAR _er8 = MAX ( 'Ligacoes_API'[data_extracao] )
				VAR _nr8 = MAXX ( Ligacoes_API, Ligacoes_API[Data_hora_inicio] )
				VAR _dr8 = COALESCE ( _er8, _nr8 )
				VAR _cr8 = IF ( NOT ISBLANK ( _er8 ), "última extração", "última ligação" )
				VAR _kr8 = IF ( NOT ISBLANK ( _er8 ), "extração (data_extracao)", "última ligação (data do registro)" )
				VAR _ior8 = MAXX ( Ligacoes_API, Ligacoes_API[Data_hora_inicio] )
				VAR _ir8 = MAXX ( FILTER ( Ligacoes_API, Ligacoes_API[Data_hora_inicio] = _ior8 ), "ligação de " & FORMAT ( Ligacoes_API[Data_hora_inicio], "dd/mm/yy hh:nn" ) & " (" & COALESCE ( Ligacoes_API[Responsável (Ramal)], "sem responsável" ) & ")" )
				VAR _er9 = MAX ( 'WhatsApp_Atendimentos'[Extracao] )
				VAR _nr9 = MAXX ( WhatsApp_Atendimentos, WhatsApp_Atendimentos[Abertura] )
				VAR _dr9 = COALESCE ( _er9, _nr9 )
				VAR _cr9 = IF ( NOT ISBLANK ( _er9 ), "última extração", "última abertura" )
				VAR _kr9 = IF ( NOT ISBLANK ( _er9 ), "extração (Extracao)", "última abertura (data do registro)" )
				VAR _ior9 = MAXX ( WhatsApp_Atendimentos, WhatsApp_Atendimentos[Abertura] )
				VAR _idr9 = MAXX ( FILTER ( WhatsApp_Atendimentos, WhatsApp_Atendimentos[Abertura] = _ior9 ), WhatsApp_Atendimentos[Ticket] )
				VAR _ir9 = MAXX ( FILTER ( WhatsApp_Atendimentos, WhatsApp_Atendimentos[Abertura] = _ior9 && WhatsApp_Atendimentos[Ticket] = _idr9 ), "ticket " & WhatsApp_Atendimentos[Ticket] & ", aberto em " & FORMAT ( WhatsApp_Atendimentos[Abertura], "dd/mm/yy hh:nn" ) )
				VAR _er10 = MAX ( 'WhatsApp_Envios'[Extracao] )
				VAR _nr10 = MAXX ( WhatsApp_Envios, WhatsApp_Envios[Enviado em] )
				VAR _dr10 = COALESCE ( _er10, _nr10 )
				VAR _cr10 = IF ( NOT ISBLANK ( _er10 ), "última extração", "último envio" )
				VAR _kr10 = IF ( NOT ISBLANK ( _er10 ), "extração (Extracao)", "último envio (data do registro)" )
				VAR _ior10 = MAXX ( WhatsApp_Envios, WhatsApp_Envios[Enviado em] )
				VAR _ir10 = MAXX ( FILTER ( WhatsApp_Envios, WhatsApp_Envios[Enviado em] = _ior10 ), "template " & WhatsApp_Envios[Template] & ", enviado em " & FORMAT ( WhatsApp_Envios[Enviado em], "dd/mm/yy hh:nn" ) )
				VAR _t =
				    UNION (
				        ROW ( "Pagina", "pg_agendamento_01", "Tela", "Lives - Participação", "Ordem", 17, "Fonte", "Tickets (Helpdesk)", "Data", _dr1, "Quando", IF ( ISBLANK ( _dr1 ), BLANK (), FORMAT ( _dr1, IF ( _dr1 = INT ( _dr1 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr1 ), BLANK (), _cr1 & " dos tickets (Helpdesk)" & IF ( NOT ISBLANK ( _ir1 ), UNICHAR ( 10 ) & "mais recente: " & _ir1 ) ) ),
				        ROW ( "Pagina", "pg_agendamento_02", "Tela", "Lives - Desempenho das Lives", "Ordem", 18, "Fonte", "Tickets (Helpdesk)", "Data", _dr1, "Quando", IF ( ISBLANK ( _dr1 ), BLANK (), FORMAT ( _dr1, IF ( _dr1 = INT ( _dr1 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr1 ), BLANK (), _cr1 & " dos tickets (Helpdesk)" & IF ( NOT ISBLANK ( _ir1 ), UNICHAR ( 10 ) & "mais recente: " & _ir1 ) ) ),
				        ROW ( "Pagina", "pg_agendamento_03", "Tela", "Lives - Clientes", "Ordem", 19, "Fonte", "Tickets (Helpdesk)", "Data", _dr1, "Quando", IF ( ISBLANK ( _dr1 ), BLANK (), FORMAT ( _dr1, IF ( _dr1 = INT ( _dr1 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr1 ), BLANK (), _cr1 & " dos tickets (Helpdesk)" & IF ( NOT ISBLANK ( _ir1 ), UNICHAR ( 10 ) & "mais recente: " & _ir1 ) ) ),
				        ROW ( "Pagina", "pg_agendamento_04", "Tela", "Lives - CSAT", "Ordem", 20, "Fonte", "Pesquisas de satisfação (Helpdesk)", "Data", _dr2, "Quando", IF ( ISBLANK ( _dr2 ), BLANK (), FORMAT ( _dr2, IF ( _dr2 = INT ( _dr2 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr2 ), BLANK (), _cr2 & " das avaliações (Helpdesk)" & IF ( NOT ISBLANK ( _ir2 ), UNICHAR ( 10 ) & "mais recente: " & _ir2 ) ) ),
				        ROW ( "Pagina", "pg_gerencia_01", "Tela", "Gerência - Cohort AF", "Ordem", 1, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_gerencia_02", "Tela", "Gerência - Cohort KP", "Ordem", 2, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_gerencia_03", "Tela", "Gerência - Inativações", "Ordem", 3, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_gerencia_04", "Tela", "Gerência - Resumo Ongoing", "Ordem", 4, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_gerencia_05", "Tela", "Gerência - Resumo Onboarding", "Ordem", 5, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_gerencia_06", "Tela", "Gerência - Resumo Alfa e Kappa", "Ordem", 6, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_global_01", "Tela", "Global - Cancelamento AF", "Ordem", 7, "Fonte", "Cancelamentos (Helpdesk)", "Data", _dr4, "Quando", IF ( ISBLANK ( _dr4 ), BLANK (), FORMAT ( _dr4, IF ( _dr4 = INT ( _dr4 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr4 ), BLANK (), _cr4 & " dos cancelamentos (Helpdesk)" & IF ( NOT ISBLANK ( _ir4 ), UNICHAR ( 10 ) & "mais recente: " & _ir4 ) ) ),
				        ROW ( "Pagina", "pg_global_02", "Tela", "Global - Cancelamento KP", "Ordem", 8, "Fonte", "Cancelamentos (Helpdesk)", "Data", _dr4, "Quando", IF ( ISBLANK ( _dr4 ), BLANK (), FORMAT ( _dr4, IF ( _dr4 = INT ( _dr4 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr4 ), BLANK (), _cr4 & " dos cancelamentos (Helpdesk)" & IF ( NOT ISBLANK ( _ir4 ), UNICHAR ( 10 ) & "mais recente: " & _ir4 ) ) ),
				        ROW ( "Pagina", "pg_global_03", "Tela", "Global - Alteração de Receita", "Ordem", 10, "Fonte", "Tickets (Helpdesk)", "Data", _dr5, "Quando", IF ( ISBLANK ( _dr5 ), BLANK (), FORMAT ( _dr5, IF ( _dr5 = INT ( _dr5 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr5 ), BLANK (), _cr5 & " dos tickets (Helpdesk)" & IF ( NOT ISBLANK ( _ir5 ), UNICHAR ( 10 ) & "mais recente: " & _ir5 ) ) ),
				        ROW ( "Pagina", "pg_global_04", "Tela", "Global - Idade dos Clientes", "Ordem", 11, "Fonte", "Cancelamentos (Helpdesk)", "Data", _dr4, "Quando", IF ( ISBLANK ( _dr4 ), BLANK (), FORMAT ( _dr4, IF ( _dr4 = INT ( _dr4 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr4 ), BLANK (), _cr4 & " dos cancelamentos (Helpdesk)" & IF ( NOT ISBLANK ( _ir4 ), UNICHAR ( 10 ) & "mais recente: " & _ir4 ) ) ),
				        ROW ( "Pagina", "pg_global_05", "Tela", "Global - Carteiras", "Ordem", 12, "Fonte", "CRM + Contratos", "Data", _dx15, "Quando", IF ( ISBLANK ( _dx15 ), BLANK (), FORMAT ( _dx15, IF ( _dx15 = INT ( _dx15 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dx15 ), BLANK (), _cx15 ) ),
				        ROW ( "Pagina", "pg_global_06", "Tela", "Global - Carteiras - Clientes", "Ordem", 13, "Fonte", "CRM + Contratos", "Data", _dx16, "Quando", IF ( ISBLANK ( _dx16 ), BLANK (), FORMAT ( _dx16, IF ( _dx16 = INT ( _dx16 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dx16 ), BLANK (), _cx16 ) ),
				        ROW ( "Pagina", "pg_global_07", "Tela", "Global - TTFV", "Ordem", 14, "Fonte", "Carteira - retrato diário (CRM)", "Data", _dr3, "Quando", IF ( ISBLANK ( _dr3 ), BLANK (), FORMAT ( _dr3, IF ( _dr3 = INT ( _dr3 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr3 ), BLANK (), _cr3 & " do retrato (CRM)" & IF ( NOT ISBLANK ( _ir3 ), UNICHAR ( 10 ) & "mais recente: " & _ir3 ) ) ),
				        ROW ( "Pagina", "pg_global_08", "Tela", "Global - Clientes do Legado", "Ordem", 15, "Fonte", "Clientes - API do sistema legado", "Data", _dr6, "Quando", IF ( ISBLANK ( _dr6 ), BLANK (), FORMAT ( _dr6, IF ( _dr6 = INT ( _dr6 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr6 ), BLANK (), _cr6 & " da API do sistema legado" & IF ( NOT ISBLANK ( _ir6 ), UNICHAR ( 10 ) & "mais recente: " & _ir6 ) ) ),
				        ROW ( "Pagina", "pg_global_09", "Tela", "Global - Migrações dos Clientes", "Ordem", 16, "Fonte", "Atividades (CRM)", "Data", _dr7, "Quando", IF ( ISBLANK ( _dr7 ), BLANK (), FORMAT ( _dr7, IF ( _dr7 = INT ( _dr7 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr7 ), BLANK (), _cr7 & " das atividades (CRM)" & IF ( NOT ISBLANK ( _ir7 ), UNICHAR ( 10 ) & "mais recente: " & _ir7 ) ) ),
				        ROW ( "Pagina", "pg_global_10", "Tela", "Global - KP por Setor", "Ordem", 9, "Fonte", "Cancelamentos (Helpdesk)", "Data", _dr4, "Quando", IF ( ISBLANK ( _dr4 ), BLANK (), FORMAT ( _dr4, IF ( _dr4 = INT ( _dr4 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr4 ), BLANK (), _cr4 & " dos cancelamentos (Helpdesk)" & IF ( NOT ISBLANK ( _ir4 ), UNICHAR ( 10 ) & "mais recente: " & _ir4 ) ) ),
				        ROW ( "Pagina", "pg_homologacao_01", "Tela", "Homologação - App", "Ordem", 52, "Fonte", "Tickets (Helpdesk)", "Data", _dr5, "Quando", IF ( ISBLANK ( _dr5 ), BLANK (), FORMAT ( _dr5, IF ( _dr5 = INT ( _dr5 ), "dd/mm/yy", "dd/mm/yy hh:nn" ) ) ), "Item", IF ( ISBLANK ( _dr5 ), BLANK (), _cr5 & " dos tickets (Helpdesk)" & IF ( NOT ISBLANK ( _ir5 ), UNICHAR ( 10 ) & "mais recente: " & _ir5 ) ) ),
