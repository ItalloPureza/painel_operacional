	column 'Outros Serviços' = fMigracoesClientes[Tickets] - fMigracoesClientes[Treinamento] - fMigracoesClientes[Sucesso do Cliente] - fMigracoesClientes[Suporte] - fMigracoesClientes[Homologação]
		dataType: int64
		formatString: #,0
		displayFolder: Migrações dos Clientes
		lineageTag: ac3fae10-b327-5cc1-b500-491351e1d9a6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Homologação do App' = IF( fMigracoesClientes[Homologações do App] > 0, "Sim", "Não" )
		dataType: string
		displayFolder: Migrações dos Clientes
		lineageTag: 394f865d-87cb-5d83-ad08-28169c704b43
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & fMigracoesClientes[ID] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: 63585c23-2f7d-5016-b6ad-884c00ac07d8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ do Cliente (busca)' = VAR c = LOOKUPVALUE( dBuscaCliente[CNPJ], dBuscaCliente[ID], TRIM( "" & fMigracoesClientes[ID] ), BLANK() ) RETURN IF( c = "", BLANK(), c )
		dataType: string
		displayFolder: Cliente
		lineageTag: dc77cfab-f6dd-5fd6-97cc-440856e36ab7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fMigracoesClientes = calculated
		mode: import
		source =
				
				-- Uma linha por migração (Ativado/Não ativado) de cliente registrado em 2026, com os tickets do cliente
				-- criados do registro até a migração. Gerado por scripts/gerar_migracoes.py.
				VAR base =
				    FILTER(
				        CRM_Atividades,
				        CRM_Atividades[Tipo de Atividade] = "Análise de Migração"
				            && CRM_Atividades[Categoria] IN { "Migração - Ativado", "Migração - Não Ativado" }
				            && NOT ISBLANK( CRM_Atividades[Data_Resolucao] )
				            && CRM_Atividades[Apagada_status] <> TRUE()
				            && CRM_Atividades[Registro do Cliente] >= DATE( 2026, 1, 1 )
				    )
				VAR mig =
				    SELECTCOLUMNS(
				        base,
				        "ID", TRIM( CRM_Atividades[ID_Alfa] ),
				        "Cliente", CRM_Atividades[Cliente_Nome_Fantasia],
				        "Situação da Migração", IF( CRM_Atividades[Categoria] = "Migração - Ativado", "Ativado", "Não ativado" ),
				        "Data da Migração", VAR d = CRM_Atividades[Data_Resolucao] RETURN DATE( YEAR( d ), MONTH( d ), DAY( d ) ),
				        "Registro", CRM_Atividades[Registro do Cliente],
				        "Dias até Migrar", CRM_Atividades[Dias até a Migração],
				        "Responsável pelo Cliente", CRM_Atividades[Responsavel_Pelo_Cliente],
				        "Equipe do Responsável", CRM_Atividades[Equipe do Responsável pelo Cliente]
				    )
				RETURN
				    ADDCOLUMNS(
				        mig,
				        "Tickets", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "" ) + 0,
				        "Treinamento", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", TRIM( Helpdesk_Tickets[service] ) = "Treinamento" ) + 0,
				        "Sucesso do Cliente", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", TRIM( Helpdesk_Tickets[service] ) = "Sucesso do Cliente" ) + 0,
				        "Consultoria: Sucesso", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", Helpdesk_Tickets[Resultado da Consultoria] = "Sucesso" ) + 0,
				        "Consultoria: Falha", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", Helpdesk_Tickets[Resultado da Consultoria] = "Falha" ) + 0,
				        "Consultoria: Outros", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", Helpdesk_Tickets[Resultado da Consultoria] = "Outros" ) + 0,
				        "Suporte", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", TRIM( Helpdesk_Tickets[service] ) IN { "Suporte Técnico" } ) + 0,
				        "Homologação", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", TRIM( Helpdesk_Tickets[service] ) IN { "Homologação da Área Vip e Aplicativo", "Ajuste de Homologação da Área VIP e Aplicativo", "Homologação de Guias do e-Contínuo", "Ajuste de Homologação de Guias" } ) + 0,
				        "Homologações do App", VAR i = [ID] VAR r = [Registro] VAR f = [Data da Migração] RETURN CALCULATE( COUNTROWS( Helpdesk_Tickets ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[ID Legado do Cliente] = i, Helpdesk_Tickets[Data_Criacao_Ticket] >= r, Helpdesk_Tickets[Data_Criacao_Ticket] < f + 1, NOT ISBLANK( Helpdesk_Tickets[owner] ) && Helpdesk_Tickets[owner] <> "", Helpdesk_Tickets[Serviço Homologação] = "Homologação App" ) + 0
				    )

