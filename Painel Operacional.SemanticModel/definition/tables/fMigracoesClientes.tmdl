table fMigracoesClientes
	lineageTag: 1f785488-088c-5cdf-ae2b-48cc0bc35e27

	/// Média de dias do registro do cliente até a migração. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Dias até Migrar (média)' = AVERAGE( fMigracoesClientes[Dias até Migrar] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: dc02ffd5-4c11-58b4-93cf-d1b21558b72e

	/// Migrados SEM ticket de homologação do App entre o registro e a migração — conferência da regra. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Migrados sem Homologação do App' = CALCULATE( COUNTROWS( fMigracoesClientes ), fMigracoesClientes[Homologação do App] = "Não" )
		formatString: #,0
		displayFolder: Migrações dos Clientes
		lineageTag: 636e740e-96e4-5738-8fff-a02b55c29173

	/// Migrados com pelo menos um ticket do serviço Homologação da Área Vip e Aplicativo entre o registro e a migração ÷ migrados (regra: não migra sem homologação do App). Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure '% Migrados com Homologação do App' = DIVIDE( CALCULATE( COUNTROWS( fMigracoesClientes ), fMigracoesClientes[Homologação do App] = "Sim" ), [Clientes Migrados] )
		formatString: 0.00%
		displayFolder: Migrações dos Clientes
		lineageTag: 34cb5888-cb40-5f73-b70b-90ce333f064f

	/// Média dos tickets dos demais serviços (Financeiro, Cancelamento, Comercial etc.). Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Outros Serviços por Migrado (média)' = AVERAGE( fMigracoesClientes[Outros Serviços] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: 0f78b74f-e197-5087-a92a-62bc8f0f5877

	/// Média de tickets de homologação (App e Guias, com os ajustes) por cliente migrado. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Homologação por Migrado (média)' = AVERAGE( fMigracoesClientes[Homologação] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: 68680073-6916-52ea-a6b5-9b65f1ca0712

	/// Média de tickets do Suporte Técnico por cliente migrado. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Suporte por Migrado (média)' = AVERAGE( fMigracoesClientes[Suporte] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: 4d544f25-cba0-52c0-a661-cfaa4ac66854

	/// Média dos demais tickets de consultoria (agendamento, confirmação, tira-dúvidas, dispensa etc.). Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Outros na Consultoria (média)' = AVERAGE( fMigracoesClientes[Consultoria: Outros] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: 16aaee43-4161-56dc-8537-7f90c55047eb

	/// Média de tickets de consultoria com falha: falta, remarcação, tentativa de contato, ongoing sem contato. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Falhas na Consultoria (média)' = AVERAGE( fMigracoesClientes[Consultoria: Falha] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: 5e75927e-2e99-5655-84eb-acb25dbf8dbf

	/// Média de tickets de consultoria (Treinamento + Sucesso do Cliente) com sucesso: checkout, tratativa, contato efetivo, finalização, formalização. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Sucessos na Consultoria (média)' = AVERAGE( fMigracoesClientes[Consultoria: Sucesso] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: 24f6d379-737b-5a0a-b4ad-6b3773139a56

	/// Média de tickets (todos os serviços) por cliente migrado. Clientes registrados em 2026; tickets criados do registro até a migração. Pela data da MIGRAÇÃO.
	measure 'Tickets por Migrado (média)' = AVERAGE( fMigracoesClientes[Tickets] )
		formatString: 0.00
		displayFolder: Migrações dos Clientes
		lineageTag: a24ea2df-7427-5561-a1ff-1fd4256e5aa3

	/// Migrações concluídas (Ativado + Não ativado) de clientes registrados em 2026. Pela data da MIGRAÇÃO.
	measure 'Clientes Migrados' = COUNTROWS( fMigracoesClientes )
		formatString: #,0
		displayFolder: Migrações dos Clientes
		lineageTag: d84a622e-191d-5c47-aaaf-fa1b697e531f

