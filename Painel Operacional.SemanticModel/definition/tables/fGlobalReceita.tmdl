table fGlobalReceita
	lineageTag: 11170ad4-ab78-57d5-8d4a-a03f7d45f114

	/// Cancelamento + negociação recorrente + não recorrente — Perda de Receita - Total do OKR 2026.
	measure 'Perda de Receita Total' = [Perda por Cancelamento] + [Perda por Negociação (Recorrente)] + [Perda por Negociação (Não Recorrente)]
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: f5f4eebf-f42e-5297-8133-81bba05be3a9

	/// Soma dos campos de alteração de receita no contexto.
	measure 'Valor Alterado' = SUM( fGlobalReceita[Valor] )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 54c8efa8-626f-5463-977d-86df947f506c

	/// Aumento de mensalidade dos tickets, pelo fechamento.
	measure 'Aumento de Mensalidade' = CALCULATE( SUM( fGlobalReceita[Valor] ), KEEPFILTERS( fGlobalReceita[Tipo de Alteração] IN { "Aumento de mensalidade" } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 9c760120-c043-5531-8dc5-b4d067ae3c1b

	/// Redução de mensalidade dos tickets, pelo fechamento.
	measure 'Perda por Negociação (Recorrente)' = CALCULATE( SUM( fGlobalReceita[Valor] ), KEEPFILTERS( fGlobalReceita[Tipo de Alteração] IN { "Redução de mensalidade" } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: a4909e21-52f3-5a48-b37b-97e444498182

	/// Desconto + isenção de mensalidade + isenção de aviso prévio dos tickets, pelo fechamento (Perda de Receita).
	measure 'Perda por Negociação (Não Recorrente)' = CALCULATE( SUM( fGlobalReceita[Valor] ), KEEPFILTERS( fGlobalReceita[Tipo de Alteração] IN { "Desconto de mensalidade", "Isenção de mensalidade", "Isenção de aviso prévio" } ) )
		formatString: \R$ #,0.00
		displayFolder: Global
		lineageTag: 57cbb97f-fc62-589f-b900-996aac60dcb2

	column Data
		formatString: dd/mm/yy
		lineageTag: 31af71f9-4661-52ef-8930-e79095f9d6bb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Data]

		annotation SummarizationSetBy = Automatic

