	column Tickets
		formatString: #,0
		lineageTag: 0a07c191-8ec8-5e60-bf5b-9c38c35fdd91
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tickets]

		annotation SummarizationSetBy = Automatic

	partition fGlobalReceita = calculated
		mode: import
		source =
				
				-- Resumo das alterações de receita dos tickets (campos do Helpdesk) por dia de FECHAMENTO, sistema, área e
				-- tipo. Calculada no refresh, fora do RLS (total da empresa para todos). Gerado por gerar_global.py.
				VAR t = FILTER( Helpdesk_Tickets, NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ) )
				VAR linhas = UNION(
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Desconto Mensalidade] ) && Helpdesk_Tickets[Desconto Mensalidade] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Desconto de mensalidade", "@valor", Helpdesk_Tickets[Desconto Mensalidade] ),
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Isencao Mensalidade] ) && Helpdesk_Tickets[Isencao Mensalidade] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Isenção de mensalidade", "@valor", Helpdesk_Tickets[Isencao Mensalidade] ),
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Isencao Aviso] ) && Helpdesk_Tickets[Isencao Aviso] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Isenção de aviso prévio", "@valor", Helpdesk_Tickets[Isencao Aviso] ),
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Reducao Mensalidade] ) && Helpdesk_Tickets[Reducao Mensalidade] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Redução de mensalidade", "@valor", Helpdesk_Tickets[Reducao Mensalidade] ),
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Aumento Mensalidade] ) && Helpdesk_Tickets[Aumento Mensalidade] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Aumento de mensalidade", "@valor", Helpdesk_Tickets[Aumento Mensalidade] ),
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Estorno Total] ) && Helpdesk_Tickets[Estorno Total] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Estorno total", "@valor", Helpdesk_Tickets[Estorno Total] ),
				    SELECTCOLUMNS( FILTER( t, NOT ISBLANK( Helpdesk_Tickets[Boletos Cancelados] ) && Helpdesk_Tickets[Boletos Cancelados] <> 0 ), "@data", DATE( YEAR( Helpdesk_Tickets[Data_Fechamento_Ticket] ), MONTH( Helpdesk_Tickets[Data_Fechamento_Ticket] ), DAY( Helpdesk_Tickets[Data_Fechamento_Ticket] ) ), "@sistema", Helpdesk_Tickets[Sistema], "@area", Helpdesk_Tickets[area_responsavel], "@tipo", "Boletos cancelados", "@valor", Helpdesk_Tickets[Boletos Cancelados] ) )
				VAR g = GROUPBY( linhas, [@data], [@sistema], [@area], [@tipo],
				    "@valor", SUMX( CURRENTGROUP(), [@valor] ), "@qtd", SUMX( CURRENTGROUP(), 1 ) )
				RETURN
				    SELECTCOLUMNS( g, "Data", [@data], "Sistema", [@sistema], "Área Responsável", [@area], "Tipo de Alteração", [@tipo], "Valor", [@valor], "Tickets", [@qtd] )

