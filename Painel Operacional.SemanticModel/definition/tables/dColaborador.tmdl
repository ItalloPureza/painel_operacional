	/// Clientes Alfa (Ativo/Bloqueado) na fase da jornada Tratativa Cancelamento no último retrato do mês.
	measure 'Clientes em Tratativa de Cancelamento (resumo Onboarding)' = CALCULATE( [Clientes na Carteira (no dia)], CRM_Backup_Diario[Fase_Jornada] = "Tratativa Cancelamento", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 5d4f80a9-5d81-5d06-8152-78a53a2e3996

	/// Clientes Alfa (Ativo/Bloqueado) na fase da jornada Alinhamento no último retrato do mês, na carteira dos CS.
	measure 'Clientes em Alinhamento Inicial (resumo Onboarding)' = CALCULATE( [Clientes na Carteira (no dia)], CRM_Backup_Diario[Fase_Jornada] = "Alinhamento", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) )
		formatString: #,0
