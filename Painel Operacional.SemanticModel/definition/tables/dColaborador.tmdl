	/// 1ª camada: MRR revertido - (descontos + reduções) da pessoa.
	measure 'Saldo após Descontos e Reduções (por pessoa)' = VAR m = [MRR Revertido (por pessoa)] VAR c = [Descontos e Reduções Concedidos (por pessoa)] RETURN IF( NOT ISBLANK( m ) || NOT ISBLANK( c ), m - c )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: dc715ac6-3a56-5935-a200-2b7f3f7cd83f

	/// 2ª camada: saldo após descontos e reduções - isenções (mensalidade + aviso prévio) da pessoa (22/10/2026).
	measure 'Total Final da Reversão (por pessoa)' = VAR s = [Saldo após Descontos e Reduções (por pessoa)] VAR i = [Isenções Concedidas (por pessoa)] RETURN IF( NOT ISBLANK( s ) || NOT ISBLANK( i ), s - i )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: 080a5106-6c1a-51a0-8ca7-1383eae91ef2

	/// [Descontos e Reduções Concedidos] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'Descontos e Reduções Concedidos (por pessoa)' = CALCULATE( [Descontos e Reduções Concedidos], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), fConcessoes[Email do Responsável], fConcessoes[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: 8c4c6fd6-eef9-5f04-8c75-f3fd7f75febc

	/// [Isenções Concedidas] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'Isenções Concedidas (por pessoa)' = CALCULATE( [Isenções Concedidas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), fConcessoes[Email do Responsável], fConcessoes[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: fe855dac-9ce7-54c2-9e3c-cf78a06b1bee

	/// [Isenções de Aviso Prévio Concedidas] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'Isenções de Aviso Prévio Concedidas (por pessoa)' = CALCULATE( [Isenções de Aviso Prévio Concedidas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), fConcessoes[Email do Responsável], fConcessoes[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: af5a4f05-ddee-5b1c-9e2d-aaa2ea5c71fa

	/// [Isenções de Mensalidade Concedidas] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'Isenções de Mensalidade Concedidas (por pessoa)' = CALCULATE( [Isenções de Mensalidade Concedidas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), fConcessoes[Email do Responsável], fConcessoes[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: 8e85f483-2f6e-56a9-879a-f4cd70364525

	/// [Reduções Concedidas] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'Reduções Concedidas (por pessoa)' = CALCULATE( [Reduções Concedidas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), fConcessoes[Email do Responsável], fConcessoes[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: d7b30e6e-63f7-5926-9ea5-ca581967e679

	/// [Descontos Concedidos] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'Descontos Concedidos (por pessoa)' = CALCULATE( [Descontos Concedidos], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), fConcessoes[Email do Responsável], fConcessoes[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: 2375c5ce-eef7-5140-9cbf-6b6a04e30836

	/// [MRR Revertido] das pessoas em contexto no dColaboradorMes (tela Reversão × Concessões; cada evento pela equipe/setor da pessoa NO MÊS do evento).
	measure 'MRR Revertido (por pessoa)' = CALCULATE( [MRR Revertido], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: 346e12a0-25a3-546f-a84a-e2da03d57bc2

	/// Revertidos ÷ (efetivados + revertidos) da pessoa. Mês mais recente do período; cada evento pela equipe/setor da pessoa NO MÊS do evento.
	measure '% Revertidos no Mês (por pessoa)' = DIVIDE( [Cancelamentos Revertidos no Mês (por pessoa)], [Cancelamentos Efetivados no Mês (por pessoa)] + [Cancelamentos Revertidos no Mês (por pessoa)] )
		formatString: 0.00%
		displayFolder: Por pessoa
		lineageTag: dda5d504-55d8-53f2-adf8-0ea317a30a5a

	/// Pedidos revertidos em que a pessoa é o treinador. Mês mais recente do período; cada evento pela equipe/setor da pessoa NO MÊS do evento.
	measure 'Cancelamentos Revertidos no Mês (por pessoa)' = VAR _fim = MIN( MAX( Calendario[Date] ), TODAY() ) RETURN CALCULATE( [Cancelamentos Revertidos], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ), KEEPFILTERS( FILTER( ALL( Calendario[Date] ), Calendario[Date] >= DATE( YEAR( _fim ), MONTH( _fim ), 1 ) && Calendario[Date] <= _fim ) ) )
		formatString: #,0
		displayFolder: Por pessoa
		lineageTag: b55c36f0-4525-58aa-8d4d-385d4ff8bb87

	/// Mensalidade dos cancelamentos efetivados em que a pessoa é o treinador. Mês mais recente do período; cada evento pela equipe/setor da pessoa NO MÊS do evento.
	measure 'R$ Cancelado no Mês (por pessoa)' = VAR _fim = MIN( MAX( Calendario[Date] ), TODAY() ) RETURN CALCULATE( [R$ Cancelado], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ), KEEPFILTERS( FILTER( ALL( Calendario[Date] ), Calendario[Date] >= DATE( YEAR( _fim ), MONTH( _fim ), 1 ) && Calendario[Date] <= _fim ) ) )
		formatString: \R$ #,0.00
		displayFolder: Por pessoa
		lineageTag: 6940e890-b441-5106-bd0b-cf77c70316a2

	/// Cancelamentos efetivados ÷ clientes KP no início do mês da pessoa. Mês mais recente do período; cada evento pela equipe/setor da pessoa NO MÊS do evento.
	measure '% Cancelamento KP no Mês (por pessoa)' = DIVIDE( [Cancelamentos Efetivados no Mês (por pessoa)], [Clientes KP no Início do Mês (por pessoa)] )
		formatString: 0.00%
		displayFolder: Por pessoa
		lineageTag: 47c603f7-3a2e-5c65-8834-51fd0a675b49

	/// Cancelamentos efetivados em que a pessoa é o treinador (área e sistema da tela). Mês mais recente do período; cada evento pela equipe/setor da pessoa NO MÊS do evento.
	measure 'Cancelamentos Efetivados no Mês (por pessoa)' = VAR _fim = MIN( MAX( Calendario[Date] ), TODAY() ) RETURN CALCULATE( [Cancelamentos Efetivados], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ), KEEPFILTERS( FILTER( ALL( Calendario[Date] ), Calendario[Date] >= DATE( YEAR( _fim ), MONTH( _fim ), 1 ) && Calendario[Date] <= _fim ) ) )
		formatString: #,0
		displayFolder: Por pessoa
		lineageTag: 27f97699-d026-5619-acec-2e7e214d7dc2

	/// Clientes KP da carteira da pessoa no 1º retrato do mês (tela Cancelamento KP). Mês mais recente do período; cada evento pela equipe/setor da pessoa NO MÊS do evento.
	measure 'Clientes KP no Início do Mês (por pessoa)' = VAR _fim = MIN( MAX( Calendario[Date] ), TODAY() ) RETURN CALCULATE( [Clientes KP no Início do Mês (área)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ), KEEPFILTERS( FILTER( ALL( Calendario[Date] ), Calendario[Date] >= DATE( YEAR( _fim ), MONTH( _fim ), 1 ) && Calendario[Date] <= _fim ) ) )
		formatString: #,0
		displayFolder: Por pessoa
		lineageTag: ceb9e890-0524-5214-bddd-0684c37d14a3

	/// Pedidos de cancelamento do Kappa efetivados (data de fechamento) em que o treinador é da equipe.
	measure 'Cancelamentos Kappa (resumo)' = CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Kappa", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 8be6e30c-344f-58b1-ab8a-69f5d17a9517

	/// Receita perdida ÷ mensalidade da carteira no início do mês.
	measure '% Churn de Receita (resumo)' = DIVIDE( [Receita Perdida (resumo)], [Mensalidade no Início do Mês (resumo)] )
		formatString: 0.00%
		displayFolder: Resumo Ongoing
		lineageTag: ae65857d-b8c0-5720-bbbb-4d8bad48f110

	/// Mensalidade (Contratos) dos clientes Alfa da carteira no 1º retrato do mês.
	measure 'Mensalidade no Início do Mês (resumo)' = CALCULATE( [Mensalidade AF (início do mês)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Resumo Ongoing
		lineageTag: d24ba7c7-0016-551d-a986-7b47e925d157

	/// Mensalidade dos cancelamentos do Alfa efetivados (só quem saiu), pelo treinador da equipe.
	measure 'Receita Perdida (resumo)' = CALCULATE( [R$ Cancelado], Helpdesk_Cancelamentos[sistema] = "Alfa", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) )
		formatString: \R$ #,0.00
		displayFolder: Resumo Ongoing
		lineageTag: 587b4a91-bad0-57d0-b616-58e1c1d48234

	/// Clientes cancelados ÷ clientes no início do mês.
	measure '% Logo Churn (resumo)' = DIVIDE( [Clientes Cancelados (resumo)], [Clientes no Início do Mês (resumo)] )
		formatString: 0.00%
		displayFolder: Resumo Ongoing
		lineageTag: 01baa72b-f106-5cf1-9ed4-72cdee40e37f

	/// Pedidos de cancelamento do Alfa efetivados (data de fechamento) em que o treinador é da equipe.
	measure 'Clientes Cancelados (resumo)' = CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Alfa", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 84d9b54b-fa2c-5f7a-8ffb-d7c710f3b017

	/// Migrações ativadas ÷ migrações concluídas no mês.
	measure '% Ativados (resumo)' = DIVIDE( [Migrações Ativadas (resumo)], [Clientes Migrados (resumo)] )
		formatString: 0.00%
		displayFolder: Resumo Ongoing
		lineageTag: 4fb6f2a4-e8db-5f36-be29-415d0ec9ed97

	/// Análises de Migração concluídas no mês com categoria Migração - Não Ativado, pelo CS que recebeu.
	measure 'Migrações Não Ativadas (resumo)' = CALCULATE( [Migrações Não Ativadas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 391d204c-9292-590f-951e-f415db2e7b3c

	/// Análises de Migração concluídas no mês com categoria Migração - Ativado, pelo CS que recebeu.
	measure 'Migrações Ativadas (resumo)' = CALCULATE( [Migrações Ativadas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 3e559e6d-8e1f-5fdd-b092-c816864e529c

	/// Análises de Migração concluídas no mês (ativadas + não ativadas), pelo CS do Ongoing que recebeu (responsável da atividade).
	measure 'Clientes Migrados (resumo)' = CALCULATE( [Migrações], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 9b5f78ce-30e1-5a39-8140-f816f8255400

	/// Clientes da carteira no início do mês cujo registro no CRM (dt_register) completa 120 dias dentro do mês.
	measure 'Clientes que Completam 120 Dias (resumo)' = VAR d1 = CALCULATE( MIN( CRM_Backup_Diario[Periodo] ) ) VAR ini = DATE( YEAR( d1 ), MONTH( d1 ), 1 ) VAR fim = EOMONTH( ini, 0 ) RETURN IF( NOT ISBLANK( d1 ) && DAY( d1 ) <= 3, CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d1, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado", "Suspenso" } ), CRM_Backup_Diario[Só Kappa] = "Não", KEEPFILTERS( FILTER( ALL( CRM_Backup_Diario[Dt_Cadastro] ), CRM_Backup_Diario[Dt_Cadastro] + 120 >= ini && CRM_Backup_Diario[Dt_Cadastro] + 120 <= fim ) ), TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: ef9c5436-bafb-51d5-b75b-bac33f233f5a

	/// Clientes da carteira de hoje sem tratativa do Ongoing há mais de 45 dias (regra do Ongoing - Últimos Contatos), das pessoas que estavam na equipe no mês.
	measure 'Clientes sem Atividade (resumo)' = IF( ISBLANK( [Equipe no Mês (resumo)] ), BLANK(), CALCULATE( [Clientes sem Tratativa em Dia], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), dCarteira[Email do CS], dCarteira[Mês da Composição] ) ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: c29cfe94-74d4-5da6-a675-e636b00bb361

	/// Atividades do CRM (tipos do SLA) concluídas no prazo ÷ concluídas, pelo responsável da atividade.
	measure '% SLA CRM (resumo)' = CALCULATE( [% SLA das Atividades], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) )
		formatString: 0.00%
		displayFolder: Resumo Ongoing
		lineageTag: 318745db-66df-5a9c-b0a0-a4fe096597fe

	/// Clientes atuais ÷ analistas com carteira.
	measure 'Média de Carteira por Analista (resumo)' = DIVIDE( [Clientes Atuais (resumo)], [Analistas com Carteira (resumo)] )
		formatString: #,0.00
		displayFolder: Resumo Ongoing
		lineageTag: e55a8c78-1a10-5b53-bfe1-260be44e8ec2

	/// Pessoas em contexto com pelo menos um cliente na carteira (último retrato do mês).
	measure 'Analistas com Carteira (resumo)' = COUNTROWS( FILTER( VALUES( dColaboradorMes[email] ), [Clientes Atuais (resumo)] > 0 ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: b9ee30dc-b8b8-566a-b5f6-d7b40e4d4892

	/// Clientes Alfa (Ativo/Bloqueado) no último retrato do mês (no mês atual, o de hoje), na carteira dos CS.
	measure 'Clientes Atuais (resumo)' = CALCULATE( [Clientes na Carteira (no dia)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 37eafee7-d090-5e3e-aaa5-6faf0fa036ab

	/// Clientes Alfa (Ativo/Bloqueado/Suspenso, CNPJ distinto) no 1º retrato do mês, na carteira dos CS em contexto.
	measure 'Clientes no Início do Mês (resumo)' = VAR d1 = CALCULATE( MIN( CRM_Backup_Diario[Periodo] ) ) RETURN IF( NOT ISBLANK( d1 ) && DAY( d1 ) <= 3, CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d1, KEEPFILTERS( CRM_Backup_Diario[Status_Office] IN { "Ativo", "Bloqueado", "Suspenso" } ), CRM_Backup_Diario[Só Kappa] = "Não", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ) )
		formatString: #,0
		displayFolder: Resumo Ongoing
		lineageTag: 23e7239d-832d-54db-97a9-b7d82f04cea8

	/// Tickets Contato Efetivo do Treinamento fechados no mês, pelo owner.
	measure 'Contatos Efetivos (resumo Onboarding)' = CALCULATE( [Contatos Efetivos], Helpdesk_Tickets[owner_team] = "Treinamento", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 64efedb3-a50b-5bd7-b71e-b3ff8ade0924

	/// Tickets Tentativa de Contato do Treinamento fechados no mês, pelo owner.
	measure 'Tentativas de Contato (resumo Onboarding)' = CALCULATE( [Tentativas de Contato], Helpdesk_Tickets[owner_team] = "Treinamento", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 694b17e1-e4d6-51bc-88da-de56eab7a9ad

	/// Quedas no treinamento (Falta ou Remarcação, regra do No Show), por data de criação, pela pessoa da reunião.
	measure 'Faltas em Consultoria (resumo Onboarding)' = CALCULATE( [Quedas no Treinamento], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email da Reunião], Helpdesk_Tickets[Mês da Reunião] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 0f8f6e31-2078-552b-9aab-3b26e6d386ba

	/// Reuniões feitas (checkouts do Treinamento, regra do No Show), por data de criação, pela pessoa da reunião.
	measure 'Consultorias Realizadas (resumo Onboarding)' = CALCULATE( [Reuniões Feitas (Checkout)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email da Reunião], Helpdesk_Tickets[Mês da Reunião] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 8a8e11b7-f6c8-550f-9143-57a7332c1b6d

	/// Tickets Checkout Alinhamento Inicial fechados no mês, pelo owner.
	measure 'Alinhamentos de Expectativa (resumo Onboarding)' = CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Checkout Alinhamento Inicial", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 924aa694-5a28-5c5b-8dbd-11795e29d8f0

	/// Tickets no prazo ÷ tickets fechados com SLA previsto.
	measure '% SLA dos Tickets (resumo Onboarding)' = DIVIDE( [Tickets no Prazo (resumo Onboarding)], [Tickets com SLA (resumo Onboarding)] )
		formatString: 0.00%
		displayFolder: Resumo Onboarding
		lineageTag: c8f1b998-8eac-5eea-ac4a-a1b06717d9b9

	/// Tickets fechados no mês resolvidos depois do SLA previsto, pelo owner.
	measure 'Tickets fora do Prazo (resumo Onboarding)' = CALCULATE( COUNTROWS( Helpdesk_Tickets ), Helpdesk_Tickets[Status SLA] = "Fora do prazo", NOT ISBLANK( Helpdesk_Tickets[Data_Fechamento_Ticket] ), TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: b84fb7c2-bb24-54fc-b4ca-ee4be646936f

	/// Tickets fechados no mês resolvidos até o SLA previsto, pelo owner.
	measure 'Tickets no Prazo (resumo Onboarding)' = CALCULATE( [Tickets no Prazo do SLA], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: d86c7afb-79bd-5588-977e-bbfeaa11dbee

	/// Tickets fechados no mês com SLA previsto, pelo owner.
	measure 'Tickets com SLA (resumo Onboarding)' = CALCULATE( [Tickets com SLA], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: c677aa34-f0db-50c9-b571-2898c056c00e

	/// Atividades dos tipos do SLA concluídas no mês depois do prazo, pelo responsável da atividade.
	measure 'Atividades Atrasadas (resumo Onboarding)' = CALCULATE( [Atividades Fora do Prazo], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 66d5dd0f-0c76-56fc-8fee-f184793debb6

	/// Atividades do CRM concluídas no mês (sem o tipo Onboarding), pelo responsável da atividade.
	measure 'Atividades Concluídas (resumo Onboarding)' = CALCULATE( [Atividades Concluídas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: eca2d0a7-76d1-525b-8e14-3147733d3cc5

	/// Migrações ativadas ÷ migrações concluídas no mês.
	measure '% Ativados (resumo Onboarding)' = DIVIDE( [Migrações Ativadas (resumo Onboarding)], [Clientes Migrados (resumo Onboarding)] )
		formatString: 0.00%
		displayFolder: Resumo Onboarding
		lineageTag: dc4528da-4228-5980-bae3-cd7029dbdb76

	/// Análises de Migração concluídas no mês com categoria Migração - Ativado, por quem migrou.
	measure 'Migrações Ativadas (resumo Onboarding)' = CALCULATE( [Migrações Ativadas], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: cf3e7462-76bd-5557-9385-8024eb1fa73f

	/// Análises de Migração concluídas no mês (ativadas + não ativadas), pelo responsável pelo cliente (quem migrou).
	measure 'Clientes Migrados (resumo Onboarding)' = CALCULATE( [Migrações], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Mês da Composição] ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
