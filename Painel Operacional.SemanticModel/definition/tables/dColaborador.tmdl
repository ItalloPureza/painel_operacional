	/// CSAT das pesquisas do Helpdesk respondidas no mês (todas as áreas; nota 0 vale 1); com filtro de pessoa, as dos tickets dela.
	measure 'CSAT (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [CSAT Helpdesk], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Survey[Email do Analista do Ticket], Helpdesk_Survey[Mês da Composição] ), TREATAS( SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Survey[Email do Analista do Ticket], Helpdesk_Survey[Mês da Composição] ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [CSAT Helpdesk], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Survey[Email do Analista do Ticket], Helpdesk_Survey[Mês da Composição] ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [CSAT Helpdesk], TREATAS( SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Survey[Email do Analista do Ticket], Helpdesk_Survey[Mês da Composição] ) ), [CSAT Helpdesk] )
