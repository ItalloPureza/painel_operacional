	measure 'Treinamentos KP (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Checkout - Kappa" ), TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ), TREATAS( SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) ), ISFILTERED( dColaboradorMes ), CALCULATE( CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Checkout - Kappa" ), TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Checkout - Kappa" ), TREATAS( SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) ), CALCULATE( [Tickets Fechados], Helpdesk_Tickets[category] = "Checkout - Kappa" ) )
