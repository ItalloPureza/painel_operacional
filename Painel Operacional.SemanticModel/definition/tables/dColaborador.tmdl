	/// Mensalidade dos cancelamentos do Alfa fechados no mês (só quem saiu): da empresa ou dos pedidos da pessoa.
	measure 'Receita Perdida AF (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [R$ Cancelado], Helpdesk_Cancelamentos[sistema] = "Alfa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) && ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [R$ Cancelado], Helpdesk_Cancelamentos[sistema] = "Alfa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [R$ Cancelado], Helpdesk_Cancelamentos[sistema] = "Alfa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), CALCULATE( [R$ Cancelado (Fechado)], fGlobalCancelamentos[Sistema] = "Alfa" ) )
