	/// Média, nos retratos do mês, de entregas pelo eContínuo ÷ prazos gerados (clientes Alfa Ativo/Bloqueado): da empresa ou da carteira dos CS filtrados.
	measure '% Uso eContínuo (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [% Uso eContinuo (média)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [% Uso eContinuo (média)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ), ISFILTERED( dAnalistaRelacionamento ), [% Uso eContinuo (média)], [% Uso eContinuo (média)] )
		formatString: 0.00%
		displayFolder: Resumo Alfa e Kappa
		lineageTag: 2020fdc8-e498-5daa-b93d-1ac96b345f3f

	/// Clientes Alfa (Ativo/Bloqueado) no último retrato do mês (no mês atual, o de hoje): da empresa ou da carteira dos CS filtrados.
	measure 'Clientes AF Atuais (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), [Clientes Atuais (resumo)], ISFILTERED( dColaboradorMes ), [Clientes Atuais (resumo)], ISFILTERED( dAnalistaRelacionamento ), [Clientes na Carteira (no dia)], [Clientes na Carteira (no dia)] )
		formatString: #,0
		displayFolder: Resumo Alfa e Kappa
		lineageTag: 4aedf38a-9fdd-53e5-8403-fd66c654b80b

	/// Clientes Alfa (Ativo/Bloqueado/Suspenso) no 1º retrato do mês: da empresa (= Global - Cancelamento AF) ou da carteira dos CS filtrados.
	measure 'Clientes AF no Início do Mês (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), [Clientes no Início do Mês (resumo)], ISFILTERED( dColaboradorMes ), [Clientes no Início do Mês (resumo)], ISFILTERED( dAnalistaRelacionamento ), [Clientes Ativos AF (início do mês)], [Clientes Ativos AF (início do mês)] )
		formatString: #,0
		displayFolder: Resumo Alfa e Kappa
