	measure 'Clientes AF Cancelados (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Alfa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) && ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Alfa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Alfa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), CALCULATE( [Cancelamentos (Fechado)], fGlobalCancelamentos[Sistema] = "Alfa" ) )
