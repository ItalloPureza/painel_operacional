	/// Clientes com o Kappa ativo no 1º retrato do mês: da empresa (= Global - Cancelamento KP) ou da carteira dos CS.
	measure 'Clientes KP no Início do Mês (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), VAR d1 = CALCULATE( MIN( CRM_Backup_Diario[Periodo] ) ) RETURN IF( NOT ISBLANK( d1 ) && DAY( d1 ) <= 3, CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d1, CRM_Backup_Diario[Status KP] = "Ativo", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ) ), ISFILTERED( dColaboradorMes ), VAR d1 = CALCULATE( MIN( CRM_Backup_Diario[Periodo] ) ) RETURN IF( NOT ISBLANK( d1 ) && DAY( d1 ) <= 3, CALCULATE( DISTINCTCOUNT( CRM_Backup_Diario[CNPJ] ), CRM_Backup_Diario[Periodo] = d1, CRM_Backup_Diario[Status KP] = "Ativo", TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ) ), ISFILTERED( dAnalistaRelacionamento ), [Clientes Ativos KP (início do mês)], [Clientes Ativos KP (início do mês)] )
		formatString: #,0
		displayFolder: Resumo Alfa e Kappa
		lineageTag: 748c2b33-6ff8-56bd-afbb-f09a87513d97

	/// Tempo médio de espera dos chats do Helpdesk até o analista responder, em minutos (TME, regra do Suporte - Resultados); com filtro de pessoa, os chats dela.
	measure 'Primeira Resposta no Chat (min) (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [TME Chat (min)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ), TREATAS( SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [TME Chat (min)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [TME Chat (min)], TREATAS( SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Tickets[Email do Analista], Helpdesk_Tickets[Mês da Composição] ) ), [TME Chat (min)] )
