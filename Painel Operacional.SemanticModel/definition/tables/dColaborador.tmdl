	/// Equipe da pessoa na composição do mês mais recente do período (a tabela por consultor fica com uma linha por pessoa).
	measure 'Equipe no Mês (resumo)' = VAR hoje = YEAR( TODAY() ) * 100 + MONTH( TODAY() ) VAR am = MIN( MAX( MAX( Calendario[AnoMes] ), 202608 ), hoje ) RETURN CALCULATE( CONCATENATEX( VALUES( dColaboradorMes[Equipe] ), dColaboradorMes[Equipe], " / " ), dColaboradorMes[AnoMes] = am )
		displayFolder: Resumo Ongoing
		lineageTag: 129419c3-ab95-527b-998e-2d4db3ec832a

