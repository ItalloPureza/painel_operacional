	column 'Nome Curto Normalizado' = VAR p = SUBSTITUTE( dColaborador[Nome Normalizado], " ", "|" ) RETURN IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), dColaborador[Nome Normalizado] )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: f275a082-ad86-5431-932e-a4a2b08a74a2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dColaborador = calculated
		mode: import
		source =
				
				-- 1 linha por pessoa. Dimensão das telas do WhatsApp: liga analista/remetente/atendente
				-- -> nome, equipe e setor. A equipe vem de Time_Equipes (membros, igual ao RLS):
				-- (RH_equipes liga pelo lider_id = equipe que a pessoa LIDERA, não a que ela participa.)
				-- dPessoaSetor (Ligações/CRM) deriva desta tabela.
				-- Pessoa em mais de uma equipe: prefere a que tem setor no dMapaSetor.
				VAR base =
				    ADDCOLUMNS(
				        DISTINCT( SELECTCOLUMNS( FILTER( Time_Usuarios, NOT ISBLANK( Time_Usuarios[email] ) ), "email", LOWER( TRIM( Time_Usuarios[email] ) ) ) ),
				        "Colaborador", VAR e = [email] RETURN MAXX( FILTER( Time_Usuarios, LOWER( TRIM( Time_Usuarios[email] ) ) = e ), Time_Usuarios[nome] ),
				        "Equipe",
				            VAR e = [email]
				            VAR minhas = FILTER( Time_Equipes, LOWER( TRIM( Time_Equipes[email] ) ) = e )
				            VAR mapeadas = FILTER( minhas, NOT ISBLANK( LOOKUPVALUE( dMapaSetor[Setor], dMapaSetor[Equipe], Time_Equipes[nome_equipe] ) ) )
				            RETURN IF( NOT ISEMPTY( mapeadas ), MAXX( mapeadas, Time_Equipes[nome_equipe] ), MAXX( minhas, Time_Equipes[nome_equipe] ) )
				    )
				RETURN
				    ADDCOLUMNS( base, "Setor", LOOKUPVALUE( dMapaSetor[Setor], dMapaSetor[Equipe], [Equipe] ) )

	annotation PBI_Id = 2ab0e70a982b5af4ac275b5ed0e64a1e

