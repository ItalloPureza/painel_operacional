		lineageTag: 91497f1b-4b69-5b48-aa3f-cab002cad734

	/// Clientes da carteira de hoje sem ticket de Treinamento há mais de 10 dias (regra do Onboarding - Últimos Contatos), das pessoas que estavam na equipe no mês.
	measure 'Clientes sem Contato (resumo Onboarding)' = IF( ISBLANK( [Equipe no Mês (resumo)] ), BLANK(), CALCULATE( [Clientes sem Contato em Dia], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), dCarteira[Email do CS], dCarteira[Mês da Composição] ) ) )
		formatString: #,0
		displayFolder: Resumo Onboarding
		lineageTag: 530f32df-5525-509e-a388-c0356781c656

	/// Cancelamentos do Kappa fechados no mês: da empresa (= Global - Cancelamento KP) ou os pedidos efetivados em que a pessoa é o treinador ou o atendente.
	measure 'Clientes KP Cancelados (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Kappa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) && ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Kappa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[sistema] = "Kappa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), CALCULATE( [Cancelamentos (Fechado)], fGlobalCancelamentos[Sistema] = "Kappa" ) )
		formatString: #,0
		displayFolder: Resumo Alfa e Kappa
		lineageTag: 75cce821-1026-539d-8547-965e632a7ad9

	/// Pedidos de cancelamento do Kappa abertos no mês; com filtro de pessoa, os em que ela é o treinador ou o atendente.
	measure 'Solicitações de Cancelamento KP (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Pedidos de Cancelamento (Empresa)], Helpdesk_Cancelamentos[sistema] = "Kappa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) && ( ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [Pedidos de Cancelamento (Empresa)], Helpdesk_Cancelamentos[sistema] = "Kappa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Pedidos de Cancelamento (Empresa)], Helpdesk_Cancelamentos[sistema] = "Kappa", KEEPFILTERS( FILTER( SUMMARIZE( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ), ( Helpdesk_Cancelamentos[Email do Treinador], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), CALCULATE( [Pedidos de Cancelamento (Empresa)], Helpdesk_Cancelamentos[sistema] = "Kappa" ) )
