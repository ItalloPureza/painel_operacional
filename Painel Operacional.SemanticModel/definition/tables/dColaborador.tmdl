	/// Análises de Migração concluídas no mês com categoria Migração - Ativado.
	measure 'Migrações Ativadas (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Migrações Ativadas], KEEPFILTERS( FILTER( SUMMARIZE( CRM_Atividades, CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ), ( CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ), KEEPFILTERS( FILTER( SUMMARIZE( CRM_Atividades, CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ), ( CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [Migrações Ativadas], KEEPFILTERS( FILTER( SUMMARIZE( CRM_Atividades, CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ), ( CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Migrações Ativadas], KEEPFILTERS( FILTER( SUMMARIZE( CRM_Atividades, CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ), ( CRM_Atividades[Email do Responsável pelo Cliente], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) || ( CRM_Atividades[Responsavel_Email], CRM_Atividades[Mês da Composição] ) IN SUMMARIZE( FILTER( ALL( dColaboradorMes ), dColaboradorMes[Setor] = "Relacionamento" && dColaboradorMes[email] IN VALUES( dAnalistaRelacionamento[email] ) ), dColaboradorMes[email], dColaboradorMes[AnoMes] ) ) ) ), [Migrações Ativadas] )
		formatString: #,0
