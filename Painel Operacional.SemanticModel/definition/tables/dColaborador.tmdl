	/// Clientes com o Kappa ativo no último retrato do mês: da empresa ou da carteira dos CS filtrados.
	measure 'Clientes KP Atuais (resumo produtos)' = SWITCH( TRUE(), ISFILTERED( dColaboradorMes ) && ISFILTERED( dAnalistaRelacionamento ), CALCULATE( [Clientes KP (no dia)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ), ISFILTERED( dColaboradorMes ), CALCULATE( [Clientes KP (no dia)], TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Mês da Composição] ) ), ISFILTERED( dAnalistaRelacionamento ), [Clientes KP (no dia)], [Clientes KP (no dia)] )
