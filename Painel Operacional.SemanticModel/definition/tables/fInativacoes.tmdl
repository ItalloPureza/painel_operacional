	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & fInativacoes[ID] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: 021a07bf-ac63-53b5-b706-04611c9682e6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ do Cliente (busca)' = VAR c = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( TRIM( fInativacoes[CNPJ] ), ".", "" ), "/", "" ), "-", "" ), " ", "" ) RETURN IF( c = "", BLANK(), c )
		dataType: string
		displayFolder: Cliente
		lineageTag: 9c202b0d-360c-518d-899c-e6c7b043bc82
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fInativacoes = calculated
		mode: import
		source =
				
				-- Saídas desde ago/2026 (fPeriodos), AF e KP, com o ticket de cancelamento do MESMO período como evidência.
				-- Calculada no refresh, fora do RLS. Gerado por gerar_gerencia.py (regras em docs/gerencia.md).
				SELECTCOLUMNS( FILTER( fPeriodos, NOT ISBLANK( fPeriodos[Saída] ) && fPeriodos[Saída] >= DATE( 2026, 8, 1 ) ),
				    "Produto", fPeriodos[Produto],
				    "ID CRM", fPeriodos[ID CRM],
				    "ID", fPeriodos[ID],
				    "Cliente", fPeriodos[Cliente],
				    "CNPJ", fPeriodos[CNPJ],
				    "CS (último dia ativo)", fPeriodos[CS],
				    "Equipe do CS", fPeriodos[Equipe do CS],
				    "Tipo de Entrada", fPeriodos[Tipo de Entrada],
				    "Início do Período", fPeriodos[Entrada],
				    "Último Dia Ativo", fPeriodos[Último Dia Ativo],
				    "Data da Inativação", fPeriodos[Saída],
				    "Confirmação", fPeriodos[Confirmação da Saída],
				    "Voltou em", fPeriodos[Voltou em],
				    "Ticket do Período", fPeriodos[Ticket do Período],
				    "Ticket", fPeriodos[Ticket],
				    "Categoria do Ticket", fPeriodos[Categoria do Ticket],
				    "Status do Ticket", fPeriodos[Status do Ticket],
				    "Fechamento do Ticket", fPeriodos[Fechamento do Ticket],
				    "Dias do Ticket até a Inativação", fPeriodos[Dias do Ticket até a Saída],
				    "Alegação", fPeriodos[Alegação],
				    "Ticket de Período Anterior", fPeriodos[Ticket de Período Anterior],
				    "Conferência", fPeriodos[Conferência] )

