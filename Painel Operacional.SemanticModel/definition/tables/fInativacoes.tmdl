table fInativacoes
	lineageTag: 9b518772-c6ba-5979-9e00-67d5a17827c4

	/// Saídas cujo único ticket efetivado é de antes de o cliente voltar: o cancelamento novo não tem ticket.
	measure 'Inativações só com Ticket Anterior' = CALCULATE( COUNTROWS( fInativacoes ), KEEPFILTERS( fInativacoes[Ticket do Período] IN { "Só ticket de período anterior" } ) )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: ea7c0d94-1ce3-5df0-9548-ca235fa8979d

	/// Saídas sem ticket efetivado no período do cliente (sem ticket nenhum ou só ticket de antes de uma volta).
	measure 'Inativações sem Ticket no Período' = CALCULATE( COUNTROWS( fInativacoes ), KEEPFILTERS( fInativacoes[Ticket do Período] IN { "Sem ticket", "Só ticket de período anterior" } ) )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: 571d36a0-95c8-5a60-a59c-f6d7c59ff890

	/// Saídas com ticket 'Cancelamento Efetivado' fechado no mesmo período do cliente.
	measure 'Inativações com Ticket Efetivado' = CALCULATE( COUNTROWS( fInativacoes ), KEEPFILTERS( fInativacoes[Ticket do Período] IN { "Efetivado", "Efetivado com estorno total", "Efetivado só tipo 1" } ) )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: 6c6e19ac-4432-5b39-90bd-08563d325a8b

	/// Saídas desde ago/2026 no retrato do CRM (ativo -> inativo por mais de 7 dias ou até hoje). Quem saiu duas vezes conta duas.
	measure Inativações = COUNTROWS( fInativacoes )
		formatString: #,0
		displayFolder: Gerência
		lineageTag: 9a7207a4-686a-5b4b-aa73-be8895a9135c

	/// Saídas com ticket efetivado no período ÷ saídas.
	measure '% Inativações com Ticket' = DIVIDE( [Inativações com Ticket Efetivado], [Inativações] )
		formatString: 0.00%
		displayFolder: Gerência
		lineageTag: f7cb5171-83ef-5a9d-b41f-5f5f1d76f46c

