table WhatsApp_Envios
	lineageTag: 697104a2-31a8-57f0-a610-aac69e4c06a3

	measure Disparos = COUNTROWS( WhatsApp_Envios )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: dbd358d6-d10a-5f06-bfbc-7d0da8d6def6

	measure Campanhas = DISTINCTCOUNT( WhatsApp_Envios[campaign_id] )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: a98f38bf-71fc-5fdd-9b98-56704a11a533

	measure Falhas = CALCULATE( [Disparos], WhatsApp_Envios[Status] = "Falhou" )
		formatString: #,0
		displayFolder: WhatsApp
		lineageTag: dd603c05-bb6e-514d-9131-0a6f2f55bcd4

	measure '% Entregues' = DIVIDE( CALCULATE( [Disparos], WhatsApp_Envios[Status] IN { "Entregue", "Lido" } ), [Disparos] )
		formatString: 0.00%
		displayFolder: WhatsApp
		lineageTag: 836683ff-5ad3-536f-b0b8-921a3ad90f64

	measure '% Lidos' = DIVIDE( CALCULATE( [Disparos], WhatsApp_Envios[Status] = "Lido" ), [Disparos] )
		formatString: 0.00%
		displayFolder: WhatsApp
		lineageTag: 4652db3f-e418-5352-b2fc-4819a1c7900f

	measure '% Falhas' = DIVIDE( [Falhas], [Disparos] )
		formatString: 0.00%
		displayFolder: WhatsApp
		lineageTag: cc95cc55-be0c-5723-8dfc-3807cae81b3a

	/// Disparos (mensagens proativas) ÷ dias com atendimento no filtro, separados das mensagens do time.
	measure 'Disparos por Dia' = DIVIDE( [Disparos], [Dias com Atendimento] )
		formatString: #,0.00
		displayFolder: Volumetria
		lineageTag: 2ce3a731-e696-5f18-a1e5-68e4ddb1ae6f

	/// Disparos com continuidade ÷ disparos entregues.
	measure '% Continuidade dos Disparos' = DIVIDE( [Disparos com Continuidade], [Disparos Entregues] )
		formatString: 0.00%
		displayFolder: Volumetria
		lineageTag: dd2f21d7-feab-54f7-9278-874a0ea934d3

	/// Disparos entregues que abriram atendimento depois do envio (janela do banco). Não conta o disparo feito com o atendimento já aberto.
	measure 'Disparos com Continuidade' = CALCULATE( [Disparos Entregues], KEEPFILTERS( WhatsApp_Envios[Continuidade] = "Virou atendimento" ) )
		formatString: #,0
		displayFolder: Volumetria
		lineageTag: 1ac00138-95b5-52e1-81a1-5bc6566e0832

	/// Disparos que chegaram ao cliente (entregues ou lidos).
	measure 'Disparos Entregues' = CALCULATE( [Disparos], KEEPFILTERS( WhatsApp_Envios[Status] IN { "Entregue", "Lido" } ) )
		formatString: #,0
		displayFolder: Volumetria
		lineageTag: b7721355-025c-5aa9-ae95-1c66aca55d6c

