		dataType: dateTime
		formatString: dd/mm/yy
		lineageTag: 0adc26c2-b493-5555-a194-8a7419bda17b
		summarizeBy: none
		sourceColumn: Extracao

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = WhatsApp_Envios[Data] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: c6291d03-87e4-5553-968d-c215325bd8bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Chave Pessoa Mês' = IF( TRIM( WhatsApp_Envios[remetente_email] ) <> "", LOWER( TRIM( WhatsApp_Envios[remetente_email] ) ) & "|" & WhatsApp_Envios[Mês da Composição] )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: d410d209-c98f-5c09-85e8-c48e8212a0d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Continuidade
