		sourceColumn: Continuidade

		annotation SummarizationSetBy = Automatic

	partition WhatsApp_Envios = m
		mode: import
		queryGroup: WhatsApp
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="WhatsApp_Envios",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"campaign_id", type text}, {"destinatario_identity", type text}, {"Código da falha", type text}, {"Detalhe da falha", type text}, {"Origem", type text}, {"Tipo de disparo", type text}, {"Template", type text}, {"Enviado em", type datetime}, {"Data", type datetime}, {"remetente_email", type text}, {"Status", type text}, {"Motivo da falha", type text}, {"Extracao", type datetime}, {"Continuidade", type text}})
				in
				    Tipos


	annotation PBI_ResultType = Table

