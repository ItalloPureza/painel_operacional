	column Setor = VAR s = LOOKUPVALUE( dDeParaOwnerTeam[Setor], dDeParaOwnerTeam[owner_team], Helpdesk_Cancelamentos[ownerTeam] ) RETURN IF( ISBLANK( s ) && Helpdesk_Cancelamentos[ownerTeam] = "Liderança", "Relacionamento", s )
		dataType: string
		lineageTag: 173e3529-60f8-4d0b-a083-82a1d6746cc8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column data_extracao
		dataType: dateTime
		formatString: dd/mm/yy
		lineageTag: 2f88740b-a209-4461-92e0-629ff82aa6e9
		summarizeBy: none
		sourceColumn: data_extracao

		annotation SummarizationSetBy = Automatic

	column 'Email do Treinador' = VAR n = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( LOWER( TRIM( Helpdesk_Cancelamentos[treinador] ) ), "á", "a" ), "à", "a" ), "â", "a" ), "ã", "a" ), "ä", "a" ), "é", "e" ), "è", "e" ), "ê", "e" ), "ë", "e" ), "í", "i" ), "ì", "i" ), "î", "i" ), "ï", "i" ), "ó", "o" ), "ò", "o" ), "ô", "o" ), "õ", "o" ), "ö", "o" ), "ú", "u" ), "ù", "u" ), "û", "u" ), "ü", "u" ), "ç", "c" ), "ñ", "n" ), "  ", " " ) VAR p = SUBSTITUTE( n, " ", "|" ) VAR curto = IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), n ) VAR e1 = IF( n = "", BLANK(), LOOKUPVALUE( dColaborador[email], dColaborador[Nome Normalizado], n, BLANK() ) ) RETURN IF( ISBLANK( e1 ) && n <> "", LOOKUPVALUE( dColaborador[email], dColaborador[Nome Curto Normalizado], curto, BLANK() ), e1 )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: 5fce4add-e235-50f4-8f05-6bdadb3ad0c6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do Treinador' = IF( ISBLANK( Helpdesk_Cancelamentos[Email do Treinador] ), IF( TRIM( Helpdesk_Cancelamentos[treinador] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], Helpdesk_Cancelamentos[Email do Treinador], dColaboradorMes[AnoMes], Helpdesk_Cancelamentos[Mês da Composição], BLANK() ), "(sem equipe)" ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: 2bd5392b-34b8-5a36-aea2-8644f537a401
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Setor do Treinador' = LOOKUPVALUE( dColaboradorMes[Setor], dColaboradorMes[email], Helpdesk_Cancelamentos[Email do Treinador], dColaboradorMes[AnoMes], Helpdesk_Cancelamentos[Mês da Composição], BLANK() )
		dataType: string
		displayFolder: Pessoa
		lineageTag: b1f333e3-8c5d-584a-8a6d-15fd6c0eaf51
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Resultado do Pedido' = IF( Helpdesk_Cancelamentos[status] = "Fechado" && Helpdesk_Cancelamentos[type] = 2 && Helpdesk_Cancelamentos[estornoTotal] <> "Sim" && Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", SWITCH( Helpdesk_Cancelamentos[category], "Cancelamento Efetivado", "Efetivado", "Cancelamento Revertido", "Revertido" ) )
		dataType: string
		displayFolder: Cancelamento
		lineageTag: 16afbbf8-7fcb-56bb-8760-cc32d6e2ce24
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Porte da Conta' =
			-- Porte da conta pela mensalidade (decisão do gestor, 05/10/2026). Para mudar as faixas, altere só estes valores:
			VAR LimitePequena = 300    -- abaixo de 300: Pequena
			VAR LimiteMedia = 900      -- de 300 até 900: Média; acima de 900: Grande
			VAR Valor = Helpdesk_Cancelamentos[mensalidade]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK( Valor ), BLANK(),
			        Valor < LimitePequena, "Pequena",
			        Valor <= LimiteMedia, "Média",
			        "Grande"
			    )
		dataType: string
		displayFolder: Cancelamento
		lineageTag: 4ae4efb8-07b0-5890-b965-81036e6569d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cancelou no Mesmo Mês' = VAR f = Helpdesk_Cancelamentos[idLegado] VAR s = Helpdesk_Cancelamentos[sistema] VAR d = Helpdesk_Cancelamentos[Data de Fechamento] VAR n = COUNTROWS( FILTER( CALCULATETABLE( Helpdesk_Cancelamentos, REMOVEFILTERS(), Helpdesk_Cancelamentos[idLegado] = f, Helpdesk_Cancelamentos[type] = 2 ), Helpdesk_Cancelamentos[sistema] = s && YEAR( Helpdesk_Cancelamentos[Data de Fechamento] ) = YEAR( d ) && MONTH( Helpdesk_Cancelamentos[Data de Fechamento] ) = MONTH( d ) ) ) RETURN IF( n > 1, "Sim", "Não" )
		dataType: string
		displayFolder: Relacionamento
		lineageTag: 1966849d-0747-5a6b-8486-181a1f0f1295
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cliente com Mais de um Pedido' = VAR f = Helpdesk_Cancelamentos[idLegado] VAR s = Helpdesk_Cancelamentos[sistema] VAR n = COUNTROWS( CALCULATETABLE( Helpdesk_Cancelamentos, REMOVEFILTERS(), Helpdesk_Cancelamentos[idLegado] = f, Helpdesk_Cancelamentos[sistema] = s, Helpdesk_Cancelamentos[type] = 2 ) ) RETURN IF( n > 1, "Sim", "Não" )
		dataType: string
		displayFolder: Relacionamento
		lineageTag: 49011e4a-66e3-5aa5-9515-a4f931387cc9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias Ativos' = VAR c = Helpdesk_Cancelamentos[Data de Contrato] VAR f = Helpdesk_Cancelamentos[Data de Fechamento] RETURN IF( NOT ISBLANK( c ) && NOT ISBLANK( f ), DATEDIFF( c, f, DAY ) )
		dataType: int64
		formatString: 0
		displayFolder: Relacionamento
		lineageTag: 10f5e709-6660-5326-b421-4b83c0d4b5a0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Pedido em Aberto' = VAR ref = CALCULATE( MAX( Helpdesk_Cancelamentos[data_extracao] ), REMOVEFILTERS( Helpdesk_Cancelamentos ) ) RETURN IF( Helpdesk_Cancelamentos[type] = 2 && NOT Helpdesk_Cancelamentos[status] IN { "Fechado", "Resolvido" }, IF( INT( ref - Helpdesk_Cancelamentos[Data de Criação] ) >= 5, "Há 5 dias ou mais", "Menos de 5 dias" ) )
		dataType: string
		displayFolder: Relacionamento
		lineageTag: a0a772a0-ea1a-5494-a454-eac49d00f912
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Email do Atendente' = VAR n = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( LOWER( TRIM( Helpdesk_Cancelamentos[owner] ) ), "á", "a" ), "à", "a" ), "â", "a" ), "ã", "a" ), "ä", "a" ), "é", "e" ), "è", "e" ), "ê", "e" ), "ë", "e" ), "í", "i" ), "ì", "i" ), "î", "i" ), "ï", "i" ), "ó", "o" ), "ò", "o" ), "ô", "o" ), "õ", "o" ), "ö", "o" ), "ú", "u" ), "ù", "u" ), "û", "u" ), "ü", "u" ), "ç", "c" ), "ñ", "n" ), "  ", " " ) VAR p = SUBSTITUTE( n, " ", "|" ) VAR curto = IF( PATHLENGTH( p ) > 1, PATHITEM( p, 1 ) & " " & PATHITEMREVERSE( p, 1 ), n ) VAR e1 = IF( n = "", BLANK(), LOOKUPVALUE( dColaborador[email], dColaborador[Nome Normalizado], n, BLANK() ) ) RETURN IF( ISBLANK( e1 ) && n <> "", LOOKUPVALUE( dColaborador[email], dColaborador[Nome Curto Normalizado], curto, BLANK() ), e1 )
		dataType: string
		isHidden
		displayFolder: Pessoa
		lineageTag: 08d56d6d-d73d-5cb7-aff8-39d6da02cc49
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Equipe do Atendente' = IF( ISBLANK( Helpdesk_Cancelamentos[Email do Atendente] ), IF( TRIM( Helpdesk_Cancelamentos[owner] ) <> "", "(sem cadastro)" ), COALESCE( LOOKUPVALUE( dColaboradorMes[Equipe], dColaboradorMes[email], Helpdesk_Cancelamentos[Email do Atendente], dColaboradorMes[AnoMes], Helpdesk_Cancelamentos[Mês da Composição], BLANK() ), "(sem equipe)" ) )
		dataType: string
		displayFolder: Pessoa
		lineageTag: c29122c2-234c-5314-8abe-a2c68dd099e7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Status do Cliente' = VAR i = Helpdesk_Cancelamentos[idLegado] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( dCarteira[Status], dCarteira[ID Legado], FORMAT( i, "0" ), BLANK() ) )
		dataType: string
		displayFolder: Cliente
		lineageTag: 5504ab30-676d-591e-b943-db75c83f3f32
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CS do Cliente' = VAR i = Helpdesk_Cancelamentos[idLegado] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( dCarteira[CS], dCarteira[ID Legado], FORMAT( i, "0" ), BLANK() ) )
		dataType: string
		displayFolder: Cliente
		lineageTag: 823722b3-83ff-597b-bfa0-8824b32388f9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ID do Cliente (busca)' = VAR i = TRIM( "" & Helpdesk_Cancelamentos[idLegado] ) RETURN IF( i = "" || i = "0", BLANK(), i )
		dataType: string
		displayFolder: Cliente
		lineageTag: 167ad6df-aef8-5261-aa03-508280bfd666
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'CNPJ do Cliente (busca)' = VAR c = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( TRIM( Helpdesk_Cancelamentos[cnpj] ), ".", "" ), "/", "" ), "-", "" ), " ", "" ) RETURN IF( c = "", BLANK(), c )
		dataType: string
		displayFolder: Cliente
		lineageTag: 48de7870-fc6a-5774-b675-b21311a07848
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Data de Cancelamento do Cliente do cliente no último retrato do CRM (campo do CRM; pode divergir do sistema legado).
	column 'Data de Cancelamento do Cliente' = VAR i = Helpdesk_Cancelamentos[idLegado] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( CRM_Clientes_Atual[Data_Cancelamento], CRM_Clientes_Atual[ID_Legado], FORMAT( i, "0" ), BLANK() ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Cliente
		lineageTag: 6b150f95-cf22-4f8c-bf65-e94c50304cce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Data de Reativação do cliente no último retrato do CRM (campo do CRM; pode divergir do sistema legado).
	column 'Data de Reativação' = VAR i = Helpdesk_Cancelamentos[idLegado] RETURN IF( NOT ISBLANK( i ), LOOKUPVALUE( CRM_Clientes_Atual[Data_Reativacao], CRM_Clientes_Atual[ID_Legado], FORMAT( i, "0" ), BLANK() ) )
		dataType: dateTime
		formatString: dd/mm/yy
		displayFolder: Cliente
		lineageTag: f468acab-7df2-4d4f-a9a1-c200d51ffa05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Só pedidos efetivados do Alfa. Sim = cliente Ativo/Bloqueado hoje + reativação do CRM igual ou posterior ao fechamento do pedido + sem inativação agendada (data de cancelamento do cliente a partir do último retrato). "Inativação agendada" = ainda vai inativar. Não = os demais.
	column 'Reativado após o Cancelamento' = VAR efet = Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado" && Helpdesk_Cancelamentos[sistema] = "Alfa" VAR f = Helpdesk_Cancelamentos[Data de Fechamento] VAR rv = Helpdesk_Cancelamentos[Data de Reativação] VAR dc = Helpdesk_Cancelamentos[Data de Cancelamento do Cliente] VAR ativo = Helpdesk_Cancelamentos[Status do Cliente] IN { "Ativo", "Bloqueado" } VAR agendada = ativo && NOT ISBLANK( dc ) && dc >= MAX( dCarteira[Data do Retrato] ) RETURN IF( NOT efet, BLANK(), IF( agendada, "Inativação agendada", IF( ativo && NOT ISBLANK( rv ) && rv >= f, "Sim", "Não" ) ) )
		dataType: string
		displayFolder: Cliente
		lineageTag: ceb04b95-6f55-43cd-b8a0-e399bf5438e3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Só para pedido efetivado do Alfa com o cliente Ativo/Bloqueado hoje e sem inativação agendada: sinais de que ele voltou — reativação do CRM (data igual ou posterior ao fechamento), contrato de reativação aprovado no portal depois do fechamento, ticket do Comercial "Reativação de Contratos" criado depois do fechamento. Sem nenhum = "Sem registro".
	column 'Como voltou' = VAR efet = Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado" && Helpdesk_Cancelamentos[sistema] = "Alfa" VAR f = Helpdesk_Cancelamentos[Data de Fechamento] VAR rv = Helpdesk_Cancelamentos[Data de Reativação] VAR dc = Helpdesk_Cancelamentos[Data de Cancelamento do Cliente] VAR ativo = Helpdesk_Cancelamentos[Status do Cliente] IN { "Ativo", "Bloqueado" } VAR agendada = ativo && NOT ISBLANK( dc ) && dc >= MAX( dCarteira[Data do Retrato] ) VAR cn = Helpdesk_Cancelamentos[CNPJ do Cliente (busca)] VAR idf = FORMAT( Helpdesk_Cancelamentos[idLegado], "0" ) VAR tpl = SELECTCOLUMNS( FILTER( Gestao_Contratos_Tipos_Contrato, SEARCH( "REATIV", Gestao_Contratos_Tipos_Contrato[Tipo Contrato], 1, 0 ) > 0 ), "k", Gestao_Contratos_Tipos_Contrato[Chave Primária Template] ) VAR ctAC = CALCULATE( MAX( Gestao_Contratos_AF_Prod[Data Aprovacao] ), REMOVEFILTERS( Gestao_Contratos_AF_Prod ), TREATAS( tpl, Gestao_Contratos_AF_Prod[Chave Estrangeira Contrato Template] ), Gestao_Contratos_AF_Prod[CNPJ/CPF] = cn, Gestao_Contratos_AF_Prod[Data Aprovacao] >= f ) VAR ctVi = CALCULATE( MAX( Gestao_Contratos_Gama_Prod[Data Aprovacao] ), REMOVEFILTERS( Gestao_Contratos_Gama_Prod ), TREATAS( tpl, Gestao_Contratos_Gama_Prod[Chave Estrangeira Contrato Template] ), Gestao_Contratos_Gama_Prod[CNPJ/CPF] = cn, Gestao_Contratos_Gama_Prod[Data Aprovacao] >= f ) VAR ct = MAX( ctAC, ctVi ) VAR tk = CALCULATE( MAX( Helpdesk_Tickets[Data_Criacao_Ticket] ), REMOVEFILTERS( Helpdesk_Tickets ), Helpdesk_Tickets[service] = "Comercial", Helpdesk_Tickets[category] = "Reativação de Contratos", Helpdesk_Tickets[ID Legado do Cliente] = idf, Helpdesk_Tickets[Data_Criacao_Ticket] >= f ) VAR sinais = FILTER( UNION( ROW( "t", IF( NOT ISBLANK( rv ) && rv >= f, "CRM (" & FORMAT( rv, "dd/mm/yy" ) & ")", "" ) ), ROW( "t", IF( NOT ISBLANK( ct ), "Contrato de reativação (" & FORMAT( ct, "dd/mm/yy" ) & ")", "" ) ), ROW( "t", IF( NOT ISBLANK( tk ), "Ticket do Comercial (" & FORMAT( tk, "dd/mm/yy" ) & ")", "" ) ) ), [t] <> "" ) RETURN IF( NOT( efet && ativo && NOT agendada ), BLANK(), IF( COUNTROWS( sinais ) = 0, "Sem registro", CONCATENATEX( sinais, [t], " + " ) ) )
		dataType: string
		displayFolder: Cliente
		lineageTag: 8b13970b-a6a1-4855-8e97-37d778a8411b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mês da Composição' = ( VAR _d = Helpdesk_Cancelamentos[Data de Fechamento] VAR _m = IF( ISBLANK( _d ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ), YEAR( _d ) * 100 + MONTH( _d ) ) RETURN MIN( MAX( _m, 202608 ), YEAR( TODAY() ) * 100 + MONTH( TODAY() ) ) )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Pessoa
		lineageTag: 2824c8b7-6896-54b4-8ed5-abaac7db4035
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

