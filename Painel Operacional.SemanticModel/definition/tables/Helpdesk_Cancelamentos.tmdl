				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id", Int64.Type}, {"type", Int64.Type}, {"status", type text}, {"Data de Criação", type datetime}, {"Data Resolvido", type datetime}, {"Data de Fechamento", type datetime}, {"ownerTeam", type text}, {"category", type text}, {"tags", type text}, {"origin", Int64.Type}, {"Data da Ultima Ação", type datetime}, {"Data da Ultima Atualização", type datetime}, {"Serviço", type text}, {"owner", type text}, {"organization", type text}, {"treinador", type text}, {"vendedor", type text}, {"idLegado", Int64.Type}, {"cnpj", type text}, {"licenca", Currency.Type}, {"licencaPaga", type text}, {"mensalidade", type number}, {"mensalidadeAVencer", type text}, {"qntdCnpj", type text}, {"Data de Contrato", type datetime}, {"contato", type text}, {"mensalidadePendente", type text}, {"sistema", type text}, {"idContrato", Int64.Type}, {"contratouOutroSoftware", type text}, {"reclamacaoVenda", type text}, {"areaDeAtuacao", type text}, {"faseDoCliente", type text}, {"estornoTotal", type text}, {"valorEstorno", Currency.Type}, {"alegacao", type text}, {"nomeConcorrente", type text}, {"excecaoGerencia", type text}, {"tipoInativacao", type text}, {"dataInativacaoTexto", type text}, {"descontoIsencaoReajuste", type text}, {"descontoMensalidade", type text}, {"descontoMensalidadeValor", Currency.Type}, {"isencaoMensalidade", type text}, {"isencaoMensalidadeValor", Currency.Type}, {"reajusteMensalidade", type text}, {"reajusteMensalidadeValor", Currency.Type}, {"ajusteCarteira", type text}, {"data_extracao", type datetime}})
				in
				    Tipos


	annotation PBI_ResultType = Table

