table Helpdesk_Cancelamentos
	lineageTag: cfd80fcd-f661-4f49-a695-1de34c84df97

	/// Tickets de cancelamento por data de CRIAÇÃO. Usar só em telas de pendência (fila aberta).
	measure 'Cancelamentos Abertos no Período' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), USERELATIONSHIP( Helpdesk_Cancelamentos[Data de Criação], Calendario[Date] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: 47b1b242-24b4-510a-9de7-7f6df3c0e67a

	/// Tickets de cancelamento por data de FECHAMENTO (padrão).
	measure 'Cancelamentos Fechados' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: #,0
		displayFolder: Base de datas
		lineageTag: 79ad498a-b80f-5153-bfb6-3777cfa875db

	/// Cancelamentos efetivados de contas de porte 'Grande' (faixas na coluna Porte da Conta).
	measure 'Cancelamentos Contas Grandes' = CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[Porte da Conta] = "Grande" )
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 03ff11ab-4d4d-5b6e-b50e-65f7344dc07e

	/// Cancelamentos efetivados de contas de porte 'Média' (faixas na coluna Porte da Conta).
	measure 'Cancelamentos Contas Médias' = CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[Porte da Conta] = "Média" )
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 66895a72-1d34-558d-a1b6-773f1169cd62

	/// Cancelamentos efetivados de contas de porte 'Pequena' (faixas na coluna Porte da Conta).
	measure 'Cancelamentos Contas Pequenas' = CALCULATE( [Cancelamentos Efetivados], Helpdesk_Cancelamentos[Porte da Conta] = "Pequena" )
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 1797199a-5868-5ce0-b178-270219a404d8

	/// SEM DEFINIÇÃO na intranet (ver docs/metas-intranet.md): fica vazia. Meta da equipe ÷ pessoas ativas na equipe.
	measure 'Meta de Cancelamentos (Individual)' = BLANK()
		formatString: #,0.00
		displayFolder: Metas (a ligar)
		lineageTag: 3844b0f1-0840-5c4c-9818-09349cf44f59

	/// Meta de R$ cancelado do Ongoing AF = meta % 'Mensalidade cancelamentos' x mensalidade AF no 1º dia do mês do setor ou da equipe (derivada, base CRM). Onboarding e Kappa ficam vazios (sem meta de R$ na intranet).
	measure 'Meta de R$ Cancelado' = VAR area = SELECTEDVALUE( Helpdesk_Cancelamentos[areaDeAtuacao] ) VAR sis = SELECTEDVALUE( Helpdesk_Cancelamentos[sistema] ) VAR eq = SELECTEDVALUE( Helpdesk_Cancelamentos[Equipe do Treinador] ) VAR setor = SWITCH( area, "Sucesso do Cliente", "Ongoing", "Consultoria", "Onboarding" ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta de R$ Cancelado (" & setor & ")" ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0 && sis = "Alfa", SUMX( VALUES( Calendario[AnoMes] ), CALCULATE( DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) * IF( ISBLANK( eq ), CALCULATE( [Mensalidade AF (início do mês)], CRM_Backup_Diario[Setor do CS] = setor ), CALCULATE( [Mensalidade AF (início do mês)], CRM_Backup_Diario[Setor do CS] = setor, CRM_Backup_Diario[Equipe do CS] = eq ) ) ) ) )
		formatString: #,0.00
		displayFolder: Metas (a ligar)
		lineageTag: 83e26684-0967-5ad2-8391-3f80623b2077

	/// Meta de cancelamentos (quantidade) do setor da tela = meta % da intranet x clientes ativos no 1º dia do mês do setor ou da equipe do gráfico (derivada, base CRM). Ongoing: 'Clientes cancelados'; Onboarding: 'Churn rate - Alfa'. Só Alfa; Kappa fica vazio.
	measure 'Meta de Cancelamentos' = VAR area = SELECTEDVALUE( Helpdesk_Cancelamentos[areaDeAtuacao] ) VAR sis = SELECTEDVALUE( Helpdesk_Cancelamentos[sistema] ) VAR eq = SELECTEDVALUE( Helpdesk_Cancelamentos[Equipe do Treinador] ) VAR setor = SWITCH( area, "Sucesso do Cliente", "Ongoing", "Consultoria", "Onboarding" ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta de Cancelamentos (" & setor & ")" ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0 && sis = "Alfa", SUMX( VALUES( Calendario[AnoMes] ), CALCULATE( DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) * IF( ISBLANK( eq ), CALCULATE( [Clientes Ativos AF (início do mês)], CRM_Backup_Diario[Setor do CS] = setor ), CALCULATE( [Clientes Ativos AF (início do mês)], CRM_Backup_Diario[Setor do CS] = setor, CRM_Backup_Diario[Equipe do CS] = eq ) ) ) ) )
		formatString: #,0.00
		displayFolder: Metas (a ligar)
		lineageTag: 6243cb38-888e-5b15-8ac9-a426f0700fce

	/// Revertidos ÷ pedidos (efetivados + revertidos).
	measure '% Revertidos' = DIVIDE( [Cancelamentos Revertidos], [Pedidos de Cancelamento] )
		formatString: 0.00%
		displayFolder: Cancelamento
		lineageTag: ccf4a0df-c0f2-58d3-8967-32c2b242212e

	/// Efetivados + revertidos.
	measure 'Pedidos de Cancelamento' = [Cancelamentos Efetivados] + [Cancelamentos Revertidos]
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 10ae4865-6162-5a88-b7f6-d3b14474d8b6

	/// Pedidos de cancelamento revertidos (mesmos filtros), por data de FECHAMENTO.
	measure 'Cancelamentos Revertidos' = CALCULATE( [Cancelamentos Fechados], Helpdesk_Cancelamentos[Resultado do Pedido] = "Revertido" )
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: fdd99c08-ccb4-5b9a-930b-23e3a95f8242

	/// Mensalidade dos cancelamentos efetivados, por data de FECHAMENTO.
	measure 'R$ Cancelado' = CALCULATE( SUM( Helpdesk_Cancelamentos[mensalidade] ), Helpdesk_Cancelamentos[Resultado do Pedido] = "Efetivado", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: \R$ #,0.00
		displayFolder: Cancelamento
		lineageTag: 65f90ed0-a34c-5c7b-a708-53be39a080b8

	/// Cancelamentos efetivados (fechados, tipo 2, sem estorno total e sem ajuste de carteira), por data de FECHAMENTO.
	measure 'Cancelamentos Efetivados' = CALCULATE( [Cancelamentos Fechados], Helpdesk_Cancelamentos[Resultado do Pedido] = "Efetivado" )
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 13b68a69-fdce-53e8-b1d2-cfcddc65ceda

	/// Pedidos 'Cancelamento - Outros' do Alfa, por data de FECHAMENTO.
	measure 'Pedidos Outros Atendidos' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[Serviço] = "Cancelamento", Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ), Helpdesk_Cancelamentos[category] = "Cancelamento - Outros", Helpdesk_Cancelamentos[sistema] = "Alfa" )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: ebecbee7-4b6f-5c81-99b5-ff4cdc0a5bf1

	/// Meta de % de reversão (intranet: Reversão - Alfa 17 / Kappa 10, setor Relacionamento). Só aparece com UM produto escolhido no filtro Sistema (a taxa sem filtro soma todos os produtos e não é comparável com a meta de um produto).
	measure 'Meta % Reversão' = VAR sis = SELECTEDVALUE( Helpdesk_Cancelamentos[sistema] ) VAR v = FILTER( Meta_Vinculo, Meta_Vinculo[Medida] = "Meta % Reversão" && ( Meta_Vinculo[Sistema] = sis || Meta_Vinculo[Sistema] = "" ) ) VAR d = MAXX( v, Meta_Vinculo[def_id] ) VAR s = MAXX( v, Meta_Vinculo[setor_id] ) RETURN IF( d > 0, DIVIDE( CALCULATE( [Meta Alvo (período)], Meta_Def[id] = d, Meta_Valor[setor_id] = s ), 100 ) )
		formatString: 0.00%
		displayFolder: Relacionamento
		lineageTag: 91d71bd6-f3e4-5f31-8397-bf93ca3e0f1b

	/// Pedidos tipo 2 fechados de clientes que têm mais de um pedido (ClienteReativado? do OKR 2026).
	measure 'Pedidos de Clientes com Mais de um Pedido' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), Helpdesk_Cancelamentos[type] = 2, NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ), Helpdesk_Cancelamentos[Cliente com Mais de um Pedido] = "Sim" )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: bb2aefb6-bc70-5fa9-8a01-b718d708a31c

	/// Pedidos revertidos, por data de FECHAMENTO (tela Clientes Revertidos).
	measure 'Clientes Revertidos' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), KEEPFILTERS( Helpdesk_Cancelamentos[category] = "Cancelamento Revertido" ), NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: 0709d991-2182-5c74-a3f9-7fbd1ef1e465

	/// Pedidos tipo 2 fechados no período (lista Status Cancelados).
	measure 'Pedidos Fechados (Tipo 2)' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), Helpdesk_Cancelamentos[type] = 2, NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: aae1e342-e8b3-51e3-9033-43091cf4fcea

	/// Pedidos em aberto criados há 5 dias ou mais (FOTO).
	measure 'Pedidos em Aberto há 5+ Dias' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), REMOVEFILTERS( Calendario ), Helpdesk_Cancelamentos[Pedido em Aberto] = "Há 5 dias ou mais" )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: c1222b54-95ac-5359-8281-b8e422d6bfcb

	/// Pedidos tipo 2 não Fechados/Resolvidos (FOTO: não muda com o período).
	measure 'Pedidos em Aberto' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), REMOVEFILTERS( Calendario ), NOT ISBLANK( Helpdesk_Cancelamentos[Pedido em Aberto] ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: 9343314b-dfe3-5c94-ac84-4aa883cf4294

	/// Reversões ÷ pedidos atendidos (fechamento nos dois) — tela Reversão do OKR 2026.
	measure '% Reversão Atendida' = DIVIDE( [Reversões Atendidas], [Pedidos Atendidos] )
		formatString: 0.00%
		displayFolder: Relacionamento
		lineageTag: 193cd2e2-60ce-543c-a3e2-b37a0210c19f

	/// Pedidos revertidos (sem outro pedido do cliente fechado no mesmo mês), por data de FECHAMENTO.
	measure 'Reversões Atendidas' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[Serviço] = "Cancelamento", Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ), Helpdesk_Cancelamentos[category] = "Cancelamento Revertido", Helpdesk_Cancelamentos[Cancelou no Mesmo Mês] = "Não" )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: 91355c3b-ccc1-53a7-8610-ea48d741debc

	/// Pedidos tipo 2 do serviço Cancelamento (sem 'Outros', sem ajuste), por data de FECHAMENTO — tela Reversão.
	measure 'Pedidos Atendidos' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[Serviço] = "Cancelamento", Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ), Helpdesk_Cancelamentos[category] <> "Cancelamento - Outros" )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: cd55e4e0-638b-58c2-8a93-2a707c005b94

	/// Mensalidade dos efetivados tipo 2, por data de FECHAMENTO.
	measure 'R$ Cancelado por Alegação' = CALCULATE( SUM( Helpdesk_Cancelamentos[mensalidade] ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: \R$ #,0.00
		displayFolder: Relacionamento
		lineageTag: 0faedbd9-b510-5a8c-b489-005fa3a486e9

	/// Efetivados tipo 2 (sem outros filtros), por data de FECHAMENTO — tela Alegação/Fase do OKR 2026.
	measure 'Cancelamentos por Alegação' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: 0748f9f8-b86f-5007-841d-ccb858fbcd07

	/// Revertidos (fechamento) ÷ pedidos (criação) — mesma conta do OKR 2026.
	measure '% Reversão (Empresa)' = DIVIDE( [Revertidos (Empresa)], [Pedidos de Cancelamento (Empresa)] )
		formatString: 0.00%
		displayFolder: Relacionamento
		lineageTag: e15fbe28-d972-5e7f-8794-62451fe34ca9

	/// Revertidos (fechados, tipo 2, sem estorno, sem outro pedido do cliente fechado no mesmo mês), por data de FECHAMENTO.
	measure 'Revertidos (Empresa)' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), KEEPFILTERS( Helpdesk_Cancelamentos[category] = "Cancelamento Revertido" ), Helpdesk_Cancelamentos[estornoTotal] <> "Sim", Helpdesk_Cancelamentos[status] = "Fechado", Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[Cancelou no Mesmo Mês] = "Não", NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: 42e84809-618a-50d2-bd4b-4c6ac138d8a5

	/// Cancelamentos efetivados (fechados, tipo 2, sem estorno total), por data de FECHAMENTO.
	measure 'Efetivados (Empresa)' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), KEEPFILTERS( Helpdesk_Cancelamentos[category] = "Cancelamento Efetivado" ), Helpdesk_Cancelamentos[estornoTotal] <> "Sim", Helpdesk_Cancelamentos[status] = "Fechado", Helpdesk_Cancelamentos[type] = 2, NOT ISBLANK( Helpdesk_Cancelamentos[Data de Fechamento] ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: b49d8814-381f-5074-9967-4f5cb8803099

	/// Pedidos de cancelamento (tipo 2, serviço Cancelamento, sem 'Outros' e sem ajuste de carteira; no AF sem os da treinadora Rodrigo Vieira), por data de CRIAÇÃO — tela Cancelamentos do OKR 2026.
	measure 'Pedidos de Cancelamento (Empresa)' = CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), USERELATIONSHIP( Helpdesk_Cancelamentos[Data de Criação], Calendario[Date] ), Helpdesk_Cancelamentos[type] = 2, Helpdesk_Cancelamentos[Serviço] = "Cancelamento", Helpdesk_Cancelamentos[category] <> "Cancelamento - Outros", Helpdesk_Cancelamentos[ajusteCarteira] <> "Sim", KEEPFILTERS( FILTER( ALL( Helpdesk_Cancelamentos[sistema], Helpdesk_Cancelamentos[treinador] ), NOT ( Helpdesk_Cancelamentos[sistema] = "Alfa" && Helpdesk_Cancelamentos[treinador] = "Rodrigo Vieira" ) ) ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: 4caba62a-fdec-553f-a4c1-b1f2c0be87af

	/// Coluna 'Tempo' da lista 'Pedidos em aberto': o 'Pedido em Aberto' do pedido (há 5 dias ou mais / menos de 5), vazio para pedido fora da seleção de Atendente/Equipe — assim a lista segue esses filtros.
	measure 'Tempo do Pedido em Aberto' = IF( [Na Seleção de Atendente] >= 1, CALCULATE( SELECTEDVALUE( Helpdesk_Cancelamentos[Pedido em Aberto] ), REMOVEFILTERS( Calendario ) ) )
		displayFolder: Relacionamento
		lineageTag: 8feb8aa1-06a7-5b2b-9361-c2e8c3fcb284

	/// Pedidos da seleção de Atendente/Equipe (Cancelamentos Atendidos): com eles escolhidos, só os pedidos de quem estava na seleção no mês (composição do mês, como os cartões '(por pessoa)'); sem eles, todos. Ignora o período (a lista é foto).
	measure 'Na Seleção de Atendente' = IF( ISFILTERED( dColaboradorMes[Colaborador] ) || ISFILTERED( dColaboradorMes[Equipe] ), CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), REMOVEFILTERS( Calendario ), KEEPFILTERS( TREATAS( SUMMARIZE( dColaboradorMes, dColaboradorMes[email], dColaboradorMes[AnoMes] ), Helpdesk_Cancelamentos[Email do Atendente], Helpdesk_Cancelamentos[Mês da Composição] ) ) ), CALCULATE( COUNTROWS( Helpdesk_Cancelamentos ), REMOVEFILTERS( Calendario ) ) )
		formatString: #,0
		displayFolder: Relacionamento
		lineageTag: f77a7462-0698-5a61-ba38-ce1000d7457c

	/// Cancelamentos efetivados da tela (área e sistema da tela, pelo treinador, data de fechamento) ÷ clientes KP da carteira do setor no 1º retrato do mês. Nos cartões vale o mês mais recente do período.
	measure '% Cancelamento KP (área)' = DIVIDE( [Cancelamentos Efetivados], [Clientes KP no Início do Mês (área)] )
		formatString: 0.00%
		displayFolder: Kappa por Área
		lineageTag: fdcf46b0-4ae8-51ef-a4ee-c4c64b7bd21d

	/// Clientes com Kappa ativo no 1º retrato do mês (CNPJ distinto, regra da Global 02) da carteira do setor da tela (área Consultoria = Onboarding, Sucesso do Cliente = Ongoing), pelo setor/equipe do CS no cadastro do RH do mês. Segue os filtros Equipe e Treinador da tela (equipe do CS e e-mail do treinador = responsável da carteira).
	measure 'Clientes KP no Início do Mês (área)' = VAR setor = SWITCH( CALCULATE( SELECTEDVALUE( Helpdesk_Cancelamentos[areaDeAtuacao] ), ALLEXCEPT( Helpdesk_Cancelamentos, Helpdesk_Cancelamentos[areaDeAtuacao] ) ), "Sucesso do Cliente", "Ongoing", "Consultoria", "Onboarding" ) VAR d1 = CALCULATE( MIN( CRM_Backup_Diario[Periodo] ), REMOVEFILTERS( CRM_Backup_Diario[Responsavel_Email], CRM_Backup_Diario[Equipe do CS], CRM_Backup_Diario[Setor do CS] ) ) VAR fe = ISFILTERED( Helpdesk_Cancelamentos[Equipe do Treinador] ) VAR eqs = FILTERS( Helpdesk_Cancelamentos[Equipe do Treinador] ) VAR ft = ISFILTERED( Helpdesk_Cancelamentos[treinador] ) VAR ems = CALCULATETABLE( VALUES( Helpdesk_Cancelamentos[Email do Treinador] ), REMOVEFILTERS( Calendario ) ) RETURN IF( NOT ISBLANK( setor ) && NOT ISBLANK( d1 ), CALCULATE( [Clientes Ativos KP (início do mês)], CRM_Backup_Diario[Periodo] = d1, CRM_Backup_Diario[Setor do CS] = setor, KEEPFILTERS( FILTER( ALL( CRM_Backup_Diario[Equipe do CS] ), NOT fe || CRM_Backup_Diario[Equipe do CS] IN eqs ) ), KEEPFILTERS( FILTER( ALL( CRM_Backup_Diario[Responsavel_Email] ), NOT ft || CRM_Backup_Diario[Responsavel_Email] IN ems ) ) ) )
		formatString: #,0
		displayFolder: Kappa por Área
		lineageTag: 1031abb9-96b3-5ae2-a8ea-111d88fc3919

