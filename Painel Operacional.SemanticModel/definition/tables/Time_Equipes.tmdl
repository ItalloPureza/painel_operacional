				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"equipe_id", Int64.Type}, {"usuario_id", Int64.Type}, {"papel", type text}, {"criado_em", type datetime}, {"nome_equipe", type text}, {"nome_usuario", type text}, {"email", type text}})
