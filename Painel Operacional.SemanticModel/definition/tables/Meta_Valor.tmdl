	partition Meta_Valor = m
		mode: import
		queryGroup: Estrutura
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoPlanilha), null, true),
				    Aba = Fonte{[Item="Meta_Valor",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id", Int64.Type}, {"def_id", Int64.Type}, {"competencia", type text}, {"Data", type datetime}, {"setor_id", Int64.Type}, {"ref_id", Int64.Type}, {"valor_alvo", type number}, {"valor_realizado", type number}})
				in
				    Tipos


	annotation PBI_ResultType = Table

