table Meta_Valor
	isHidden
	lineageTag: c43fe1d5-9a40-4f9d-8474-d659e9855d3a

	/// Meta (valor_alvo) no período, agregada pela regra da definição (trimestre_modo): soma, último mês ou média. Use dentro de CALCULATE com Meta_Def[id] e Meta_Valor[setor_id]. Percentuais ficam em pontos (24 = 24%).
	measure 'Meta Alvo (período)' = VAR modo = SELECTEDVALUE( Meta_Def[trimestre_modo], "media" ) VAR ult = MAX( Meta_Valor[Data] ) RETURN SWITCH( modo, "soma", SUM( Meta_Valor[valor_alvo] ), "ultimo", CALCULATE( SUM( Meta_Valor[valor_alvo] ), Meta_Valor[Data] = ult ), AVERAGE( Meta_Valor[valor_alvo] ) )
		formatString: #,0.00
		displayFolder: Metas (intranet)
		lineageTag: a56fa11b-dbf6-4384-bcb1-9b9bfb0a5d7d

	/// Realizado informado na intranet (valor_realizado), mesma agregação da meta. Serve de conferência com o número calculado no BI.
	measure 'Realizado na Intranet (período)' = VAR modo = SELECTEDVALUE( Meta_Def[trimestre_modo], "media" ) VAR ult = MAX( Meta_Valor[Data] ) RETURN SWITCH( modo, "soma", SUM( Meta_Valor[valor_realizado] ), "ultimo", CALCULATE( SUM( Meta_Valor[valor_realizado] ), Meta_Valor[Data] = ult ), AVERAGE( Meta_Valor[valor_realizado] ) )
		formatString: #,0.00
		displayFolder: Metas (intranet)
		lineageTag: 74e7fe21-18b5-4acc-b005-1d54967d333d

