table dSaudeTabelas
	lineageTag: 94db0f79-b769-588a-9807-94be307ee156

	measure 'Dados até' =
			
			-- 1ª linha do "Dados até": a data da tabela principal DESTA tela (extração > atualização > data do registro;
			-- dReferenciaDados). Cada tela filtra dReferenciaDados[Pagina] = ela mesma (filtro de página oculto); a tabela
			-- não se liga a nada.
			VAR _q = SELECTEDVALUE ( dReferenciaDados[Quando] )
			RETURN IF ( ISBLANK ( _q ), "", "Dados até " & _q )
		displayFolder: Saúde dos dados
		lineageTag: 2a35b029-e7ce-54ac-82a4-c76d578e25f4

	measure 'Cor Saúde' =
			
			SWITCH ( SELECTEDVALUE ( dSaudeTabelas[Status] ),
			    "Em dia", "#2E7D32",
			    "Atrasada", "#C62828",
			    "#8A8F98" )
		displayFolder: Saúde dos dados
		lineageTag: 4d5f4299-9427-58b0-bf05-5b2e65c2f938

	measure 'Tabelas Atrasadas' =
			
			-- só as tabelas que alguma tela usa ("Fora das telas" não deixa o botão vermelho)
			COUNTROWS ( FILTER ( ALL ( dSaudeTabelas ), dSaudeTabelas[Status] IN { "Atrasada", "Sem dados" } ) ) + 0
		formatString: 0
		displayFolder: Saúde dos dados
		lineageTag: 846806b1-0984-5495-a6b6-8b6024d02870

	measure 'Cor Botão Saúde' =
			
			IF ( [Tabelas Atrasadas] > 0, "#C62828", "#2E7D32" )
		displayFolder: Saúde dos dados
		lineageTag: ca322f2a-e9ef-5922-a19f-2bba6449939a

	measure 'Texto Botão Saúde' =
			
			VAR n = [Tabelas Atrasadas]
			RETURN "Saúde dos dados" & IF ( n > 0, "  ·  " & n & IF ( n = 1, " atrasada", " atrasadas" ), "  ·  ok" )
		displayFolder: Saúde dos dados
		lineageTag: 99a8edd9-a0bb-561a-8132-1c851aed8ab6

	measure 'Dados até (item)' =
			
			-- 2ª linha do "Dados até": de onde veio a data e o registro mais recente da tabela
			-- em 2 linhas (ex.: última extração dos tickets (Helpdesk) ↵ mais recente: ticket nº 123, aberto em 13/10 17:00).
			SELECTEDVALUE ( dReferenciaDados[Item] ) & ""
		displayFolder: Saúde dos dados
		lineageTag: fef97a88-3dfd-522a-b8e8-9b066e5d5862

