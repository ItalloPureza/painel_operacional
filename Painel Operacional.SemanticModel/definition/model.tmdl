model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup CRM

	annotation PBI_QueryGroupOrder = 0

queryGroup Helpdesk

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Gestão de Contratos'

	annotation PBI_QueryGroupOrder = 2

queryGroup Contratos

	annotation PBI_QueryGroupOrder = 3

queryGroup Estrutura

	annotation PBI_QueryGroupOrder = 4

queryGroup Telefonia

	annotation PBI_QueryGroupOrder = 5

queryGroup WhatsApp

	annotation PBI_QueryGroupOrder = 6

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CaminhoPlanilha","Time_Usuarios","CRM_Backup_Diario","CRM_Clientes_Atual","Meta_Def","Meta_Valor","CRM_Atividades","Helpdesk_Survey","Helpdesk_Tickets","Helpdesk_Cancelamentos","Helpdesk_Clientes","Helpdesk_Empresas","Helpdesk_Clientes_Empresas","Gestao_Contratos_AF_Prod","Gestao_Contratos_Gama_Prod","Gestao_Contratos_Tipos_Contrato","Atualizacao","Helpdesk_Chat","Ligacoes_API","Contratos_historico_status","Contratos_historico_Vendedor","Contratos_historico_plano","Contratos_historico_periodicidade","Contratos_historico_mercado","Contratos_historico_items","Contratos_historico_item_catalogo","Contratos_historico_indice_reajuste","Contratos_historico_gerente_conta","Contratos_historico_fones","Contratos_historico_emails","Contratos_historico_contratos","Time_Equipes","Time_EquipeSetor","WhatsApp_Atendimentos","WhatsApp_CSAT","WhatsApp_Envios","WhatsApp_Contatos","RH_ComposicaoMensal","Legado_Clientes","fConcessoes"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

